# Local smoke-test config for the invoice integration.
# Copy to functions/.env and fill in. NEVER commit functions/.env (gitignored).
#
#   cp functions/.env.example functions/.env
#   # edit functions/.env
#   npm --prefix functions run check          # read-only readiness check
#
# Note: .env.example is matched by the `.env.*` gitignore rule — if you want
# to track this template, `git add -f functions/.env.example`.

# ── iDoklad OAuth (Settings → API → client credentials) ─────────────────
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=
# Only if your iDoklad setup requires application_id; otherwise leave empty.
IDOKLAD_APP_ID=

# ── ti.to (reused from the tickets domain) ──────────────────────────────
TITO_API_TOKEN=
TITO_ACCOUNT_SLUG=
TITO_EVENT_SLUG=

# ── Invoice business rules ──────────────────────────────────────────────
INVOICE_RELEASE_MATCH=company funded
INVOICE_VAT_RATE=21
INVOICE_DUE_DAYS=14

# ── Resend (discount-code email) ────────────────────────────────────────
RESEND_API_KEY=
INVOICE_FROM_EMAIL=devfest@gug.cz
INVOICE_FROM_NAME=DevFest.cz

# Where test emails go (check:resend, and the optional iDoklad SEND step).
TEST_EMAIL=
