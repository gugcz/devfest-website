# Local smoke-test config for the invoice integration.
# Copy to functions/.env and fill in. NEVER commit functions/.env (gitignored).
#
#   cp functions/.env.example functions/.env
#   # edit functions/.env
#   npm --prefix functions run check          # read-only readiness check
#
# These values feed the local test scripts only. On deploy the credentials
# are read from Secret Manager (firebase functions:secrets:set) and the rest
# are code constants in functions/src/invoice/params.ts.

# ── Credentials (on deploy: firebase functions:secrets:set) ──────────────
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=
RESEND_API_KEY=

# ── ti.to (reused from the tickets domain) ──────────────────────────────
TITO_API_TOKEN=
TITO_ACCOUNT_SLUG=
TITO_EVENT_SLUG=

# ── Tests: where test emails go ─────────────────────────────────────────
TEST_EMAIL=
