# Astro client env. Copy to `.env` and fill in. Only PUBLIC_* vars are exposed
# to the browser bundle (Astro convention).

# Firebase App Check — reCAPTCHA Enterprise key ID (GCP → Security → reCAPTCHA,
# score-based key for websites). App Check stays inert until this is set; safe to
# embed (public key ID).
PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Local dev only: set to `true` to print a debug token in the browser console,
# then register it under App Check → Apps → Manage debug tokens. Or paste an
# already-registered token here. Leave empty in production.
PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Comma-separated hosts allowed to send Google Analytics (GA4) data. Defaults to
# `devfest.cz` (and subdomains) plus the live Hosting default domains when unset,
# so `npm run dev` and Firebase Hosting preview channels stay out of the
# production property. Set to a preview host only when you deliberately want to
# verify measurement there.
PUBLIC_ANALYTICS_ALLOWED_HOSTS=

# ── Build-time only (not exposed to the browser) ──────────────────────────────

# Origin of the cached lineup endpoint read at build time to pre-render
# /speakers, /sessions and /agenda (src/lib/lineup-build.ts). Defaults to the
# production function. Point it elsewhere to build against another deployment.
# `npm run dev` and `A11Y_MOCK=1` builds read the local fixtures instead —
# `DEVFEST_LIVE_API=1 npm run dev` opts back in (and proxies /api/* to the
# deployed site, since a dev server has no Hosting rewrite).
#
# Do NOT put A11Y_MOCK here. Astro loads this file into process.env, so it would
# make an ordinary `npm run build` publish fixture speakers; it belongs on the
# one command that wants it (`npm run a11y`, which builds to dist-a11y/).
LINEUP_BUILD_ENDPOINT=

# Set to `1` to let a CI build succeed even when that read fails. Without it a
# failed read throws in CI, so a deploy can never silently ship the lineup pages
# without their content and structured data. The PR-preview workflow sets it; the
# production deploy takes it from the `skip_lineup` workflow_dispatch input.
LINEUP_BUILD_OPTIONAL=
