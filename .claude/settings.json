{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run check)",
      "Bash(npm run complexity)",
      "Bash(npm run literals)",
      "Bash(npm run test:site)",
      "Bash(npm run test:claude)",
      "Bash(npm run a11y)",
      "Bash(npm --prefix functions test)",
      "Bash(npm ci)",
      "Bash(npm --prefix functions ci)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "mcp__*__firebase_deploy",
      "mcp__*__firebase_create_*",
      "mcp__*__firestore_add_*",
      "mcp__*__firestore_update_*",
      "mcp__*__firestore_delete_*",
      "mcp__*__firestore_create_*",
      "mcp__*__realtimedatabase_set_*",
      "mcp__*__remoteconfig_update_*",
      "mcp__*__auth_update_*",
      "mcp__*__auth_set_*",
      "mcp__*__messaging_send_*",
      "mcp__*__dataconnect_execute_graphql",
      "mcp__*__merge_pull_request",
      "mcp__ccd_pr__set_auto_merge"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edits.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Bash|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-deploy.sh",
            "args": []
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "args": []
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "very-good-claude-code-marketplace": {
      "source": {
        "source": "github",
        "repo": "VeryGoodOpenSource/very-good-claude-code-marketplace"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "enabledPlugins": {
    "vgv-wingspan@very-good-claude-code-marketplace": true,
    "impeccable@impeccable": true
  }
}
