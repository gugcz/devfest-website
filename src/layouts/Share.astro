---
/**
 * A share page: one talk's or one speaker's link preview, then the page that
 * shows it. Link scrapers (Slack, LinkedIn, X, Messenger) read the head and
 * run no script, so they unfurl THIS title and description; a visitor's
 * browser runs the script and lands on `to`, where the sheet opens.
 *
 * No meta refresh: some scrapers follow one and would unfurl the agenda
 * instead. `og:url` is this page for the same reason (Facebook re-fetches
 * whatever `og:url` names). `noindex`: the content lives on `to`.
 */
import { Font } from 'astro:assets';
import { defaultOgImageVersion } from '../lib/og-version';

interface Props {
	/** Where a visitor goes: `/agenda?talk=<id>` or `/speakers?speaker=<id>`. */
	to: string;
	title: string;
	description: string;
	/** What the no-script fallback line names. */
	label: string;
}

const { to, title, description, label } = Astro.props;
const site = 'https://devfest.cz';
const url = new URL(Astro.url.pathname, site).href.replace(/\/$/, '');
const ogImage = `${site}/og-image.jpg?v=${defaultOgImageVersion()}`;
const ogImageAlt = 'DevFest.cz 2026, 30 October at Uhelný Mlýn';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:site_name" content="DevFest.cz" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@devfest_cz" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<script is:inline define:vars={{ to }}>
			location.replace(new URL(to, location.origin).href);
		</script>
		<!-- No preload: a visitor's browser leaves before it paints. Only the
		     no-script fallback below ever uses them. -->
		<Font cssVariable="--font-special-elite" />
		<Font cssVariable="--font-bebas-neue" />
		<style>
			/* The no-script fallback, as the site sets it: a paper slip on the
			   black table, the talk or speaker in Bebas, the line on the typewriter. */
			body {
				margin: 0;
				min-height: 100svh;
				display: grid;
				place-items: center;
				padding: 1.5rem;
				box-sizing: border-box;
				background: #000000;
			}
			p {
				max-width: 34rem;
				margin: 0;
				padding: 1.5rem 1.75rem;
				background: rgba(255, 255, 255, 0.94);
				color: #000000;
				box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.85), 0 2px 6px rgba(0, 0, 0, 0.7);
				rotate: -0.5deg;
				font: 1.05rem/1.6 var(--font-special-elite), cursive;
			}
			a {
				display: block;
				margin-bottom: 0.5rem;
				color: inherit;
				font: 2.1rem/1 var(--font-bebas-neue), sans-serif;
				text-transform: uppercase;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.15em;
			}
			a:focus-visible {
				outline: 2px solid #F11000;
				outline-offset: 3px;
			}
		</style>
	</head>
	<body>
		<p><a href={to}>{label}</a> at DevFest.cz 2026.</p>
	</body>
</html>
