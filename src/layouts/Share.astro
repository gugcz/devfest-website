---
/**
 * A share page: one talk or one speaker, then the page that shows it. Link
 * scrapers (Slack, LinkedIn, X, Messenger) and assistants (ChatGPT, Claude,
 * Perplexity) run no script, so they unfurl THIS title and description and
 * read the talk or speaker in the body (the slot); a visitor's browser runs
 * the script and lands on `to`, where the sheet opens.
 *
 * No meta refresh: some scrapers follow one and would unfurl the agenda
 * instead. `og:url` and the canonical are this page for the same reason
 * (Facebook re-fetches whatever `og:url` names). Indexed and in the sitemap:
 * this is the only static copy of the talk or speaker. A crawler that runs
 * script (Googlebot) follows the forward and may index the sheet instead;
 * accepted, the page is for readers that run none (ADR 0008).
 */
import { Font } from 'astro:assets';
import { defaultOgImageVersion } from '../lib/og-version';
import { EVENT, eventDate } from '../lib/event';
import { twitterHandle } from '../lib/socials';

interface Props {
	/** Where a visitor goes: `/agenda?talk=<id>` or `/speakers?speaker=<id>`. */
	to: string;
	title: string;
	description: string;
	/** What the forwarding line names. */
	label: string;
}

const { to, title, description, label } = Astro.props;
const twitter = await twitterHandle();
const site = 'https://devfest.cz';
const url = new URL(Astro.url.pathname, site).href.replace(/\/$/, '');
const ogImage = `${site}/og-image.jpg?v=${defaultOgImageVersion()}`;
const ogImageAlt = `${EVENT.name}, ${eventDate('dayMonth')} at ${EVENT.venue}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:site_name" content="DevFest.cz" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		{twitter && <meta name="twitter:site" content={twitter} />}
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<script is:inline define:vars={{ to }}>
			location.replace(new URL(to, location.origin).href);
		</script>
		{/* No preload: a visitor's browser leaves before it paints. Only a
		    reader without script ever uses them. */}
		<Font cssVariable="--font-special-elite" />
		<Font cssVariable="--font-bebas-neue" />
		<style>
			/* What a reader without script sees, as the site sets it: a paper
			   slip on the black table, the name in Bebas, the rest on the
			   typewriter. */
			body {
				margin: 0;
				min-height: 100svh;
				display: grid;
				place-items: center;
				padding: 1.5rem;
				box-sizing: border-box;
				background: #000000;
			}
			article {
				max-width: 40rem;
				padding: 1.5rem 1.75rem;
				background: rgba(255, 255, 255, 0.94);
				color: #000000;
				/* The site's --paper-shadow; straight, as only a photograph tilts. */
				box-shadow: 0 1.5rem 1.5rem -1rem rgba(0, 0, 0, 0.85), 0 2px 6px rgba(0, 0, 0, 0.7);
				font: 1.05rem/1.6 var(--font-special-elite), cursive;
			}
			h1,
			h2 {
				margin: 0 0 0.5rem;
				font: 2.1rem/1 var(--font-bebas-neue), sans-serif;
				text-transform: uppercase;
			}
			h2 {
				margin-top: 1.5rem;
				font-size: 1.5rem;
			}
			p,
			ul {
				margin: 0 0 0.75rem;
			}
			a {
				color: inherit;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.15em;
			}
			a:focus-visible {
				outline: 2px solid #F11000;
				outline-offset: 3px;
			}
		</style>
	</head>
	<body>
		<article>
			<slot />
			<p><a href={to}>{label}</a> at {EVENT.name}, {EVENT.dateLabel}, {EVENT.venue}, {EVENT.address}.</p>
		</article>
	</body>
</html>
