---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import CookieBanner from '../components/CookieBanner.astro';
import Head from './Head.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import { defaultOgImageVersion, publicFileVersion, UPCOMING_OG_FILE } from '../lib/og-version';
import { staticTicketLines } from '../lib/tickets-static';
import { EVENT, pageTitle } from '../lib/event';
import { absoluteUrl, withoutBase } from '../lib/base';
import config from '../site.config';
import { enabled } from '../lib/flags';
import { organizationSchema, organizer, websiteSchema } from '../lib/structured-data';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** A wall screen nobody interacts with (`/tv`): no menu, footer or cookie
	 * banner. Without the banner nobody can accept, so GA never boots. */
	kiosk?: boolean;
	/** Absolute URL — an unfurler will not resolve a relative path. */
	ogImage?: string;
	ogImageAlt?: string;
}

const { venue } = config.event;
// While the next edition has no date (`edition` off, ADR 0011) the pages left
// at the root describe and share it, not the archived one.
const upcoming = enabled('edition') ? undefined : config.upcoming;
const {
	title = pageTitle("Prague Developer Conference"),
	description = upcoming
		? `${config.event.name} ${upcoming.edition}: ${config.event.tagline} returns in ${upcoming.season.toLowerCase()}.`
		: `${EVENT.name} — ${config.event.tagline}: ${config.event.pitch.replace(/\.$/, "")}. ${EVENT.dateLabel} at ${EVENT.venue}.${enabled('tickets') ? ' Tickets on sale now.' : ''}`,
	noindex = false,
	kiosk = false,
	ogImage = upcoming
		? `${absoluteUrl(`/${UPCOMING_OG_FILE}`)}?v=${publicFileVersion(UPCOMING_OG_FILE)}`
		: `${absoluteUrl('/og-image.jpg')}?v=${defaultOgImageVersion()}`,
	ogImageAlt = upcoming
		? `${config.event.name} ${upcoming.edition}, ${upcoming.season}`
		: `${EVENT.name} — classified mission starts ${EVENT.dateLabel}`,
} = Astro.props;

// Event schema follows https://developers.google.com/search/docs/appearance/structured-data/event
// Only rendered on the home page so subpages (privacy, contact, etc.) don't
// claim to BE the event. WebSite + Organization render sitewide.
const sitePath = withoutBase(Astro.url.pathname);
const isHome = sitePath === "/";

// `offers[].url` → #tickets (survives slug changes). Read from ti.to through
// `/api/tickets` at build time (`tickets-static.ts`): every ticket type on sale
// then, priced gross in CZK as `priceDisplay()` shows it, never EUR. A build
// with nothing on sale, or a failed read, lists none. As fresh as the last
// Hosting deploy (ADR 0008); the cache carries no release dates, so there is
// no `validFrom` / `priceValidUntil` to state.
const offers = isHome && enabled('tickets')
	? (await staticTicketLines())
			.filter((line) => line.purchasable && line.gross != null)
			.map((line) => ({
				"@type": "Offer",
				"name": line.label,
				"url": absoluteUrl("/#tickets"),
				"price": String(line.gross),
				"priceCurrency": "CZK",
				"availability": "https://schema.org/InStock",
				"seller": organizer
			}))
	: [];
const eventSchema = {
	"@context": "https://schema.org",
	"@type": "Event",
	"name": EVENT.name,
	"description":
		`${EVENT.name} — ${config.event.tagline}: ${config.event.pitch.replace(/\.$/, "")}. Two stages, one day, an afterparty.`,
	"image": [ogImage],
	"url": absoluteUrl("/"),
	"startDate": EVENT.start,
	"endDate": EVENT.end,
	// Registration opens an hour before the keynote (see the agenda).
	"doorTime": EVENT.doors,
	"eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
	"eventStatus": "https://schema.org/EventScheduled",
	"inLanguage": "en",
	"keywords": "developer conference, technology conference, Prague, AI agents, generative UI, cloud, backends, web development, mobile development, accessibility, open source, DevFest",
	"location": {
		"@type": "Place",
		"name": venue.name,
		"address": {
			"@type": "PostalAddress",
			"streetAddress": venue.street,
			"postalCode": venue.postalCode,
			"addressLocality": venue.city,
			"addressRegion": venue.region,
			"addressCountry": venue.country
		}
	},
	"organizer": organizer,
	// Omitted rather than `[]` once nothing is on sale (Google reads an empty
	// list as "no offers", a missing key as "unknown").
	...(offers.length > 0 ? { "offers": offers } : {})
};

// Home → <Page> breadcrumb trail for subpages. Names map from the first path
// segment; unknown routes fall back to a title-cased slug.
const pageNames: Record<string, string> = {
	"speakers": "Speakers",
	"sessions": "Sessions",
	"agenda": "Agenda",
	"attending": "I'm attending",
	"team": "Team",
	"partners": "Partners",
	"press": "Press",
	"contact": "Contact",
	"faq": "FAQ",
	"invoice": "Company Invoice",
	"code-of-conduct": "Code of Conduct",
	"privacy-policy": "Privacy Policy",
	"delete-account": "Delete Account"
};
const slug = sitePath.replace(/^\/+|\/+$/g, "").split("/")[0];
const breadcrumbName =
	pageNames[slug] ??
	slug
		.split("-")
		.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
		.join(" ");
const breadcrumbSchema = !isHome && slug
	? {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": absoluteUrl("/")
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": breadcrumbName,
					"item": absoluteUrl(sitePath)
				}
			]
		}
	: null;

const organization = await organizationSchema();
const jsonLd = isHome
	? [eventSchema, organization, websiteSchema]
	: [organization, websiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<html lang="en">
	<head>
		<Head {title} {description} {noindex} {ogImage} {ogImageAlt} {jsonLd} />
		{/*
			theme-color: tints iOS Safari's status bar / URL bar so the
			native chrome stays brand-dark even when the layout viewport
			doesn't extend behind it. Variants for light + dark cover
			browsers that only respect the media-scoped form (Firefox,
			Samsung Internet, older iOS in-app browsers).
		*/}
		<meta name="theme-color" content="#000000" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="dark" />
		{/*
			Mark JS available ASAP so a `.js`-gated rule only applies when a
			script is there to drive it — no-JS / crawlers get the
			fully-visible render. No stylesheet keys off `.js` today.
		*/}
		{/*
			ClientRouter's swap rebuilds <html>'s attributes from the incoming
			document, which never carries `js` (the class is added by script, and
			the fetched document's scripts don't run). Re-apply it in
			`astro:after-swap` — before paint, so a `.js`-gated rule never flips
			mid-navigation. The listener lives on `document`, which
			survives navigations, so registering it once here is enough.
		*/}
		<script is:inline>
			document.documentElement.classList.add('js');
			document.addEventListener('astro:after-swap', () =>
				document.documentElement.classList.add('js')
			);
		</script>
		{/*
			The venue TVs run Chromium years old (the build lowers syntax to
			Chrome 63, not the library). Fill what the screen and Astro's island
			runtime call that came later: `Object.fromEntries` (73), `flat` /
			`flatMap` (69), `AbortController` (66, abort only: an old `fetch`
			ignores the signal) and `Promise.allSettled` (76). And mark
			`html.no-flex-gap` where flex `gap` (84) is missing, which `@supports`
			cannot ask: `TvScreen.module.scss` falls back to margins under it.
			Inline in the head, as the island runtime runs inline before any
			module; ES5, as nothing transpiles it.
		*/}
		{kiosk && (
			<script is:inline>
				(function () {
					function define(target, name, value) {
						if (!target[name]) Object.defineProperty(target, name, { value: value, configurable: true, writable: true });
					}
					define(Object, 'fromEntries', function (entries) {
						var out = {};
						Array.from(entries, function (entry) {
							out[entry[0]] = entry[1];
						});
						return out;
					});
					define(Array.prototype, 'flat', function flat(depth) {
						depth = depth === undefined ? 1 : Number(depth);
						return Array.prototype.reduce.call(this, function (out, item) {
							return out.concat(Array.isArray(item) && depth > 0 ? flat.call(item, depth - 1) : [item]);
						}, []);
					});
					define(Array.prototype, 'flatMap', function (fn, self) {
						return Array.prototype.map.call(this, fn, self).flat();
					});
					define(Promise, 'allSettled', function (items) {
						return Promise.all(Array.from(items, function (item) {
							return Promise.resolve(item).then(
								function (value) { return { status: 'fulfilled', value: value }; },
								function (reason) { return { status: 'rejected', reason: reason }; }
							);
						}));
					});
					if (!window.AbortController) {
						window.AbortController = function AbortController() {
							var listeners = [];
							this.signal = {
								aborted: false,
								reason: undefined,
								onabort: null,
								addEventListener: function (type, fn) {
									if (type === 'abort') listeners.push(fn);
								},
								removeEventListener: function (type, fn) {
									listeners = listeners.filter(function (other) { return other !== fn; });
								},
							};
							this.abort = function (reason) {
								var signal = this.signal;
								if (signal.aborted) return;
								signal.aborted = true;
								signal.reason = reason;
								if (typeof signal.onabort === 'function') signal.onabort();
								listeners.forEach(function (fn) { fn(); });
							};
						};
					}
					var root = document.documentElement;
					var probe = document.createElement('div');
					probe.style.cssText = 'display:flex;flex-direction:column;row-gap:1px;position:absolute;visibility:hidden';
					probe.appendChild(document.createElement('div'));
					probe.appendChild(document.createElement('div'));
					root.appendChild(probe);
					if (probe.scrollHeight !== 1) root.classList.add('no-flex-gap');
					root.removeChild(probe);
				})();
			</script>
		)}

		{/* Favicon */}
		{/*
			`favicon.ico` first, and it is a real file now: the two WebP icons
			below are both `media`-gated, so anything that does not evaluate a
			colour-scheme query (feed readers, link unfurlers, older browsers,
			and every request for the well-known /favicon.ico path) fell through
			to a 404. The .ico carries 16/32/48 from the same mark.
		*/}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/webp" href="/favicon-light.webp" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/webp" href="/favicon-dark.webp" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		{/*
			Self-hosted brand fonts (Astro Fonts API — see the `fonts` array in
			astro.config.ts). Served from our own origin, so no visitor IP
			reaches Google's font CDN before the cookie banner is answered, and
			there is no third-party round-trip in the critical path. Each <Font />
			emits the @font-face block plus the `cssVariable` BaseLayout.scss
			consumes — the resolved family names are build-time hashes, so CSS
			must never name a face literally.

			`preload` is deliberate, not blanket: only the faces that paint above
			the fold everywhere get the hint (Special Elite is the body face set
			on <body>; Bebas Neue is the display face). Preloading all three would
			make them compete for bandwidth and delay the two that actually
			gate first paint. This comment is stripped from the built HTML.
		*/}
		<Font cssVariable="--font-special-elite" preload />
		<Font cssVariable="--font-bebas-neue" preload />
		<Font cssVariable="--font-jetbrains-mono" />

		{/* Page-specific <head> extras (e.g. FAQPage JSON-LD) */}
		<slot name="head" />

		{/*
			Client-side routing: same-origin navigations swap the <body> in place
			instead of reloading the document, so islands/styles/fonts survive and
			the View Transitions API animates the swap where supported. Browsers
			without the native API fall back to a plain DOM swap (no animation) —
			navigation still works.

			Consequence: ClientRouter turns `prefetchAll` on by default, so the
			explicit `prefetch.prefetchAll` in astro.config.ts is now redundant;
			`defaultStrategy: 'hover'` still matters and stays.

			Every inline <script> in this project is wrapped in an
			`astro:page-load` handler because bundled module scripts execute only
			once per document.
		*/}
		<ClientRouter />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		{/*
			Second in the DOM, not last. The banner is the one consent surface on
			the site and it used to sit after the footer, so reaching either
			choice from the skip link took ~40 tab stops — long enough that the
			only realistic way to dismiss it was the mouse.
		*/}
		{!kiosk && <CookieBanner />}
		{/*
			Status-bar scrim — paints brand-dark behind iOS Safari's
			translucent status bar / notch zone. Uses the
			`top: calc(-1 * env(safe-area-inset-top))` trick so the
			cover extends UP into the safe-area inset even when Safari
			ignores `viewport-fit=cover` and anchors `top:0` below the
			safe area. Z-index sits above the film-grain + scanline
			overlays (9999 / 9998) so it stays opaque under the chrome.
		*/}
		<div class="status-bar-cover" aria-hidden="true"></div>
		{!kiosk && <Menu />}
		{/*
			`tabindex="-1"` is what makes the skip link actually skip. Without it
			the browser moves the document fragment but leaves focus in the
			header, so the next Tab lands back in the nav — the link changed the
			URL and nothing else. A non-focusable div cannot receive programmatic
			focus; -1 makes it a valid target without adding a tab stop.
		*/}
		<div id="main-content" tabindex="-1"><slot /></div>
		{!kiosk && <Footer />}

		<script>
			import { keepAnchorLanded } from '../lib/anchor';
			import { initCampaignLinks } from '../lib/attribution';

			// Once per document, outside `astro:page-load`: it reads the entry URL
			// before a soft navigation drops its `utm_*`, and the listeners sit on
			// `document`, which survives the swap.
			initCampaignLinks();

			// Re-bind on `astro:page-load`, never DOMContentLoaded: bundled module
			// scripts run once per document and <ClientRouter /> swaps the page.
			document.addEventListener('astro:page-load', () => {
				// An anchor jump is resolved against a page that hasn't finished
				// loading its islands; hold the landing while it settles.
				keepAnchorLanded();
			});
		</script>
	</body>
</html>

<style is:global lang="scss">
	@use './BaseLayout';
</style>
