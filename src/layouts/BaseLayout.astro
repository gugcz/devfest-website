---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import {
	eventSchema,
	eventStubSchema,
	ID,
	organizationSchema,
	parentOrganizationSchema,
	ref,
	SITE_URL,
	websiteSchema,
} from '../lib/event';
import { ldJson } from '../lib/json-ld';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	bodyClass?: string;
	showFooter?: boolean;
}

const siteUrl = SITE_URL;
const {
	title = "DevFest.cz 2026 — Prague Developer Conference",
	description = "DevFest.cz 2026 — Prague's developer conference & festival. Web, Mobile, Cybersecurity, AI/ML. October 30, 2026. Tickets on sale now.",
	noindex = false,
	bodyClass = "",
	showFooter = true,
} = Astro.props;

const ogImage = `${siteUrl}/og-image.jpg`;
// Strip the trailing slash (root would be `https://devfest.cz/`) to match the
// no-slash URLs the sitemap + JSON-LD use under `trailingSlash: 'never'`.
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href.replace(/\/$/, "") || siteUrl;
const ogImageAlt = "DevFest.cz 2026 conference banner";

// Structured data. The event / organisation / website nodes and every fact in
// them live in `src/lib/event.ts` so the lineup pages can reference the SAME
// nodes by `@id` instead of describing a second, competing event.
//
// The full Event node is only emitted on the home page — a subpage claiming to
// BE the event would compete with it. Subpages still emit a minimal stub,
// because `WebPage.about` (and, on the lineup pages, every `performerIn` /
// `superEvent`) references `#event`, and an `@id` no node in the document
// defines resolves to nothing. Organization + WebSite render sitewide.
const isHome = Astro.url.pathname === "/";

// A WebPage node per document, tied into the site graph. It is what gives every
// URL a typed entity to hang its title, description and breadcrumb from.
const webPageSchema = {
	"@type": "WebPage",
	"@id": `${canonicalUrl}#webpage`,
	"url": canonicalUrl,
	"name": title,
	"description": description,
	"inLanguage": "en",
	"isPartOf": ref(ID.website),
	"about": ref(ID.event),
	"primaryImageOfPage": { "@type": "ImageObject", "url": ogImage }
};

// Home → <Page> breadcrumb trail for subpages. Names map from the first path
// segment; unknown routes fall back to a title-cased slug.
const pageNames = {
	"speakers": "Speakers",
	"sessions": "Sessions",
	"team": "Team",
	"partners": "Partners",
	"press": "Press",
	"contact": "Contact",
	"faq": "FAQ",
	"invoice": "Company Invoice",
	"privacy-policy": "Privacy Policy"
};
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, "").split("/")[0];
const breadcrumbName =
	pageNames[slug] ??
	slug
		.split("-")
		.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
		.join(" ");
const breadcrumbSchema = !isHome && slug
	? {
			"@type": "BreadcrumbList",
			"@id": `${canonicalUrl}#breadcrumb`,
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": breadcrumbName,
					"item": canonicalUrl
				}
			]
		}
	: null;

// One `@graph`, not a bare array of disconnected objects: the nodes cross-
// reference each other by `@id`, which is what lets a crawler resolve them into
// a single entity rather than four sightings of similar-looking things.
const jsonLd = ldJson({
	"@context": "https://schema.org",
	"@graph": [
		parentOrganizationSchema,
		organizationSchema,
		websiteSchema,
		isHome ? eventSchema : eventStubSchema,
		webPageSchema,
		...(breadcrumbSchema ? [breadcrumbSchema] : [])
	]
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<!--
			theme-color: tints iOS Safari's status bar / URL bar so the
			native chrome stays brand-dark even when the layout viewport
			doesn't extend behind it. Variants for light + dark cover
			browsers that only respect the media-scoped form (Firefox,
			Samsung Internet, older iOS in-app browsers).
		-->
		<meta name="theme-color" content="#050505" />
		<meta name="theme-color" content="#050505" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#050505" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="dark" />
		<!--
			The max-* directives are opt-ins, not defaults: without
			`max-image-preview:large` Google shows a thumbnail-sized image (or none)
			in Discover and image-rich results, and `max-snippet:-1` lifts the cap on
			text snippet length. Both only apply to indexable pages.
		-->
		<meta
			name="robots"
			content={noindex
				? "noindex, nofollow"
				: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
		/>
		<!--
			Mark JS available ASAP so scroll-reveal elements only start hidden
			when we can actually reveal them — no-JS / crawlers get the
			fully-visible render.
		-->
		<!--
			ClientRouter's swap rebuilds <html>'s attributes from the incoming
			document, which never carries `js` (the class is added by script, and
			the fetched document's scripts don't run). Re-apply it in
			`astro:after-swap` — before paint, so `.js .reveal` never flashes its
			no-JS (always-visible) state. The listener lives on `document`, which
			survives navigations, so registering it once here is enough.
		-->
		<script is:inline>
			document.documentElement.classList.add('js');
			document.addEventListener('astro:after-swap', () =>
				document.documentElement.classList.add('js')
			);
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		{!noindex && (
			<>
				<link rel="canonical" href={canonicalUrl} />
				<link rel="alternate" hreflang="en" href={canonicalUrl} />
				<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
			</>
		)}

		<!-- Favicon -->
		<link rel="icon" type="image/webp" href="/favicon-light.webp" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/webp" href="/favicon-dark.webp" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		{/*
			Self-hosted brand fonts (Astro Fonts API — see the `fonts` array in
			astro.config.mjs). Served from our own origin, so no visitor IP
			reaches Google's font CDN before the cookie banner is answered, and
			there is no third-party round-trip in the critical path. Each <Font />
			emits the @font-face block plus the `cssVariable` BaseLayout.scss
			consumes — the resolved family names are build-time hashes, so CSS
			must never name a face literally.

			`preload` is deliberate, not blanket: only the faces that paint above
			the fold everywhere get the hint (Special Elite is the body face set
			on <body>; Bebas Neue is the display face). Preloading all three would
			make them compete for bandwidth and delay the two that actually
			gate first paint. This comment is stripped from the built HTML.
		*/}
		<Font cssVariable="--font-special-elite" preload />
		<Font cssVariable="--font-bebas-neue" preload />
		<Font cssVariable="--font-jetbrains-mono" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="DevFest.cz" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@devfest_cz" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Structured Data -->
		{!noindex && <script type="application/ld+json" set:html={jsonLd} />}

		<!-- Page-specific <head> extras (e.g. FAQPage JSON-LD) -->
		<slot name="head" />

		{/*
			Client-side routing: same-origin navigations swap the <body> in place
			instead of reloading the document, so islands/styles/fonts survive and
			the View Transitions API animates the swap where supported. Browsers
			without the native API fall back to a plain DOM swap (no animation) —
			navigation still works.

			Consequence: ClientRouter turns `prefetchAll` on by default, so the
			explicit `prefetch.prefetchAll` in astro.config.mjs is now redundant;
			`defaultStrategy: 'hover'` still matters and stays.

			Every inline <script> in this project is wrapped in an
			`astro:page-load` handler because bundled module scripts execute only
			once per document.
		*/}
		<ClientRouter />
	</head>
	<body class={bodyClass}>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<!--
			Status-bar scrim — paints brand-dark behind iOS Safari's
			translucent status bar / notch zone. Uses the
			`top: calc(-1 * env(safe-area-inset-top))` trick so the
			cover extends UP into the safe-area inset even when Safari
			ignores `viewport-fit=cover` and anchors `top:0` below the
			safe area. Z-index sits above the film-grain + scanline
			overlays (9999 / 9998) so it stays opaque under the chrome.
		-->
		<div class="status-bar-cover" aria-hidden="true"></div>
		<Menu />
		<div id="main-content"><slot /></div>
		{showFooter && <Footer />}
		<CookieBanner />

		<script>
			// Cinematic atmosphere behaviours — all degrade gracefully and respect
			// reduced-motion (CSS already neutralises the visual side).
			//
			// Bundled module scripts run once per document, so with <ClientRouter />
			// this has to re-run per navigation. `astro:page-load` fires on the
			// initial load AND after every soft navigation, so it replaces (never
			// supplements) a DOMContentLoaded listener.
			document.addEventListener('astro:page-load', () => {
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				// 1) Scroll reveal — fade/rise sections as they enter the frame.
				const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
				if (!reveals.length) return;

				if (reduce || !('IntersectionObserver' in window)) {
					reveals.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				const io = new IntersectionObserver(
					(entries, obs) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								obs.unobserve(e.target);
							}
						}
					},
					// threshold 0 (not 0.12): a tall single-column .reveal grid on
					// mobile can exceed viewport/0.12 in height, so a 12% ratio is
					// never reached and the block stays invisible. Fire as soon as
					// any pixel crosses the line instead.
					//
					// Positive bottom margin grows the root downward, so a section
					// reveals ~15% of viewport height BEFORE it reaches the fold —
					// it reads as already there rather than arriving late.
					{ rootMargin: '0px 0px 15% 0px', threshold: 0 }
				);
				reveals.forEach((el) => io.observe(el));
				// Drop the observer before the next swap so it doesn't keep the
				// outgoing document's elements alive.
				document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
			});
		</script>
	</body>
</html>

<style is:global lang="scss">
	@use './BaseLayout';
</style>
