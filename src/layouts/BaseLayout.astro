---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import ClickTracking from '../components/ClickTracking.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import { getBuildLineup } from '../lib/lineup-build';
import { sessionSlugs, speakerSlugs } from '../lib/slug';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	bodyClass?: string;
	showFooter?: boolean;
	/** Human name for the LAST breadcrumb crumb on a nested route — a speaker's
	 * name, a talk's title. Without it the leaf falls back to a title-cased
	 * slug, which reads badly for anything but a short one-word segment. */
	breadcrumb?: string;
	/** Site-root-relative path to a page-specific Open Graph card, e.g.
	 * `/og/speakers/abdel-sghiouar.png`. Defaults to the brand banner. */
	ogImagePath?: string;
	/** Alt text for the card above — required whenever `ogImagePath` is set, or
	 * the preview describes the wrong image to anyone reading it aloud. */
	ogImageAltText?: string;
}

const siteUrl = "https://devfest.cz";
const {
	title = "DevFest.cz 2026 — Prague Developer Conference",
	description = "DevFest.cz 2026 — Prague's developer conference & festival. Web, Mobile, Cybersecurity, AI/ML. October 30, 2026. Tickets on sale now.",
	noindex = false,
	bodyClass = "",
	showFooter = true,
	breadcrumb,
	ogImagePath,
	ogImageAltText,
} = Astro.props;

// Per-page card where one exists (speakers, sessions — see src/lib/og-card.ts),
// otherwise the brand banner. Sharing the one banner everywhere meant a preview
// that said nothing about what was being shared.
const ogImage = ogImagePath ? `${siteUrl}${ogImagePath}` : `${siteUrl}/og-image.jpg`;
const ogImageType = ogImagePath?.endsWith(".png") ? "image/png" : "image/jpeg";
// Strip the trailing slash (root would be `https://devfest.cz/`) to match the
// no-slash URLs the sitemap + JSON-LD use under `trailingSlash: 'never'`.
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href.replace(/\/$/, "") || siteUrl;
const ogImageAlt = ogImageAltText ?? "DevFest.cz 2026 conference banner";

// Event schema follows https://developers.google.com/search/docs/appearance/structured-data/event
// Only rendered on the home page so subpages (privacy, contact, etc.) don't
// claim to BE the event. WebSite + Organization render sitewide.
const isHome = Astro.url.pathname === "/";

// Lineup for the Event's `performer` / `subEvent`. Memoised across the build, so
// reading it here (rather than threading it down from index.astro) costs one
// fetch for the whole site, not one per page. Only the home page carries the
// Event schema, so only the home page pays for the parse.
const { speakers: lineupSpeakers, sessions: lineupSessions } = isHome
	? await getBuildLineup()
	: { speakers: [], sessions: [] };
const speakerUrls = speakerSlugs(lineupSpeakers);
const sessionUrls = sessionSlugs(lineupSessions);

// `offers[].url` points to the on-site #tickets anchor so the schema stays
// valid even if ti.to slugs change. Prices are VAT-inclusive CZK figures
// (gross = ti.to net × 1.21 Czech VAT) and must match the customer-facing
// prices rendered by Tickets.tsx via priceDisplay(). The event is priced in
// CZK on ti.to (see #182) — do NOT use EUR here. Only list waves that are
// actually on sale: Early Bird has ended and Regular is now live, so Regular
// is the sole listed Offer. Future waves (Lazy Bird) are paused with no
// scheduled start date, so they carry no honest `availability`/`validFrom`
// and are omitted entirely until they open (avoids Google's missing-field
// warning). Add an Offer here when a wave opens; remove it when it ends
// (source of truth: ti.to/RTDB).
const organizer = {
	"@type": "Organization",
	"name": "GUG.cz, z.s.",
	"url": "https://gug.cz"
};

// Shared by the Event and by each session page's own Event schema, so the two
// can never describe the venue differently. Coordinates are the Uhelný mlýn
// building itself — the venue is ~20 km outside Prague, and a `geo` lets a map
// result put it in the right place instead of defaulting to the city.
const venue = {
	"@type": "Place",
	"name": "Uhelný Mlýn",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Areál Šroubáren 860",
		"postalCode": "252 66",
		"addressLocality": "Libčice nad Vltavou",
		"addressRegion": "Central Bohemia",
		"addressCountry": "CZ"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 50.197439,
		"longitude": 14.371092
	}
};

const performers = lineupSpeakers
	.filter((speaker) => speaker.fullName)
	.map((speaker) => ({
		"@type": "Person",
		"name": speaker.fullName,
		"url": `${siteUrl}/speakers/${speakerUrls.get(speaker.id)}`,
		...(speaker.tagLine ? { jobTitle: speaker.tagLine } : {}),
		...(speaker.profilePicture ? { image: speaker.profilePicture } : {})
	}));

const subEvents = lineupSessions
	.filter((session) => session.title && session.startsAt)
	.map((session) => ({
		"@type": "Event",
		"name": session.title,
		"url": `${siteUrl}/sessions/${sessionUrls.get(session.id)}`,
		"startDate": session.startsAt,
		...(session.endsAt ? { endDate: session.endsAt } : {}),
		...(session.description ? { description: session.description } : {}),
		"eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
		"eventStatus": "https://schema.org/EventScheduled",
		"location": venue,
		"organizer": organizer,
		...(session.speakers.length > 0
			? {
					performer: session.speakers.map((ref) => ({
						"@type": "Person",
						"name": ref.fullName,
						...(speakerUrls.has(ref.id)
							? { url: `${siteUrl}/speakers/${speakerUrls.get(ref.id)}` }
							: {})
					}))
				}
			: {})
	}));
const eventSchema = {
	"@context": "https://schema.org",
	"@type": "Event",
	"name": "DevFest.cz 2026",
	"description":
		"DevFest.cz 2026 — Prague's developer conference & festival. Web, Mobile, Cybersecurity, AI/ML.",
	"image": [ogImage],
	"url": siteUrl,
	"startDate": "2026-10-30T09:00:00+01:00",
	"endDate": "2026-10-30T20:00:00+01:00",
	"eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
	"eventStatus": "https://schema.org/EventScheduled",
	"inLanguage": "en",
	"keywords": "developer conference, technology conference, Prague, web development, Android, Flutter, AI, cybersecurity, DevFest",
	"location": venue,
	"organizer": organizer,
	// Speakers as `performer`. This is what turns a bare Event result into one
	// that names who is on stage, and it links each name to its own page.
	...(performers.length > 0 ? { performer: performers } : {}),
	// Talks as `subEvent`. Only the scheduled ones: Google requires `startDate`
	// on an Event, and Sessionize leaves it empty until the timetable is fixed,
	// so emitting the unscheduled talks would publish invalid entries. They
	// appear here automatically once the schedule lands.
	...(subEvents.length > 0 ? { subEvent: subEvents } : {}),
	"offers": [
		{
			"@type": "Offer",
			"name": "Regular",
			"description": "Standard conference admission.",
			"url": `${siteUrl}/#tickets`,
			"price": "2999",
			"priceCurrency": "CZK",
			"availability": "https://schema.org/InStock",
			"validFrom": "2026-07-01T00:00:00+02:00",
			// Bump if a later wave supersedes the Regular price before the event.
			"priceValidUntil": "2026-10-30",
			"seller": organizer
		}
	]
};

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "DevFest.cz",
	"url": siteUrl,
	"logo": `${siteUrl}/logo.png`,
	"description":
		"DevFest.cz is Prague's community-run developer conference & festival — Web, Mobile, Cybersecurity, and AI/ML.",
	"parentOrganization": organizer,
	"contactPoint": {
		"@type": "ContactPoint",
		"email": "devfest@gug.cz",
		"contactType": "customer support"
	},
	// Keep in sync with the Footer socials.
	"sameAs": [
		"https://x.com/devfest_cz",
		"https://www.facebook.com/DevFestCZ",
		"https://bsky.app/profile/devfest.cz",
		"https://www.linkedin.com/company/gugcz/",
		"https://www.youtube.com/@gug_cz"
	]
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "DevFest.cz",
	"url": siteUrl
};

// Breadcrumb trail, one crumb per path segment. Names come from `pageNames`
// where we have one; the LAST crumb prefers the `breadcrumb` prop (a speaker's
// name, a talk's title) and otherwise falls back to a title-cased slug.
//
// This used to emit a fixed two-crumb trail built from the FIRST segment only,
// which was wrong for every nested route: /speakers/abdel-sghiouar claimed a
// crumb named "Speakers" pointing at the speaker's own URL, and
// /press/downloads claimed "Press" pointing at the downloads page.
const pageNames = {
	"speakers": "Speakers",
	"sessions": "Sessions",
	"agenda": "Agenda",
	"team": "Team",
	"partners": "Partners",
	"press": "Press",
	"contact": "Contact",
	"faq": "FAQ",
	"invoice": "Company Invoice",
	"privacy-policy": "Privacy Policy"
};
const titleCase = (value) =>
	value
		.split("-")
		.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
		.join(" ");
const segments = Astro.url.pathname.replace(/^\/+|\/+$/g, "").split("/").filter(Boolean);
const crumbs = segments.map((segment, i) => {
	const isLast = i === segments.length - 1;
	return {
		name: (isLast && breadcrumb) || pageNames[segment] || titleCase(segment),
		item: `${siteUrl}/${segments.slice(0, i + 1).join("/")}`
	};
});
const breadcrumbSchema = crumbs.length > 0
	? {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
				...crumbs.map((crumb, i) => ({
					"@type": "ListItem",
					"position": i + 2,
					"name": crumb.name,
					"item": crumb.item
				}))
			]
		}
	: null;

const jsonLd = JSON.stringify(
	isHome
		? [eventSchema, organizationSchema, websiteSchema]
		: [organizationSchema, websiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])]
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<!--
			theme-color: tints iOS Safari's status bar / URL bar so the
			native chrome stays brand-dark even when the layout viewport
			doesn't extend behind it. Variants for light + dark cover
			browsers that only respect the media-scoped form (Firefox,
			Samsung Internet, older iOS in-app browsers).
		-->
		<meta name="theme-color" content="#050505" />
		<meta name="theme-color" content="#050505" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#050505" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
		<!--
			Mark JS available ASAP so scroll-reveal elements only start hidden
			when we can actually reveal them — no-JS / crawlers get the
			fully-visible render.
		-->
		<!--
			ClientRouter's swap rebuilds <html>'s attributes from the incoming
			document, which never carries `js` (the class is added by script, and
			the fetched document's scripts don't run). Re-apply it in
			`astro:after-swap` — before paint, so `.js .reveal` never flashes its
			no-JS (always-visible) state. The listener lives on `document`, which
			survives navigations, so registering it once here is enough.
		-->
		<script is:inline>
			document.documentElement.classList.add('js');
			document.addEventListener('astro:after-swap', () =>
				document.documentElement.classList.add('js')
			);
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		{!noindex && (
			<>
				<link rel="canonical" href={canonicalUrl} />
				<link rel="alternate" hreflang="en" href={canonicalUrl} />
				<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
			</>
		)}

		<!-- Favicon -->
		<link rel="icon" type="image/webp" href="/favicon-light.webp" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/webp" href="/favicon-dark.webp" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		{/*
			Self-hosted brand fonts (Astro Fonts API — see the `fonts` array in
			astro.config.mjs). Served from our own origin, so no visitor IP
			reaches Google's font CDN before the cookie banner is answered, and
			there is no third-party round-trip in the critical path. Each <Font />
			emits the @font-face block plus the `cssVariable` BaseLayout.scss
			consumes — the resolved family names are build-time hashes, so CSS
			must never name a face literally.

			`preload` is deliberate, not blanket: only the faces that paint above
			the fold everywhere get the hint (Special Elite is the body face set
			on <body>; Bebas Neue is the display face). Preloading all four would
			make them compete for bandwidth and delay the two that actually
			gate first paint. This comment is stripped from the built HTML.
		*/}
		<Font cssVariable="--font-special-elite" preload />
		<Font cssVariable="--font-bebas-neue" preload />
		<Font cssVariable="--font-im-fell-english" />
		<Font cssVariable="--font-jetbrains-mono" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="DevFest.cz" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@devfest_cz" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Structured Data -->
		{!noindex && <script type="application/ld+json" set:html={jsonLd} />}

		<!-- Page-specific <head> extras (e.g. FAQPage JSON-LD) -->
		<slot name="head" />

		{/*
			Client-side routing: same-origin navigations swap the <body> in place
			instead of reloading the document, so islands/styles/fonts survive and
			the View Transitions API animates the swap where supported. Browsers
			without the native API fall back to a plain DOM swap (no animation) —
			navigation still works.

			Consequence: ClientRouter turns `prefetchAll` on by default, so the
			explicit `prefetch.prefetchAll` in astro.config.mjs is now redundant;
			`defaultStrategy: 'hover'` still matters and stays.

			Every inline <script> in this project is wrapped in an
			`astro:page-load` handler because bundled module scripts execute only
			once per document.
		*/}
		<ClientRouter />
	</head>
	<body class={bodyClass}>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<!--
			Status-bar scrim — paints brand-dark behind iOS Safari's
			translucent status bar / notch zone. Uses the
			`top: calc(-1 * env(safe-area-inset-top))` trick so the
			cover extends UP into the safe-area inset even when Safari
			ignores `viewport-fit=cover` and anchors `top:0` below the
			safe area. Z-index sits above the film-grain + scanline
			overlays (9999 / 9998) so it stays opaque under the chrome.
		-->
		<div class="status-bar-cover" aria-hidden="true"></div>
		<Menu />
		<div id="main-content"><slot /></div>
		{showFooter && <Footer />}
		<CookieBanner />
		<ClickTracking />

		<script>
			// Cinematic atmosphere behaviours — all degrade gracefully and respect
			// reduced-motion (CSS already neutralises the visual side).
			//
			// Bundled module scripts run once per document, so with <ClientRouter />
			// this has to re-run per navigation. `astro:page-load` fires on the
			// initial load AND after every soft navigation, so it replaces (never
			// supplements) a DOMContentLoaded listener.
			document.addEventListener('astro:page-load', () => {
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				// 1) Scroll reveal — fade/rise sections as they enter the frame.
				const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
				if (!reveals.length) return;

				if (reduce || !('IntersectionObserver' in window)) {
					reveals.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				const io = new IntersectionObserver(
					(entries, obs) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								obs.unobserve(e.target);
							}
						}
					},
					// threshold 0 (not 0.12): a tall single-column .reveal grid on
					// mobile can exceed viewport/0.12 in height, so a 12% ratio is
					// never reached and the block stays invisible. Fire as soon as
					// any pixel crosses the line instead.
					//
					// Positive bottom margin grows the root downward, so a section
					// reveals ~15% of viewport height BEFORE it reaches the fold —
					// it reads as already there rather than arriving late.
					{ rootMargin: '0px 0px 15% 0px', threshold: 0 }
				);
				reveals.forEach((el) => io.observe(el));
				// Drop the observer before the next swap so it doesn't keep the
				// outgoing document's elements alive.
				document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
			});
		</script>
	</body>
</html>

<style is:global lang="scss">
	@use './BaseLayout';
</style>
