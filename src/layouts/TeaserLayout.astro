---
/**
 * The layout of the aether system: the teaser of the next edition while it
 * has no date (ADR 0011, `docs/design.md`). Shares the meta, Open Graph and
 * JSON-LD with `BaseLayout` (`Head.astro`); its own colours, type and chrome.
 */
import { ClientRouter } from 'astro:transitions';
import Head from './Head.astro';
import TeaserCookieBanner from '../components/teaser/TeaserCookieBanner.astro';
import TeaserFooter from '../components/teaser/TeaserFooter.astro';

interface Props {
	title: string;
	description: string;
	/** Absolute URL — an unfurler will not resolve a relative path. */
	ogImage: string;
	ogImageAlt: string;
	jsonLd: readonly object[];
}

const { title, description, ogImage, ogImageAlt, jsonLd } = Astro.props;
---

<html lang="en" class="aether">
	<head>
		<Head {title} {description} {ogImage} {ogImageAlt} {jsonLd} />
		<meta name="theme-color" content="#05090f" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon-2027.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<slot name="head" />
		<ClientRouter />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<TeaserCookieBanner />
		{/* Shared by every inked line on the page: a slight tremor that makes a
		     vector stroke read as drawn, and the brass of the lettering. */}
		<svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
			<defs>
				<filter id="aether-ink" x="-5%" y="-15%" width="110%" height="130%">
					<feTurbulence type="fractalNoise" baseFrequency=".045" numOctaves="2" seed="7"></feTurbulence>
					<feDisplacementMap in="SourceGraphic" scale="2.4"></feDisplacementMap>
				</filter>
				<linearGradient id="aether-brass" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="#fbf1da"></stop>
					<stop offset="1" stop-color="#d9b26a"></stop>
				</linearGradient>
			</defs>
		</svg>
		<div id="main-content" tabindex="-1"><slot /></div>
		<TeaserFooter />
	</body>
</html>

<style is:global lang="scss">
	@use './TeaserLayout';
</style>
