---
/**
 * The home page while the next edition has no date (`edition` off, ADR
 * 0011): the DF27 teaser. The stage is the design's comp (the aether, the
 * logo, the season, the portal to the last edition's archive); below it,
 * what a visitor and a search engine need to know: what DevFest.cz is, what
 * is announced, the last edition in figures, the newsletter. Every fact
 * comes from `src/site.config.ts` or the frozen lineup; nothing about 2027
 * beyond `upcoming` is stated.
 */
import TeaserLayout from '../layouts/TeaserLayout.astro';
import AetherCanvas from '../components/teaser/AetherCanvas.astro';
import SeasonMark from '../components/teaser/SeasonMark.astro';
import Portal from '../components/teaser/Portal.astro';
import NewsletterForm from '../components/NewsletterForm';
import skin from '../components/teaser/TeaserNewsletter.module.scss';
import { absoluteUrl } from '../lib/base';
import { archivedEditions, lastEditionFigures } from '../lib/editions';
import { enabled } from '../lib/flags';
import { publicFileVersion } from '../lib/og-version';
import { organizationSchema, websiteSchema } from '../lib/structured-data';
import config from '../site.config';

const { upcoming, event, organizer } = config;
if (!upcoming) {
	throw new Error('features.edition is off, so the home page is the teaser of `upcoming`, which src/site.config.ts does not set.');
}

const name = `${event.name} ${upcoming.edition}`;
const when = upcoming.season.toLowerCase();
const figures = lastEditionFigures();
const archiveYear = archivedEditions().at(-1);

const title = `${name} — ${event.tagline}, ${when}`;
const description = [
	`${name}: ${event.tagline} returns in ${when}.`,
	figures && `In ${figures.year}: ${event.audience} developers, ${figures.talks} talks, ${figures.speakers} speakers.`,
	enabled('newsletter') && 'Hear the date first on the newsletter.',
]
	.filter(Boolean)
	.join(' ');
const jsonLd = [await organizationSchema(), websiteSchema];

// Frames from past editions' contact sheets (`public/gallery/`).
const PRINTS = [
	{ n: '01', alt: 'A full hall facing the stage at a past DevFest.cz' },
	{ n: '03', alt: 'A speaker in an orange T-shirt raises a hand on stage' },
	{ n: '08', alt: 'The audience laughing during a talk' },
	{ n: '20', alt: 'Attendees laughing over their laptops at a long table' },
] as const;
---

<TeaserLayout
	{title}
	{description}
	ogImage={`${absoluteUrl('/og-2027.jpg')}?v=${publicFileVersion('og-2027.jpg')}`}
	ogImageAlt={`${name}, ${upcoming.season}`}
	{jsonLd}
>
	<link slot="head" rel="preload" as="image" href="/df27-logo.svg" fetchpriority="high" />
	<AetherCanvas />

	<main class="teaser">
		<section class="stage" aria-labelledby="teaser-title">
			<h1 id="teaser-title" class="logo rise" data-aether-anchor>
				<img src="/df27-logo.svg" alt={name} width="2880" height="280" fetchpriority="high" />
			</h1>
			<SeasonMark season={upcoming.season} class="rise rise-2" />
			<p class="stage-line rise rise-3">{event.tagline}</p>
			<div class="stage-actions rise rise-4">
				{enabled('newsletter') && <Portal href="#newsletter" label="Hear it first" variant="solid" />}
				{archiveYear && <Portal href={`/${archiveYear}`} label={`${archiveYear} Edition`} reload />}
			</div>
		</section>

		<div class="veil">
			<section class="band" aria-labelledby="about-title">
				<h2 id="about-title" class="rubric">The festival</h2>
				<p class="lead">
					{event.name} is {event.tagline}: one day of talks and workshops in English, run by the developer
					community around {organizer.name} since 2012.
				</p>
				<dl class="facts">
					<div>
						<dt>When</dt>
						<dd>{upcoming.season}<span class="facts-note">date to be announced</span></dd>
					</div>
					<div>
						<dt>Where</dt>
						<dd>{upcoming.city}<span class="facts-note">venue to be announced</span></dd>
					</div>
					<div>
						<dt>Language</dt>
						<dd>English</dd>
					</div>
				</dl>
			</section>

			{
				figures && (
					<section class="band" aria-labelledby="last-title">
						<h2 id="last-title" class="rubric">{figures.year} in figures</h2>
						<dl class="figures">
							<div>
								<dt>developers</dt>
								<dd>{event.audience}</dd>
							</div>
							<div>
								<dt>talks</dt>
								<dd>{figures.talks}</dd>
							</div>
							<div>
								<dt>speakers</dt>
								<dd>{figures.speakers}</dd>
							</div>
						</dl>
						<ul class="prints" role="list" aria-label="Photographs from past editions">
							{PRINTS.map(({ n, alt }) => (
								<li class="print">
									<img src={`/gallery/devfest-2025-${n}.webp`} {alt} loading="lazy" decoding="async" width="1080" height="720" />
								</li>
							))}
						</ul>
						<p class="band-link">
							<a href={`/${figures.year}`} data-astro-reload>
								The {figures.year} programme and speakers
							</a>
						</p>
					</section>
				)
			}

			{
				enabled('newsletter') && (
					<section class="band" id="newsletter" aria-labelledby="newsletter-title">
						<h2 id="newsletter-title" class="rubric">Hear it first</h2>
						<p class="lead lead-short">One email when {name} has a date, and a few a year after that.</p>
						<NewsletterForm client:visible skin={skin} edge={false} />
					</section>
				)
			}
		</div>
	</main>
</TeaserLayout>

<style lang="scss">
	@use './teaser';
</style>
