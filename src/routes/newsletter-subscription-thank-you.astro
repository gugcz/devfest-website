---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NextStep from '../components/NextStep.astro';
import NextStepList from '../components/NextStepList.astro';
import EndLine from '../components/EndLine.astro';
import { EVENT } from '../lib/event';
import { enabledOnly } from '../lib/flags';

// The page used to dead-end: one line of confirmation and a link back to the
// homepage the visitor had just come from. Someone who has just handed over
// their address is the most engaged visitor the site gets — this page points
// them at the three things they can actually do today.
const STEPS = enabledOnly([
	{
		feature: 'tickets' as const,
		title: 'Get your ticket',
		noteHtml:
			'The newsletter tells you when a wave opens; it does not hold you a seat. ' +
			'The current wave is on sale now.',
		actions: [{ href: '/#tickets', label: 'See the waves', kind: 'primary' as const }],
	},
	{
		title: 'Catch up on the talks',
		noteHtml:
			`The talks and speakers of ${EVENT.name} stay up &mdash; both pages read straight from the schedule.`,
		actions: [{ href: '/agenda#talks', label: 'See the talks' }],
	},
	{
		feature: 'invoice' as const,
		title: 'Buying for a team?',
		noteHtml:
			'Companies pay by invoice and claim their tickets afterwards with a code. Request one in a minute.',
		actions: [{ href: '/invoice', label: 'Request an invoice' }],
	},
]);
---

<BaseLayout
	title={`Subscribed — ${EVENT.name}`}
	description={`You're subscribed to ${EVENT.name} updates. We'll let you know when tickets drop.`}
	noindex
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={"You're on the list"}
			lede="You hear first when the next edition has a date, its tickets or its first speakers. A few emails a year, no more."
			seoHeading={`Subscribed to ${EVENT.name} updates`}
			titleId="newsletter-thanks-title"
		/>

		<section class="band band--lit" aria-labelledby="newsletter-next-heading">
			<div class="band-inner">
				<NextStepList label="While you wait" labelId="newsletter-next-heading">
					{STEPS.map((step) => <NextStep {...step} />)}
				</NextStepList>

				<EndLine text={`Here is who took the stage at ${EVENT.name}.`} href="/speakers" label="See the speakers" />
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import { trackConversion } from '../lib/analytics';

	// The newsletter form is a native POST to SmartEmailing, which redirects back
	// here — so this page load *is* the successful signup, and it is the only
	// moment GA4 can observe it (an event fired in the form's submit handler races
	// the unload). Mark `sign_up` as a key event in GA4 → Admin → Events.
	document.addEventListener('astro:page-load', () => {
		trackConversion('/newsletter-subscription-thank-you', 'sign_up', { method: 'newsletter' });
	});
</script>
