---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import EndLine from '../components/EndLine.astro';
import AttendingCard from '../components/AttendingCard';
import { EVENT, pageTitle } from '../lib/event';
---

<BaseLayout
	title={`I'm attending — ${EVENT.name}`}
	description={`Make a ${EVENT.name} share card for your feed — add your photo or initials and download or share it.`}
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'I’m attending'}
			lede="Build a card for your feed. Add your photo (processed on your device only) or let your initials carry it, then download or share."
			seoHeading={pageTitle("I'm attending")}
			titleId="attending-title"
		/>

		<section class="band band--lit" aria-labelledby="attending-form-heading">
			<div class="band-inner">
				<h2 id="attending-form-heading" class="sr-only">Build your card</h2>
				<AttendingCard client:load />
				<EndLine text="Tag @devfestcz when you post it." href="/agenda" label="See the schedule" />
			</div>
		</section>
	</main>
</BaseLayout>
