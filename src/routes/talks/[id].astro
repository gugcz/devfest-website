---
import Share from '../../layouts/Share.astro';
import { staticLineup } from '../../lib/lineup-static';
import { speakerNames, visitorCategories, type Room, type Session } from '../../lib/sessions';
import { EVENT } from '../../lib/event';
import { roomName, timeRange } from '../../lib/agenda';
import { paragraphs } from '../../lib/paragraphs';
import { excerpt, speakerSharePath, talkTarget } from '../../lib/share';

// One page per talk; `/agenda?talk=<id>` is where a browser reads it.
export async function getStaticPaths() {
	const { sessions, rooms } = await staticLineup();
	return sessions.map((session) => ({ params: { id: session.id }, props: { session, rooms } }));
}

const { session, rooms } = Astro.props as { session: Session; rooms: Room[] };
const names = speakerNames(session);
const title = names ? `${session.title} — ${names}` : session.title;
const when = `${EVENT.name}, ${EVENT.dateLabel}, ${EVENT.venue}.`;
const description = session.description ? `${excerpt(session.description)} ${when}` : when;
const time = timeRange(session);
const facts = [time && `${time} CET`, roomName(session, rooms), ...visitorCategories(session).map((c) => `${c.name}: ${c.values.join(', ')}`)].filter(
	Boolean,
);
---

<Share
	to={talkTarget(session.id)}
	title={`${title} | ${EVENT.name}`}
	description={description}
	label={`“${session.title}”`}
>
	<h1>{session.title}</h1>
	{facts.length > 0 && <p>{facts.join(' · ')}</p>}
	{paragraphs(session.description).map((text) => <p>{text}</p>)}
	{session.speakers.length > 0 && (
		<>
			<h2>{session.speakers.length === 1 ? 'Speaker' : 'Speakers'}</h2>
			<ul>
				{session.speakers.map((sp) => (
					<li>
						<a href={speakerSharePath(sp.id)}>{sp.fullName}</a>
						{sp.tagLine && `, ${sp.tagLine}`}
					</li>
				))}
			</ul>
		</>
	)}
</Share>
