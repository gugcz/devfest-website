---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Closer from '../components/Closer.astro';
import Workshops from '../components/Workshops.tsx';
import TalkIndex from '../components/TalkIndex.astro';
import { staticLineup } from '../lib/lineup-static';
import { staticWorkshops } from '../lib/workshops-static';
import { EVENT } from '../lib/event';

// Workshop sign-up for ticket holders. A workshop opens here once its seat
// limit is set in RTDB (`/workshops/{sessionId}/limit`); the page lists those
// and nothing else. Sign-in is the app's ticket login (src/lib/workshops.ts).
// Readers that run no script get the open workshops as of the build.
const { sessions, rooms } = await staticLineup();
const workshops = await staticWorkshops(sessions);
---

<BaseLayout
	title={`Workshop registration — ${EVENT.name}`}
	description={`Save a seat at a ${EVENT.name} workshop. Sign in with the code from your ticket, pick a workshop, and join the waitlist when it is full.`}
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Save a seat<br />at a workshop'}
			lede="Workshops have limited seats. Sign in with the code from your ticket and register. When a workshop is full, join the waitlist: you move up as soon as someone cancels."
			seoHeading={`${EVENT.name} Workshop Registration`}
			titleId="workshops-title"
		/>

		<section class="band band--lit workshops-list" aria-labelledby="workshops-list-title">
			<div class="band-inner">
				<h2 id="workshops-list-title" class="sr-only">Workshops</h2>
				<Workshops client:load />
				{workshops.length > 0 && <TalkIndex sessions={workshops} rooms={rooms} noun="workshops open for sign-up" />}
				<noscript>
					<p class="fallback-note">Registration needs JavaScript. Please turn it on and reload the page.</p>
				</noscript>
			</div>
		</section>

		<Closer
			titleHtml={'No ticket<br />yet?'}
			note="Workshops are for ticket holders. Get yours first, then come back to save a seat."
			titleId="workshops-closer"
			actions={[{ href: '/#tickets', label: 'Get tickets' }, { href: '/agenda', label: 'See the agenda', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style>
	/* One gap between the list and the closer: the closer's opening air. */
	.workshops-list {
		padding-bottom: 0;
	}
</style>
