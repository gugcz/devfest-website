---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';

// Public account-deletion instructions for the DevFest.cz mobile app. Google
// Play requires them at a stable URL (the Play Console "Delete account URL"),
// so keep this route. The same text lives in section 8 of /privacy-policy.
const MAIL_SUBJECT = 'Delete my DevFest app account';
---

<BaseLayout
	title="Delete Your App Account — DevFest.cz 2026"
	description="How to delete your DevFest.cz mobile app account and its data, in the app or by email."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Delete your<br />app account'}
			lede="How to delete your DevFest.cz app account and what happens to your data, in the app or by email."
			seoHeading="DevFest.cz app — Delete Your Account"
			titleId="delete-account-title"
			photo={false}
		/>

		<div class="band band--lit">
			<div class="band-inner">
				<div class="policy">
					<section>
						<p>
							This page explains how to delete your account in the DevFest.cz mobile app for iOS
							and Android (<code>cz.devfest.app</code>), published by GUG.cz, z.s., and what
							happens to your data.
						</p>
					</section>

					<section>
						<h2>In the app</h2>
						<p>
							Go to <strong>Profile &gt; Delete account</strong>. This immediately deletes:
						</p>
						<ul>
							<li>your Firebase Authentication account</li>
							<li>your user record: name, email, registration reference, favourite sessions and networking connections</li>
							<li>any pending email verification codes</li>
						</ul>
					</section>

					<section>
						<h2>Without the app</h2>
						<p>
							Email <a href={`mailto:devfest@gug.cz?subject=${encodeURIComponent(MAIL_SUBJECT)}`}>devfest@gug.cz</a> from
							the email address on your ticket with the subject "{MAIL_SUBJECT}". We delete the same
							data within 30 days.
						</p>
					</section>

					<section>
						<h2>What is not deleted</h2>
						<p>
							Usage analytics, crash reports and App Check signals are not linked to your account,
							so they cannot be picked out and deleted. They expire on their own: analytics after
							14 months, crash reports after 90 days, and App Check signals on the retention
							periods Google and Apple set for each platform. Data kept only on your device
							(onboarding state, reminder choices, notification inbox) goes away when you uninstall
							the app. Your ti.to ticket itself is not affected.
						</p>
						<p>
							If another attendee scanned your badge, your name and company stay in their list
							until they delete their account. Email <a href="mailto:devfest@gug.cz">devfest@gug.cz</a> and
							we will remove them.
						</p>
						<p>
							Everything the app collects is described in the <a href="/privacy-policy#mobile-app">privacy policy</a>.
						</p>
					</section>
				</div>
			</div>
		</div>
	</main>
</BaseLayout>

<style lang="scss">
	// Same legal-document column as the privacy policy.
	@use './privacy-policy';
</style>
