---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NextStep from '../components/NextStep.astro';
import NextStepList from '../components/NextStepList.astro';
import EndLine from '../components/EndLine.astro';
import { EVENT, googleCalendarUrl } from '../lib/event';
import config from '../site.config';

// The one page on the site a visitor reaches AFTER paying, and it used to say
// four words and offer a link home. Four things belong here and nowhere else:
// the date in their calendar, the venue on a map, what happens next, and a way
// to say they are coming. Built out of the site's own composition — hero,
// the stub, the index cards, one end line — not a bespoke centred stack.
const shareText = `I'm going to ${EVENT.name} on ${EVENT.dateLabel}.`;
const shareUrl = EVENT.url;

// The date, the hours and the place as one paper stub: the facts a ticket
// carries, with the two calendar actions on it. Its .ics button is the
// page's one red fill; the index cards below are the errands.
const eventDay = EVENT.start.slice(0, 10);

const STEPS = [
	{
		title: 'Find the venue',
		noteHtml:
			`${EVENT.venue} &mdash; ${EVENT.address}. Half an hour north of Prague; ` +
			'one direct train, then a ten-minute walk.',
		actions: [
			{ href: '/venue', label: 'Getting there' },
			{ href: EVENT.mapUrl, label: 'Open in maps', external: true },
		],
	},
	{
		title: 'What happens next',
		noteHtml:
			'Your ticket and receipt arrive by email from ti.to &mdash; check spam if nothing lands ' +
			'within an hour. The agenda fills up as talks are confirmed.',
		actions: [{ href: '/agenda', label: 'See the agenda' }],
	},
	{
		title: 'Bring someone with you',
		noteHtml:
			'Half the value of a conference is who you go with. Tell the people you would want in the room. ' +
			'Make yourself an "I\'m attending" card for socials in a minute.',
		actions: [
			{ href: '/attending/', label: 'Your card' },
			{
				href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
				label: 'LinkedIn',
				kind: 'ghost' as const,
				external: true,
			},
			{
				href: `https://x.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`,
				label: 'X',
				kind: 'ghost' as const,
				external: true,
			},
		],
	},
];
---

<BaseLayout
	title={`Ticket confirmed — ${EVENT.name}`}
	description={`Your ${EVENT.name} ticket is confirmed. See you in ${config.event.venue.city} on ${EVENT.dateLabel}.`}
	noindex
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={"You're in"}
			lede={`Ticket confirmed. The receipt and your QR code are on their way to your inbox — see you at ${EVENT.venue} on ${EVENT.dateLabel.replaceAll(' ', '\u00a0')}.`}
			seoHeading={`${EVENT.name} ticket confirmed`}
			titleId="thank-you-title"
		/>

		<section class="band band--lit" aria-labelledby="next-heading">
			<div class="band-inner">
				<section class="paper event-stub" aria-labelledby="stub-heading">
					<h2 id="stub-heading" class="stub-label">Put it in your calendar</h2>
					<p class="stub-date"><time datetime={eventDay}>{EVENT.dateLabel}</time></p>
					<dl class="stub-facts">
						<dt>Time</dt>
						<dd class="stub-fig">{EVENT.timeLabel}</dd>
						<dt>Place</dt>
						<dd>{EVENT.venue}, {config.event.venue.city}</dd>
					</dl>
					<div class="stub-actions">
						<a class="btn-primary" href={EVENT.icsUrl} download>Download .ics</a>
						<a class="stub-go" href={googleCalendarUrl()} target="_blank" rel="noopener noreferrer">Google Calendar</a>
					</div>
				</section>

				<NextStepList label="Before you go" labelId="next-heading">
					{STEPS.map((step) => <NextStep {...step} />)}
				</NextStepList>

				<EndLine text="See who you came for." href="/speakers" label="Meet the speakers" />
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './thank-you';
</style>

<script>
	import { trackConversion } from '../lib/analytics';

	// ti.to's "thank you URL" — the one purchase signal we get. NOT GA4's
	// `purchase`: ti.to's redirect carries no `transaction_id`/`value`/`items`.
	// Mark as a key event in GA4 (see README).
	document.addEventListener('astro:page-load', () => {
		trackConversion('/thank-you', 'ticket_purchase_confirmed');
	});
</script>
