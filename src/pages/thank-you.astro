---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConversionPing from '../components/ConversionPing.astro';
import LandingNotice from '../components/LandingNotice.astro';
---

<BaseLayout
	title="Ticket confirmed · DevFest.cz 2026"
	description="Your DevFest.cz 2026 ticket is confirmed. See you in Prague on 30 October 2026."
	noindex
>
	<LandingNotice
		headline="You're in."
		subtext="Ticket confirmed. Check your inbox for the receipt and QR code. See you in Prague on 30 October 2026."
	/>
	{/* ti.to's configured "thank you URL" — the one place a completed purchase
	    lands back on our own domain, so it is where the conversion is counted. */}
	<ConversionPing event="ticket_purchase_complete" />
</BaseLayout>
