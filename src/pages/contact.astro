---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Desk from '../components/Desk.astro';
import Closer from '../components/Closer.astro';

---

<BaseLayout
	title="Contact — DevFest.cz 2026"
	description="Reach the DevFest.cz 2026 organising team — general questions, partnerships, and speaker enquiries."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Get in <span class="red">touch.</span>'}
			lede="Pick the right inbox and we'll get back to you as soon as we can."
			seoHeading="Contact DevFest.cz 2026"
			titleId="contact-title"
			photo={false}
		/>

		<!-- CARDS -->
		<section class="band band--lit contact-body" aria-labelledby="desks-heading">
			<div class="band-inner">
				<!-- Every other subpage opens its body on a head; this one used to
				     drop straight from the ticker onto the first desk, so the list
				     had no owner and the wide page had nothing in its right half.
				     Two columns, not a stacked eyebrow/title/lede lockup — that
				     shape is the hero's, one screen up. -->
				<header class="head-split head-split--ruled">
					<h2 id="desks-heading" class="display head-title">Three desks.</h2>
					<p class="head-note">
						Not sure which one? Take the general desk &mdash; it reaches the whole crew.
					</p>
				</header>

				<div class="field contact-grid reveal">
					<Desk
						label="General"
						title="General questions"
						titleId="desk-general"
						desc="Tickets, billing, production, or anything else."
						contacts={[{ email: 'devfest@gug.cz' }]}
					/>
					<Desk
						label="Partnerships"
						title="Partners & sales"
						titleId="desk-partners"
						desc="Partnerships, sponsorships, and media collaborations."
						contacts={[{ name: 'Filip Goszler — Lead', email: 'filip@gug.cz' }]}
					/>
					<Desk
						label="Speakers"
						title="Speakers & lineup"
						titleId="desk-speakers"
						desc="Call for Proposals questions and speaker travel."
						contacts={[{ email: 'devfest-speakers@gug.cz' }]}
					/>
				</div>

			</div>
		</section>

		<Closer
			titleHtml="Just come to the show."
			tone="plain"
			titleId="contact-closer"
			actions={[{ href: '/#tickets', label: 'Get tickets' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './contact';
</style>
