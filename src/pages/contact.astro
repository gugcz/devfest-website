---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';

const tickerTopics = [
	'General',
	'Tickets',
	'Partnerships',
	'Speakers',
	'Press',
];
---

<BaseLayout
	title="Contact — DevFest.cz 2026"
	description="Reach the DevFest.cz 2026 organising team — general questions, partnerships, and speaker enquiries."
>
	<main class="contact-page">
		<SubpageHero
			label="Contact"
			titleHtml={'Get in <span class="red">touch</span>.'}
			lede="Pick the right inbox and we'll get back to you as soon as we can."
			seoHeading="Contact DevFest.cz 2026"
			titleId="contact-title"
		/>

		<Ticker items={tickerTopics} fontSize="0.7rem" />

		<!-- CARDS -->
		<section class="contact-body" aria-label="Contact desks">
			<div class="contact-inner">
				<div class="contact-grid reveal">
					<article class="contact-card">
						<span class="card-no" aria-hidden="true"></span>
						<span class="card-label">General</span>
						<h2 class="card-title">General questions</h2>
						<p class="card-desc">Tickets, billing, production, or anything else.</p>
						<ul class="card-emails">
							<li>
								<a class="email-link" href="mailto:devfest@gug.cz">devfest@gug.cz</a>
							</li>
						</ul>
					</article>

					<article class="contact-card">
						<span class="card-no" aria-hidden="true"></span>
						<span class="card-label">Partnerships</span>
						<h2 class="card-title">Partners &amp; sales</h2>
						<p class="card-desc">Partnerships, sponsorships, and media collaborations.</p>
						<ul class="card-emails">
							<li>
								<span class="email-name">Filip Goszler &mdash; Lead</span>
								<a class="email-link" href="mailto:filip.goszler@gug.cz">filip.goszler@gug.cz</a>
							</li>
						</ul>
					</article>

					<article class="contact-card">
						<span class="card-no" aria-hidden="true"></span>
						<span class="card-label">Speakers</span>
						<h2 class="card-title">Speakers &amp; lineup</h2>
						<p class="card-desc">Call for Proposals questions and speaker travel.</p>
						<ul class="card-emails">
							<li>
								<a class="email-link" href="mailto:devfest-speakers@gug.cz">devfest-speakers@gug.cz</a>
							</li>
						</ul>
					</article>
				</div>

			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './contact';
</style>
