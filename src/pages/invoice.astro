---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import EndLine from '../components/EndLine.astro';
import InvoiceForm from '../components/InvoiceForm';

// The three steps, typed on index cards (the /venue route cards).
const STEPS = [
	'Fill in your company billing details below.',
	'We email the invoice right away. Pay it by bank transfer within 14 days.',
	'Once the payment arrives, we email one code that claims all your tickets on ti.to.',
];
---

<BaseLayout
	title="Company invoice — DevFest.cz 2026"
	description="Buy DevFest.cz 2026 tickets on a company invoice. Request an invoice, pay by bank transfer, and receive a code to claim your tickets."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Buy on a company<br />invoice'}
			lede="Need an invoice before you can pay? Request one here. We'll bill your company, and once it's settled you'll get a code to claim your tickets on ti.to."
			seoHeading="DevFest.cz 2026 Company Invoice"
			titleId="invoice-title"
			photo={false}
		/>

		<section class="band invoice-band" aria-labelledby="invoice-steps-heading">
			<div class="band-inner">
				<div class="head-rule">
					<h2 id="invoice-steps-heading" class="head-rule-title">How it works</h2>
					<p class="head-rule-note">
						Paying by card instead? Skip this and buy directly on{' '}
						<a href="/#tickets" class="intro-link">the tickets page</a>.
					</p>
				</div>

				<ol class="invoice-steps" role="list">
					{STEPS.map((text, i) => (
						<li class="paper invoice-card">
							<span class="invoice-card-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<p class="invoice-card-text">{text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section class="band invoice-band" aria-labelledby="invoice-form-heading">
			<div class="band-inner invoice-form-grid">
				<h2 id="invoice-form-heading" class="sr-only">Company billing details</h2>
				<InvoiceForm client:load />
				<div class="invoice-aside">
					<EndLine text="Questions about the invoice? Name the company when you write." href="mailto:devfest@gug.cz" label="Write to devfest@gug.cz" />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './invoice';
</style>
