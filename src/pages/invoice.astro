---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import EndLine from '../components/EndLine.astro';
import InvoiceForm from '../components/InvoiceForm';
---

<BaseLayout
	title="Company invoice — DevFest.cz 2026"
	description="Buy DevFest.cz 2026 tickets on a company invoice. Request an invoice, pay by bank transfer, and receive a code to claim your tickets."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Buy on a company<br />invoice'}
			lede="Need an invoice before you can pay? Request one here. We'll bill your company, and once it's settled you'll get a code to claim your tickets on ti.to."
			seoHeading="DevFest.cz 2026 Company Invoice"
			titleId="invoice-title"
			photo={false}
		/>

		<section class="band band--lit" aria-labelledby="invoice-form-heading">
			<div class="band-inner">
				<div class="invoice-inner">
					<div class="invoice-intro">
						<h2 id="invoice-form-heading" class="intro-title">How it works</h2>
						<ol class="steps">
							<li><span class="step-no">01</span> Fill in your company billing details below.</li>
							<li><span class="step-no">02</span> We email the invoice right away. Pay it by bank transfer within 14 days.</li>
							<li><span class="step-no">03</span> Once the payment arrives, we email one code that claims all your tickets on ti.to.</li>
						</ol>
						<p class="intro-note">
							Paying by card instead? Skip this and buy directly on{' '}
							<a href="/#tickets" class="intro-link">the tickets page</a>.
						</p>
					</div>

					<InvoiceForm client:load />

					<EndLine text="Questions about the invoice? Name the company when you write." href="mailto:devfest@gug.cz" label="Write to devfest@gug.cz" />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './invoice';
</style>
