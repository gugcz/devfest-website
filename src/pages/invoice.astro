---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import InvoiceForm from '../components/InvoiceForm';
---

<BaseLayout
	title="Company invoice — DevFest.cz 2026"
	description="Buy DevFest.cz 2026 tickets on a company invoice. Request an invoice, pay by bank transfer, and receive a code to claim your tickets."
>
	<main class="invoice-page">
		<SubpageHero
			label="The paper trail"
			titleHtml={'Buy on<br /><span class="red">a company invoice.</span>'}
			lede="Need an invoice before you can pay? Request one here. We'll bill your company, and once it's settled you'll get a code to claim your tickets on ti.to."
			seoHeading="DevFest.cz 2026 Company Invoice"
			titleId="invoice-title"
		/>

		<section class="invoice-body" aria-labelledby="invoice-form-heading">
			<div class="invoice-inner reveal">
				<div class="invoice-intro">
					<h2 id="invoice-form-heading" class="intro-title">How it works</h2>
					<ol class="steps">
						<li><span class="step-no">01</span> Fill in your company billing details below.</li>
						<li><span class="step-no">02</span> We email you an invoice, payable by bank transfer.</li>
						<li><span class="step-no">03</span> Pay it — then we send a 100%-off code to redeem your tickets on ti.to.</li>
					</ol>
					<p class="intro-note">
						Paying by card instead? Skip this and buy directly on{' '}
						<a href="/#tickets" class="intro-link">the tickets page</a>.
					</p>
				</div>

				<InvoiceForm client:load />
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	.invoice-page {
		display: flex;
		flex-direction: column;
	}

	.invoice-body {
		position: relative;
		padding: var(--section-y) var(--gutter);
		// Pool of light dropped behind the billing desk — a lit noir scene.
		background: var(--lit);
		border-top: 1px solid var(--rule-soft);
	}

	.invoice-inner {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.invoice-intro {
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}

	.intro-title {
		font-family: var(--font-bebas-neue), sans-serif;
		font-size: var(--fs-card-title);
		letter-spacing: 0.04em;
		color: var(--color-text);
		margin: 0;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.steps li {
		font-family: var(--font-im-fell-english), serif;
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--color-grey);
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
	}

	.step-no {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		// Red reads as light — the step numbers glow like neon markers.
		color: var(--color-accent-hot);
		text-shadow: var(--glow-red-soft);
		flex-shrink: 0;
	}

	.intro-note {
		font-family: var(--font-special-elite), cursive;
		font-size: 0.9rem;
		font-style: italic;
		color: rgba(240, 237, 230, 0.6);
		margin: 0;
	}

	.intro-link {
		color: rgba(240, 237, 230, 0.85);
		text-decoration: none;
		border-bottom: 1px solid var(--rule-red);
		transition: border-color 0.2s, color 0.2s;

		&::after {
			content: '\2197';
			margin-left: 0.4rem;
			border-bottom: none;
			display: inline-block;
			transition: transform 0.25s;
		}

		&:hover,
		&:focus-visible {
			color: var(--color-accent-hot);
			border-color: var(--color-accent-hot);
			// Red TEXT reads as neon — subtle halation on hover.
			text-shadow: var(--glow-red-soft);
		}

		&:hover::after,
		&:focus-visible::after {
			transform: translate(2px, -2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.intro-link::after {
			transition: none;
		}

		.intro-link:hover::after,
		.intro-link:focus-visible::after {
			transform: none;
		}
	}
</style>
