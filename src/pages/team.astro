---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import EndLine from '../components/EndLine.astro';
import { initials } from '../lib/speakers';

// ─── TEAM ROSTER ──────────────────────────────────────────────────────────
// Roster: the `team` collection (`src/content/team.json`). Each member has a
// B&W `photo` and a colour `photoColor` of the same shot; colour bleeds in on
// hover (team.scss). `alias` is the codename on the tape; `order` fixes sequence.
type LinkKind = 'linkedin' | 'github' | 'web' | 'instagram' | 'email';

const team = (await getCollection('team'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => entry.data);

// ─── IMAGE OPTIMISATION ────────────────────────────────────────────────────
// The source webps live in `src/assets/team` so the build can resize them and
// emit modern AVIF variants (vs. serving the raw 700px masters from `public`).
// `import.meta.glob` pulls the metadata for every source; we key it by filename
// so the roster above can keep referencing simple paths.
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.webp', {
	eager: true,
});
const sourceByFile = new Map<string, ImageMetadata>(
	Object.entries(sources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);

// Cards render ~220–340px wide (2-col on mobile); these widths cover that range
// up to ~2× DPR. `sizes` lets the browser pick the smallest variant that fits.
// A double codename ("The Boss / The Scenic Artist") that cannot fit one
// line on a phone tape breaks only after the slash, never inside a name.
const tapeText = (alias: string) =>
	alias
		.split(' / ')
		.map((part) => part.replaceAll(' ', '\u00a0'))
		.join(' / ');

const MUGSHOT_WIDTHS = [240, 360, 480, 600, 720];
const MUGSHOT_SIZES = '(max-width: 720px) 45vw, (max-width: 1100px) 30vw, 300px';

const optimiseMugshot = (file?: string) => {
	if (!file) return undefined;
	const src = sourceByFile.get(file.split('/').pop() as string);
	if (!src) return undefined;
	return getImage({ src, widths: MUGSHOT_WIDTHS, format: 'avif' });
};

// Precompute optimised base + colour variants for each member. The colour layer
// is only revealed on hover, so its URLs are handed to `data-*` attributes and
// fetched lazily by the inline script — the initial grid pays for B&W only.
const cards = await Promise.all(
	team.map(async (member) => ({
		member,
		base: await optimiseMugshot(member.photo),
		color: await optimiseMugshot(member.photoColor ?? member.photo),
	}))
);

// Each link is a text action in the card's ink, named for where it goes.
const LINK_LABEL: Record<LinkKind, string> = {
	linkedin: 'LinkedIn',
	github: 'GitHub',
	web: 'Website',
	instagram: 'Instagram',
	email: 'Email',
};

---

<BaseLayout
	title="Team — DevFest.cz 2026"
	description="Meet the crew behind DevFest.cz 2026 — the organisers running Prague's community-built developer conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'The team'}
			lede="The volunteers putting this year's edition together, most of them developers who'd rather be debugging."
			seoHeading="DevFest.cz 2026 Team"
			titleId="team-title"
		/>


		<!-- ROSTER — every member a print on the table, the codename on tape. -->
		<section class="crew" aria-label="Organising team">
			<div class="crew-inner">
				<ul class="crew-grid">
					{cards.map(({ member, base, color }, i) => (
						<li class="crew-member">
							<article class="paper crew-card">
								<div class="paper-photo mugshot">
									{base ? (
										<>
											<img
												class="mugshot-base"
												src={base.src}
												srcset={base.srcSet.attribute}
												sizes={MUGSHOT_SIZES}
												alt={member.name}
												loading="lazy"
												decoding="async"
												width="700"
												height="875"
											/>
											<img
												class="mugshot-color"
												data-src={color?.src}
												data-srcset={color?.srcSet.attribute}
												sizes={MUGSHOT_SIZES}
												alt=""
												aria-hidden="true"
												decoding="async"
												width="700"
												height="875"
											/>
										</>
									) : (
										<span class="monogram" aria-hidden="true">{initials(member.name)}</span>
									)}
								</div>
								<div class="crew-info">
									<h2 class="crew-name">{member.name}</h2>
									{member.role && <p class="crew-role">{member.role}</p>}
									{member.links && member.links.length > 0 && (
										<ul class="crew-links">
											{member.links.map((link) => {
												const label = LINK_LABEL[link.kind];
												const external = link.kind !== 'email';
												return (
													<li>
														<a
															class="crew-link"
															href={link.url}
															aria-label={`${member.name} on ${label}`}
															{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
														>
															{label}
														</a>
													</li>
												);
											})}
										</ul>
									)}
									<p class="paper-edge crew-edge" aria-hidden="true">
										<span>{String(i + 1).padStart(2, '0')}</span>
										<span class="crew-edge-year">2026</span>
									</p>
								</div>
								{member.alias && <p class="tape crew-alias">{tapeText(member.alias)}</p>}
							</article>
						</li>
					))}
				</ul>

				<EndLine text="Want to help next year?" href="mailto:devfest@gug.cz" label="devfest@gug.cz" />
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	// Anchor each card's colour-bleed at the cursor: feed pointer position into
	// the radial mask via CSS vars; the expansion is CSS (:hover → --bleed).
	// The colour layer (~half the page weight) is fetched on first interaction
	// from data-* attributes. Bound on `astro:page-load` because
	// <ClientRouter /> swaps the page on soft navigations.
	document.addEventListener('astro:page-load', () => {
		const mugshots = document.querySelectorAll<HTMLElement>('.mugshot');
		mugshots.forEach((mugshot) => {
			const color = mugshot.querySelector<HTMLImageElement>('.mugshot-color');
			if (!color) return;

			const loadColor = () => {
				if (color.src) return; // already loaded
				if (color.dataset.srcset) color.srcset = color.dataset.srcset;
				if (color.dataset.src) color.src = color.dataset.src;
			};
			// Mouse: load when the pointer first enters. Keyboard: load when focus
			// moves into the card (only cards with links are focusable).
			mugshot.addEventListener('pointerenter', loadColor, { once: true });
			mugshot.closest('.crew-card')?.addEventListener('focusin', loadColor, { once: true });

			mugshot.addEventListener(
				'pointermove',
				(event) => {
					const rect = mugshot.getBoundingClientRect();
					const x = ((event.clientX - rect.left) / rect.width) * 100;
					const y = ((event.clientY - rect.top) / rect.height) * 100;
					color.style.setProperty('--mx', `${x}%`);
					color.style.setProperty('--my', `${y}%`);
				},
				{ passive: true }
			);
		});
	});
</script>

<style lang="scss">
	@use './team';
</style>
