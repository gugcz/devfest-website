---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import NextStep from '../../components/NextStep.astro';
import NextStepList from '../../components/NextStepList.astro';
import { APP_STORE_URL, GOOGLE_PLAY_URL } from '../../lib/app-stores';

// The app's sign-in email links to `/login/<code>`. With the app installed
// the phone opens the app instead (apple-app-site-association,
// assetlinks.json); on a computer, or a phone without the app, the browser
// lands here. Every code gets this page through a Hosting rewrite in
// firebase.json, since a static build has no page per code. The code stays
// in the URL only: this page never reads or shows it. Unlisted: noindex, out
// of the sitemap.
const STEPS = [
	{
		title: 'Type the code',
		noteHtml:
			'On the phone where you asked for it, the email also shows the code. ' +
			'Type it into the app to finish signing in.',
		actions: [],
	},
	{
		title: 'iPhone',
		noteHtml: 'No app yet? Get DevFest.cz from the App Store and sign in with your ticket.',
		actions: [{ href: APP_STORE_URL, label: 'Open the App Store', kind: 'primary' as const, external: true }],
	},
	{
		title: 'Android',
		noteHtml: 'No app yet? Get DevFest.cz from Google Play and sign in with your ticket.',
		actions: [{ href: GOOGLE_PLAY_URL, label: 'Open Google Play', external: true }],
	},
];
---

<BaseLayout
	title="Sign In to the App — DevFest.cz 2026"
	description="This sign-in link opens in the DevFest.cz app."
	noindex
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Open this<br />in the app'}
			lede="This sign-in link works only in the DevFest.cz app, on the phone where you asked for the code."
			seoHeading="DevFest.cz app sign-in"
			titleId="login-link-title"
		/>

		<section class="band band--lit" aria-labelledby="login-link-next-heading">
			<div class="band-inner">
				<NextStepList label="Finish signing in" labelId="login-link-next-heading">
					{STEPS.map((step) => <NextStep {...step} />)}
				</NextStepList>
			</div>
		</section>
	</main>
</BaseLayout>
