---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import NextStep from '../../components/NextStep.astro';
import NextStepList from '../../components/NextStepList.astro';
import { APP_LINKS } from '../../lib/app-links';
import { EVENT } from '../../lib/event';

// The app's sign-in email links to `/login/<code>`. With the app installed
// the phone opens the app instead (apple-app-site-association, and the
// assetlinks.json devfest.cz serves from outside this repo); on a computer,
// or a phone without the app, the browser lands here. Every code gets this
// page through a Hosting rewrite in firebase.json, since a static build has
// no page per code. The page never shows the code, and `src/lib/firebase.ts`
// cuts it from the URL GA4 sees (Performance Monitoring never boots here).
// Unlisted: noindex, out of the sitemap.

// A store link still `null` gets no button, as /app shows "Coming soon".
const storeAction = (href: string | null, label: string, kind: 'primary' | 'ghost') =>
	href ? [{ href, label, kind, external: true }] : [];

const STEPS = [
	{
		title: 'Type the code',
		noteHtml:
			'On the phone where you asked for it, the email also shows the code. ' +
			'Type it into the app to finish signing in.',
		actions: [],
	},
	{
		title: 'iPhone',
		noteHtml: 'No app yet? Get DevFest.cz from the App Store and sign in with your ticket.',
		actions: storeAction(APP_LINKS.appStore, 'Open the App Store', 'primary'),
	},
	{
		title: 'Android',
		noteHtml: 'No app yet? Get DevFest.cz from Google Play and sign in with your ticket.',
		actions: storeAction(APP_LINKS.googlePlay, 'Open Google Play', 'ghost'),
	},
];
---

<BaseLayout
	title={`Sign In to the App — ${EVENT.name}`}
	description="This sign-in link opens in the DevFest.cz app."
	noindex
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Open this<br />in the app'}
			lede="This sign-in link works only in the DevFest.cz app, on the phone where you asked for the code."
			seoHeading="DevFest.cz app sign-in"
			titleId="login-link-title"
		/>

		<section class="band band--lit" aria-labelledby="login-link-next-heading">
			<div class="band-inner">
				<NextStepList label="Finish signing in" labelId="login-link-next-heading">
					{STEPS.map((step) => <NextStep {...step} />)}
				</NextStepList>
			</div>
		</section>
	</main>
</BaseLayout>
