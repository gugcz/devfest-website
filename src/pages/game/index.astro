---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import NextStep from '../../components/NextStep.astro';
import NextStepList from '../../components/NextStepList.astro';
import { APP_LINKS } from '../../lib/app-links';

// The detective game's venue codes point at `/game/<token>`. With the app
// installed the phone opens the app instead (apple-app-site-association, and
// the assetlinks.json devfest.cz serves from outside this repo); without it
// the browser lands here. Every token gets this page through a Hosting
// rewrite in firebase.json, since a static build has no page per token.
// Unlisted: noindex, out of the sitemap.

// A store link still `null` gets no button, as /app shows "Coming soon".
const storeAction = (href: string | null, label: string, kind: 'primary' | 'ghost') =>
	href ? [{ href, label, kind, external: true }] : [];

const STEPS = [
	{
		title: 'iPhone',
		noteHtml: 'Get DevFest.cz from the App Store and sign in with your ticket.',
		actions: storeAction(APP_LINKS.appStore, 'Open the App Store', 'primary'),
	},
	{
		title: 'Android',
		noteHtml: 'Get DevFest.cz from Google Play and sign in with your ticket.',
		actions: storeAction(APP_LINKS.googlePlay, 'Open Google Play', 'ghost'),
	},
	{
		title: 'Then scan again',
		noteHtml:
			'Once the app is in, scan this code again with the camera. The clue opens ' +
			'in the app. Stuck? Ask at the info desk at the venue.',
		actions: [],
	},
];
---

<BaseLayout
	title="Detective Game — DevFest.cz 2026"
	description="This code belongs to the DevFest.cz detective game. It opens in the DevFest.cz app."
	noindex
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'A clue for<br />the app'}
			lede="You found a code from the detective game. It opens in the DevFest.cz app, so get the app first and scan it again."
			seoHeading="DevFest.cz detective game"
			titleId="game-link-title"
		/>

		<section class="band band--lit" aria-labelledby="game-link-next-heading">
			<div class="band-inner">
				<NextStepList label="Get the app" labelId="game-link-next-heading">
					{STEPS.map((step) => <NextStep {...step} />)}
				</NextStepList>
			</div>
		</section>
	</main>
</BaseLayout>
