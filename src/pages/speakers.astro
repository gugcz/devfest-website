---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Speakers from '../components/Speakers.tsx';
---

<BaseLayout
	title="Speakers — DevFest.cz 2026"
	description="Meet the speakers taking the stage at DevFest.cz 2026 — developers, Google Developer Experts and researchers from across Europe and beyond, at Prague's community-built developer conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Speakers'}
			lede="Everyone on stage on 30 October. Pick anyone for their bio and talk. Times in CET."
			seoHeading="DevFest.cz 2026 Speakers"
			titleId="speakers-title"
		/>

		<section class="band lineup" aria-label="Speaker lineup">
			<div class="band-inner">
				<!-- The hero already names this band, so its head is for screen
				     readers only; a second poster headline ("Who's talking") under
				     "Speakers" said the same thing twice. -->
				<h2 class="sr-only">Speakers</h2>

				<!-- The prints hydrate client-side from /api/lineup and end on the way to
				     the agenda and tickets (no closer under them); keep a static note for
				     crawlers and no-JS visitors. -->
				<Speakers client:load />

				<noscript>
					<p class="fallback-note">
						The speaker lineup loads with JavaScript enabled. Please turn it on, or
						check back soon.
					</p>
				</noscript>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	/* The prints sit right under the head: the hero's own bottom padding is the
	   only air between them, as on the approved mock. */
	:global(.subpage-hero) + .band.lineup {
		padding-top: 0;
	}
</style>
