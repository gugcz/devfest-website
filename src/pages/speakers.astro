---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Speakers from '../components/Speakers.tsx';
---

<BaseLayout
	title="Speakers — DevFest.cz 2026"
	description="Meet the speakers taking the stage at DevFest.cz 2026 — Prague's community-built developer conference."
>
	<main class="speakers-page">
		<SubpageHero
			label="On the record"
			titleHtml={'The voices on<br />the <span class="red">stand</span>.'}
			lede="The developers, makers and researchers stepping up to the mic at DevFest.cz 2026. The lineup grows as speakers are confirmed."
			seoHeading="DevFest.cz 2026 Speakers"
			titleId="speakers-title"
		/>

		<section class="speakers-body" aria-label="Speaker lineup">
			<div class="speakers-inner">
				<header class="speakers-header">
					<p class="speakers-eyebrow">The lineup</p>
					<h2 class="speakers-heading">Who&rsquo;s talking</h2>
					<!-- The one affordance line for the whole sheet. It used to be a
					     "View profile →" chip printed on every single card. -->
					<p class="speakers-hint">Pick a face for the full record</p>
				</header>

				<!-- The grid hydrates client-side from Firestore; keep a static note
				     for crawlers and no-JS visitors. -->
				<Speakers client:load />

				<noscript>
					<p class="speakers-noscript">
						The speaker lineup loads with JavaScript enabled. Please turn it on, or
						check back soon.
					</p>
				</noscript>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './speakers';
</style>
