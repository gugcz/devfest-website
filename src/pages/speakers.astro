---
// Rendered on demand so the grid ships in the server HTML — the Admin SDK read
// below bypasses App Check, so mobile never waits on a reCAPTCHA token (the old
// client Firestore read is gone). Must stay a literal `false`: Astro's prerender
// detection is static, so a non-literal silently falls back to prerendering. The
// axe build (A11Y_MOCK) runs this same handler via scripts/a11y.mjs with the
// firebase-admin read aliased to fixtures.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Speakers from '../components/Speakers.tsx';
import { adminFirestore } from '../lib/firebase-admin';
import { applyContentCache } from '../lib/ssr-cache';
import { speakerFromDoc, type Speaker } from '../lib/speakers';

let speakers: Speaker[] = [];
let ok = false;
try {
	const snap = await adminFirestore().collection('speakers').orderBy('order').get();
	speakers = snap.docs.map((doc) => speakerFromDoc(doc.id, doc.data()));
	ok = speakers.length > 0;
} catch (err) {
	console.error('[speakers] SSR Firestore read failed:', err);
}

// Cache a populated render at the edge; never cache a failed/empty one (503 so a
// transient blip isn't indexed or pinned at the CDN).
applyContentCache(Astro.response, ok);
if (!ok) Astro.response.status = 503;
---

<BaseLayout
	title="Speakers — DevFest.cz 2026"
	description="Meet the speakers taking the stage at DevFest.cz 2026 — Prague's largest community developer conference."
>
	<main class="speakers-page">
		<SubpageHero
			label="On the record"
			titleHtml={'The voices<br /><span class="red">on the stand.</span>'}
			lede="The developers, makers and researchers stepping up to the mic at DevFest.cz 2026. The lineup grows as speakers are confirmed."
			seoHeading="DevFest.cz 2026 Speakers"
			titleId="speakers-title"
		/>

		<section class="speakers-body" aria-label="Speaker lineup">
			<div class="speakers-inner">
				<header class="speakers-header">
					<p class="speakers-eyebrow">The lineup</p>
					<h2 class="speakers-heading">Who&rsquo;s talking</h2>
				</header>

				<!-- The grid is server-rendered from Firestore (Admin SDK); the island
				     hydrates from these props for the detail dialog. Present in the
				     HTML with or without JavaScript. -->
				<Speakers client:load speakers={speakers} failed={!ok} />
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './speakers';
</style>
