---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import EndLine from '../components/EndLine.astro';
import { APP_LINKS } from '../lib/app-links';
// Official store badges (Apple and Google artwork, unaltered, as their brand
// guidelines require): the one place the site shows a control it did not draw.
import googlePlayBadge from '../assets/app-badges/google-play.svg';
import appStoreBadge from '../assets/app-badges/app-store.svg';

// THE APP PAGE. Venue QR codes land here, so on a phone the store badges sit
// straight under the hero. The script below puts the visitor's own store
// first and notes it; the DOM order moves too, so focus follows the eye.
const stores = [
	{
		platform: 'ios',
		name: 'App Store',
		badge: { src: appStoreBadge.src, alt: 'Download on the App Store', width: 120, height: 40 },
		href: APP_LINKS.appStore,
	},
	{
		platform: 'android',
		name: 'Google Play',
		badge: { src: googlePlayBadge.src, alt: 'Get it on Google Play', width: 241, height: 71 },
		href: APP_LINKS.googlePlay,
	},
];

// What the app does, as the privacy policy describes it — nothing it doesn't.
const features = [
	{ title: 'The programme', desc: 'Every talk and workshop, room by room, and what is on right now.' },
	{ title: 'Your schedule', desc: 'Star the talks you want and the app keeps your day in order.' },
	{ title: 'Reminders', desc: 'A nudge before your talks, and news from the crew on the day.' },
	{ title: 'Networking', desc: 'Scan the QR code on someone’s badge to keep their contact.' },
];
---

<BaseLayout
	title="Get the App — DevFest.cz 2026"
	description="The DevFest.cz 2026 app: the programme, your own schedule, reminders and badge-scan networking. App Store, Google Play, or the web app in any browser."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml="Get the app"
			lede="The programme, your schedule and a reminder before every talk. Free, for iPhone, Android or any browser."
			seoHeading="DevFest.cz 2026 app"
			titleId="app-title"
		/>

		<section class="band band--lit app-get-band" aria-labelledby="get-title">
			<div class="band-inner">
				<h2 id="get-title" class="sr-only">Download</h2>

				<ul class="app-stores" data-app-stores>
					{stores.map((s) => (
						<li class="app-store" data-platform={s.platform}>
							<span class="app-yours" hidden>Your phone</span>
							{s.href ? (
								<a class="app-badge-link" href={s.href} target="_blank" rel="noopener noreferrer">
									<img class="app-badge" src={s.badge.src} alt={s.badge.alt} width={s.badge.width} height={s.badge.height} />
								</a>
							) : (
								<span class="app-soon">
									<span class="app-soon-name">{s.name}</span>
									<span class="app-soon-word">Coming soon</span>
								</span>
							)}
						</li>
					))}
				</ul>

				<p class="app-web">
					<span class="app-web-text">Rather not install anything?</span>
					{APP_LINKS.pwa ? (
						<a class="action" href={APP_LINKS.pwa} target="_blank" rel="noopener noreferrer">Open the web app</a>
					) : (
						<span class="app-soon-word">The web app is coming soon.</span>
					)}
				</p>
			</div>
		</section>

		<section class="band band--lit" aria-labelledby="inside-title">
			<div class="band-inner">
				<div class="head-rule">
					<h2 id="inside-title" class="head-rule-title">What’s inside</h2>
					<p class="head-rule-note">Built for the day itself: where to be, what is next, who you met.</p>
				</div>

				<ol class="app-cards" role="list">
					{features.map((f, i) => (
						<li class="paper app-card">
							<span class="app-card-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="app-card-title">{f.title}</h3>
							<p>{f.desc}</p>
						</li>
					))}
				</ol>

				<EndLine text="Rather see it all on a big screen?" href="/agenda" label="Open the agenda" />
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	// Put the visitor's own store first. iPadOS reports itself as a Mac, so a
	// Mac with a touch screen counts as iOS. Anything else keeps the page order.
	function detectPlatform(): 'android' | 'ios' | null {
		const ua = navigator.userAgent;
		if (/Android/i.test(ua)) return 'android';
		if (/iPhone|iPad|iPod/i.test(ua)) return 'ios';
		if (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1) return 'ios';
		return null;
	}

	document.addEventListener('astro:page-load', () => {
		const list = document.querySelector<HTMLElement>('[data-app-stores]');
		const platform = detectPlatform();
		if (!list || !platform) return;
		const item = list.querySelector<HTMLElement>(`[data-platform="${platform}"]`);
		if (!item) return;
		list.prepend(item);
		item.querySelector<HTMLElement>('.app-yours')?.removeAttribute('hidden');
	});
</script>

<style lang="scss">
	@use './app';
</style>
