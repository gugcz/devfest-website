---
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown';
import NewsletterForm from '../components/NewsletterForm';
import Footer from '../components/Footer';
---

<BaseLayout>
	<main class="landing">
		<h1 class="title">
			<img src="/logo.svg" alt="DevFest.cz 2026" class="logo" />
		</h1>
		<p class="tagline">The most original conference in Prague is here again. And there some mysteries are not missing.</p>
		<div class="countdown-section">
			<Countdown client:load />
		</div>
		<p class="cta-text">Be the first to know when tickets drop.</p>
		<div class="newsletter-wrapper">
			<NewsletterForm client:load />
		</div>
		<a class="last-year" href="https://2025.devfest.cz" target="_blank" rel="noopener noreferrer">
			See last year's edition
			<span class="last-year-arrow" aria-hidden="true">&#8599;</span>
		</a>
		<p class="location">
			<span class="location-icon" aria-hidden="true">&#9670;</span>
			Prague, Czech Republic · 30. 10. 2026
		</p>
		<div class="decoration-line" aria-hidden="true"></div>
	</main>
	<Footer client:load />
</BaseLayout>

<style lang="scss">
	.landing {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 4rem 1.5rem 6rem;
		gap: 1.5rem;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.title {
		animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
		line-height: 0;
	}

	.logo {
		width: clamp(280px, 60vw, 520px);
		height: auto;
	}

	.tagline {
		font-family: 'Share Tech Mono', monospace;
		font-size: 1.1rem;
		font-style: italic;
		line-height: 1.6;
		max-width: 480px;
		color: #888;
		margin-top: 0.5rem;
		text-align: center;
		animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
	}

	.countdown-section {
		margin: 1.5rem 0;
		padding: 2.5rem 0;
		position: relative;
		animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;

		&::before,
		&::after {
			content: '';
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
			width: 200px;
			height: 1px;
			background: linear-gradient(
				90deg,
				transparent 0%,
				rgba(204, 0, 0, 0.25) 50%,
				transparent 100%
			);
		}

		&::before { top: 0; }
		&::after { bottom: 0; }
	}

	.cta-text {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		opacity: 0.4;
		animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
	}

	.newsletter-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
	}

	.last-year {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text);
		text-decoration: none;
		border: 1px solid rgba(204, 0, 0, 0.4);
		padding: 0.7rem 2rem;
		clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
		transition: background 0.25s, color 0.25s, border-color 0.25s;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
		animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;

		&:hover {
			background: rgba(204, 0, 0, 0.15);
			border-color: rgba(204, 0, 0, 0.7);
			color: var(--color-text);
		}
	}

	.last-year-arrow {
		font-size: 0.85rem;
		transition: transform 0.25s;

		.last-year:hover & {
			transform: translate(1px, -1px);
		}
	}

	.location {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.25;
		margin-top: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;
	}

	.location-icon {
		font-size: 0.5rem;
		color: var(--color-accent);
		opacity: 0.8;
	}

	.decoration-line {
		width: 40px;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(204, 0, 0, 0.4), transparent);
		margin-top: 1rem;
		animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
