---
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown';
import NewsletterForm from '../components/NewsletterForm';
import Footer from '../components/Footer.astro';
import HeroBackground from '../components/HeroBackground.astro';
import Ticker from '../components/Ticker.astro';
import Tickets from '../components/Tickets';
import SpeakersTeaser from '../components/SpeakersTeaser';
import { showcasePartners } from '../lib/partners';

// Homepage "silver+" strip — every sponsor tier in ladder order, top tier first.
const homePartners = showcasePartners;

const tickerTopics = [
	'AI & Machine Learning',
	'Android & Kotlin',
	'Web Technologies',
	'Cloud & DevOps',
	'Flutter & Dart',
	'Security',
	'Open Source',
];
---

<BaseLayout>
	<!-- Preload the LCP hero background so it isn't discovered only after CSS parse -->
	<link
		slot="head"
		rel="preload"
		as="image"
		href="/hero-detective.webp"
		fetchpriority="high"
	/>

	<main class="page">
		<!-- HERO -->
		<section id="hero" class="scene">
			<HeroBackground photoOpacity={0.85} mobilePhotoOpacity={0.55} />
			<div class="scene-vignette" aria-hidden="true"></div>

			<div class="hero-grid">
				<div class="hero-content">
					<h1 class="hero-title">
						<img src="/logo.png" alt="" class="hero-logo" width="420" height="84" />
						<span class="sr-only">DevFest.cz 2026 — Prague Developer Conference. Web, Mobile, Cybersecurity, AI/ML. October 30, 2026.</span>
					</h1>

					<p class="hero-subtitle">
						Prague&rsquo;s most original conference is back—and it&rsquo;s brought a few mysteries with it.
					</p>

					<div class="hero-meta">
						<div class="meta-item">
							<span class="meta-label">Date</span>
							<span class="meta-value">30. 10. 2026</span>
						</div>
						<div class="meta-item">
							<span class="meta-label">Place</span>
							<a
								class="meta-value meta-value--link"
								href="https://maps.app.goo.gl/W5bcH4BgFQ1B8QAm8"
								target="_blank"
								rel="noopener noreferrer"
							>
								Uhelný Mlýn
								<span class="meta-sub">near Prague</span>
							</a>
						</div>
					</div>

					<div class="hero-cta-group">
						<a href="#tickets" class="btn-primary">Get tickets</a>
						<a href="#newsletter" class="btn-ghost">
							Stay in the loop
							<span class="btn-ghost-arrow" aria-hidden="true">&#8600;</span>
						</a>
					</div>
				</div>

				<aside class="hero-countdown" aria-label="Time until doors open">
					<div class="section-label">Doors open in</div>
					<Countdown client:load />
				</aside>
			</div>
		</section>

		<!-- TICKER -->
		<Ticker items={tickerTopics} />

		<!-- TICKETS -->
		<Tickets client:visible />

		<!-- SPEAKERS TEASER — auto-rotating lineup spotlight; hides until data loads.
		     client:load (not visible): the island renders nothing until Firestore
		     resolves, so a client:visible observer would never fire on the
		     zero-height placeholder. -->
		<SpeakersTeaser client:load />

		<!-- CALL FOR SPEAKERS — hidden: CFP closed
		<section id="speakers" aria-labelledby="speakers-title">
			<div class="speakers-inner reveal">
				<p class="section-label">Call for speakers</p>
				<h2 id="speakers-title" class="section-title">
					Wanted: <span class="red">your talk.</span>
				</h2>
				<p class="speakers-lede">
					The DevFest.cz 2026 stage is now taking submissions. Got a story worth telling&mdash;AI, Android, web, cloud, Flutter, security, open source? Make your case.
				</p>
				<div class="speakers-cta-group">
					<a
						href="https://sessionize.com/devfest-cz-2026"
						class="btn-primary"
						target="_blank"
						rel="noopener"
					>Submit a talk</a>
					<span class="speakers-tag">CFP open now</span>
				</div>
			</div>
		</section>
		-->

		<!-- PARTNERS — quiet silver+ strip; media partners live on /partners only -->
		{homePartners.length > 0 && (
			<section id="partners" aria-labelledby="partners-title">
				<div class="partners-inner reveal">
					<p id="partners-title" class="section-label">Partners</p>

					<ul class="partners-row">
						{homePartners.map((p) => (
							<li class="partners-item">
								{p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
										<img class="partners-logo" src={p.logo} alt={p.name} loading="lazy" />
									</a>
								) : (
									<img class="partners-logo" src={p.logo} alt={p.name} loading="lazy" />
								)}
							</li>
						))}

						<li class="partners-more">
							<a href="/partners">
								See all
								<span class="btn-ghost-arrow" aria-hidden="true">&#8600;</span>
							</a>
						</li>
					</ul>
				</div>
			</section>
		)}

		<!-- GALLERY — photos from past editions -->
		<section id="gallery" aria-labelledby="gallery-title">
			<div class="gallery-head reveal">
				<p class="section-label">Past editions</p>
				<h2 id="gallery-title" class="section-title">Look <span class="red">back.</span></h2>
				<p class="gallery-lede">
					A look back at past editions of DevFest.cz &mdash; and the community that makes them.
				</p>
			</div>

			<div class="gallery-marquee" aria-hidden="true">
				<div class="gallery-track">
					{Array.from({ length: 2 }).map(() => (
						<>
							{Array.from({ length: 22 }, (_, i) => {
								const n = String(i + 1).padStart(2, '0');
								return (
									<img
										src={`/gallery/devfest-2025-${n}.webp`}
										alt=""
										loading="lazy"
										decoding="async"
										width="1080"
										height="720"
									/>
								);
							})}
						</>
					))}
				</div>
			</div>
		</section>

		<!-- NEWSLETTER -->
		<section id="newsletter">
			<div class="newsletter-inner reveal">
				<p class="section-label">Newsletter</p>
				<h2 class="section-title">Be the first<br /><span class="red">to know.</span></h2>
				<p class="newsletter-lede">
					Leave your email and we'll let you know the moment tickets go on sale.
				</p>
				<NewsletterForm client:visible />
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style lang="scss">
	@use './index';
</style>

<script>
	const track = document.querySelector<HTMLElement>('.gallery-track');
	if (track) {
		const all = Array.from(track.children) as HTMLElement[];
		const unique = all.slice(0, all.length / 2);
		for (let i = unique.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[unique[i], unique[j]] = [unique[j], unique[i]];
		}
		const shuffled = [...unique, ...unique.map((n) => n.cloneNode(true) as HTMLElement)];
		track.replaceChildren(...shuffled);
	}
</script>
