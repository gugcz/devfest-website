---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOffer from '../components/HeroOffer';
import NewsletterForm from '../components/NewsletterForm';
import HeroBackground from '../components/HeroBackground.astro';
import Tickets from '../components/Tickets';
import SpeakersTeaser from '../components/SpeakersTeaser';
import { getActivePartnerTiers, getCommunityPartners, partnerLogo, type Partner } from '../lib/partners';
import { TOPICS } from '../lib/topics';

// The home page is one ruled document: a full-bleed plate with the statement
// set into it, a facts line with the page's one red fill, then four ruled
// sections (the event, tickets, speakers, partners) and the newsletter.
// Every section opens on `.head-rule`; every list row is a `.field-row`.

// One row per tier, top tier first; community closes the wall. Media
// partners live on /partners only.
const communityPartners = await getCommunityPartners();
const homeRows: { id: string; label: string; partners: Partner[] }[] = [
	...(await getActivePartnerTiers()),
	{ id: 'community', label: 'Community', partners: communityPartners },
].filter((row) => row.partners.length > 0);

// The mosaic's eight, in its order: the full hall leads (2×2), the
// group on stage spans the last row's first half (index.scss).
const GALLERY = ['01', '02', '03', '08', '20', '13', '21', '14'] as const;

// The home wall is the /partners ladder at 70%: each tier's reference box
// (`partnerLogo()`) shrunk, so the rank reads the same on both pages.
const STRIP_SCALE = 0.7;
---

<BaseLayout description="DevFest.cz 2026 — Prague's developer conference & festival: AI agents, generative UI, cloud & backends, mobile & web accessibility, and the humans behind it. 30 October 2026. Tickets on sale now.">
	<!-- Preload the LCP hero background so it isn't discovered only after CSS parse -->
	<link
		slot="head"
		rel="preload"
		as="image"
		href="/hero-detective.webp"
		fetchpriority="high"
	/>

	<main class="page-stack">
		<!-- HERO — the plate runs edge to edge; the statement is set into its
		     lower left, the case-file stamp into its upper left. Nothing else
		     sits on the photograph. -->
		<section id="hero" class="scene" aria-labelledby="hero-title">
			<div class="hero-plate">
				<HeroBackground
					photoOpacity={0.9}
					mobilePhotoOpacity={0.7}
					mobileFocus="42% 40%"
					mobileZoom="auto 120%"
					width="100%"
					focus="56% 42%"
				/>
				<div class="scene-vignette" aria-hidden="true"></div>
				<h1 id="hero-title" class="hero-statement display">
					<span class="sr-only">DevFest.cz 2026 — Prague Developer Conference, 30 October 2026. </span>
					Prague&rsquo;s most original<br />conference is <span class="red">back.</span>
				</h1>
			</div>

			<!-- The facts line under the plate: date, venue, the wave on sale, and
			     the page's one red fill. -->
			<div class="hero-line">
				<div class="hero-facts">
					<time datetime="2026-10-30">30 Oct 2026</time>
					<span class="hero-facts-dot" aria-hidden="true">·</span>
					<a
						class="hero-facts-link"
						href="https://maps.app.goo.gl/W5bcH4BgFQ1B8QAm8"
						target="_blank"
						rel="noopener noreferrer"
					>Uhelný Mlýn, near Prague</a>
					<HeroOffer client:load />
				</div>
				<a href="#tickets" class="btn-primary hero-cta">Get tickets</a>
			</div>
		</section>

		<!-- THE EVENT — a note and the facts list, both typewriter, on two columns. -->
		<section class="band sec" aria-labelledby="facts-title">
			<div class="band-inner">
				<header class="head-rule">
					<h2 id="facts-title" class="head-rule-title">The event</h2>
				</header>
				<div class="facts">
					<p class="facts-note">
						The eleventh DevFest.cz: one day in a converted coal mill
						25 minutes north of Prague, for 350 medior and senior
						developers from across CEE.
					</p>
					<dl class="facts-list">
						<div><dt>Date</dt><dd><time datetime="2026-10-30">30 October 2026</time></dd></div>
						<div><dt>Place</dt><dd>Uhelný Mlýn, Libčice nad Vltavou</dd></div>
						<div><dt>Doors</dt><dd>08:00 &mdash; 20:00</dd></div>
						<div><dt>Audience</dt><dd>350 developers</dd></div>
						<div><dt>Programme</dt><dd>{TOPICS.map((t) => t.name).join(' · ')}</dd></div>
					</dl>
				</div>
			</div>
		</section>

		<!-- TICKETS — client:load, not visible: the hero's "Get tickets" jumps
		     straight here, and a visible-gated island only began loading on
		     arrival, so a phone landed on the skeleton. -->
		<Tickets client:load />

		<!-- SPEAKERS — the register's first lines; hides until data loads. -->
		<SpeakersTeaser client:load />

		<!-- PAST EDITIONS — the one place the page shows the event itself: eight
		     press photographs as a mosaic, the hall leading. Decorative: the
		     section title says what they are. -->
		<section class="band sec" aria-labelledby="gallery-title">
			<div class="band-inner">
				<header class="head-rule">
					<h2 id="gallery-title" class="head-rule-title">Past editions</h2>
				</header>
				<ul class="gallery" role="list">
					{GALLERY.map((n) => (
						<li>
							<img
								src={`/gallery/devfest-2025-${n}.webp`}
								alt=""
								loading="lazy"
								decoding="async"
								width="1080"
								height="720"
							/>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- PARTNERS — one wall, one row per tier, marks on one height per tier. -->
		{homeRows.length > 0 && (
			<section class="band sec" aria-labelledby="partners-title">
				<div class="band-inner">
					<header class="head-rule">
						<h2 id="partners-title" class="head-rule-title">Partners</h2>
					</header>
					<div class="partners-tiers">
						{homeRows.map((tier) => (
							<ul class={`partners-row tier-${tier.id}`} aria-label={tier.label}>
								{tier.partners.map((p) => {
									const { props } = partnerLogo(p, tier.id, STRIP_SCALE);
									return (
										<li class="partners-item">
											{p.url ? (
												<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
													<Image class={`partners-logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
												</a>
											) : (
												<Image class={`partners-logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
											)}
										</li>
									);
								})}
							</ul>
						))}
					</div>
					<a class="action" href="/partners">All partners</a>
				</div>
			</section>
		)}

		<!-- NEWSLETTER — `anchor-target`: the ticket footnote, the footer and the FAQ jump here. -->
		<section id="newsletter" class="band sec anchor-target" aria-labelledby="newsletter-title">
			<div class="band-inner">
				<header class="head-rule">
					<h2 id="newsletter-title" class="head-rule-title">Newsletter</h2>
				</header>
				<div class="newsletter">
					<p class="newsletter-lede">We write when a wave opens or a speaker is confirmed. Nothing else.</p>
					<div class="newsletter-form">
						<NewsletterForm client:visible />
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './index';
</style>
