---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOffer from '../components/HeroOffer';
import Countdown from '../components/Countdown';
import NewsletterForm from '../components/NewsletterForm';
import HeroBackground from '../components/HeroBackground.astro';
import Tickets from '../components/Tickets';
import SpeakersTeaser from '../components/SpeakersTeaser';
import TicketIndex from '../components/TicketIndex.astro';
import StoreBadges from '../components/StoreBadges.astro';
import {
	getActivePartnerTiers,
	getCommunityPartners,
	getTravelPartners,
	partnerLogo,
	type Partner,
} from '../lib/partners';
import { getTopics } from '../lib/topics';
import { EVENT, eventDate } from '../lib/event';
import { staticTicketLines } from '../lib/tickets-static';
import config from '../site.config';
import { enabled, ticketsHref } from '../lib/flags';

// The hero stamp sets the figures in the mono face and the month between them.
const [heroDay, heroMonth, heroYear] = EVENT.dateShort.split(' ');

// The home page as prints on a black table: the full-bleed plate with the
// statement set left over it, then the event (a widescreen print and its
// back), tickets, speakers, the past editions as a contact sheet, the
// partner wall with a plain label per tier, and the newsletter card.

// One row per tier, top tier first. Silver and community share a row (each
// mark still sized by its own tier), travel gets the last one. Media partners
// live on /partners only.
const communityPartners = await getCommunityPartners();
const travelPartners = await getTravelPartners();
const ladder = await getActivePartnerTiers();
// The prices as of the build, for readers that run no script.
const ticketLines = enabled('tickets') ? await staticTicketLines() : [];
const topics = await getTopics();
type HomeRow = { id: string; label: string; partners: { p: Partner; tier: string }[] };
const tail = [
	...(ladder.find((t) => t.id === 'silver')?.partners.map((p) => ({ p, tier: 'silver' })) ?? []),
	...communityPartners.map((p) => ({ p, tier: 'community' })),
];
const homeRows: HomeRow[] = [
	...ladder
		.filter((t) => t.id !== 'silver')
		.map((t) => ({ id: t.id, label: t.label, partners: t.partners.map((p) => ({ p, tier: t.id })) })),
	{
		id: 'silver',
		label: ladder.some((t) => t.id === 'silver') ? 'Silver and community' : 'Community',
		partners: tail,
	},
	{ id: 'travel', label: 'Travel', partners: travelPartners.map((p) => ({ p, tier: 'travel' })) },
].filter((row) => row.partners.length > 0);

// The contact sheet: two strips of four frames, the hall (01) third on the
// first strip, ringed in grease and enlarged beside the sheet. Frame numbers
// run on like a roll of film.
const STRIPS = [
	[
		{ n: '02', no: '11A' },
		{ n: '03', no: '12' },
		{ n: '01', no: '12A' },
		{ n: '08', no: '13' },
	],
	[
		{ n: '20', no: '13A' },
		{ n: '13', no: '14' },
		{ n: '21', no: '14A' },
		{ n: '14', no: '15' },
	],
] as const;
const RINGED = '01';

// The home wall uses the /partners reference boxes (`partnerLogo()`) as they
// are; each tier's `--logo-scale` in index.scss sets the rank on this page.
const STRIP_SCALE = 1;
---

<BaseLayout description={`${EVENT.name} — ${config.event.tagline}: ${config.event.pitch} ${EVENT.dateLabel}. Tickets on sale now.`}>
	{/* Preload the LCP hero background so it isn't discovered only after CSS parse */}
	<link
		slot="head"
		rel="preload"
		as="image"
		href="/hero-detective.webp"
		fetchpriority="high"
	/>

	<main class="page-stack">
		{/* HERO — the plate runs edge to edge, the photograph pushed right and
		     fading to black on its left and bottom; the statement, the facts
		     line and the page's one red fill are set left over it. */}
		<section id="hero" class="scene" aria-labelledby="hero-title">
			<HeroBackground
				photoOpacity={1}
				mobilePhotoOpacity={1}
				mobileFocus="42% 40%"
				width="74%"
				focus="38% 42%"
			/>
			<div class="hero-shade" aria-hidden="true"></div>
			<div class="hero-body">
				<h1 id="hero-title" class="hero-statement display">
					<span class="sr-only">{EVENT.name} — Prague Developer Conference, {EVENT.dateLabel}. </span>
					Prague&rsquo;s most original conference is <span class="red">back.</span>
				</h1>

				{/* The day's five topics, billed under the statement. */}
				<ul class="hero-topics" role="list" aria-label="Topics">
					{topics.map((t) => <li>{t.name}</li>)}
				</ul>

				<div class="hero-facts">
					<time class="hero-date" datetime={eventDate('iso')}><span class="fig">{heroDay}</span> {heroMonth} <span class="fig">{heroYear}</span></time>
					<Countdown client:load />
					<a
						class="hero-facts-link"
						href={EVENT.mapUrl}
						target="_blank"
						rel="noopener noreferrer"
					>{EVENT.venue}, {config.event.venue.city}</a>
					{ticketsHref && <HeroOffer client:load />}
				</div>
				{ticketsHref && <a href="#tickets" class="btn-primary hero-cta">Get tickets</a>}
			</div>
		</section>

		{/* THE EVENT — a widescreen print of the mill with the line set over it
		     like a subtitle, and the back of the print beside it. */}
		<section class="band sec event" aria-labelledby="facts-title">
			<div class="band-inner">
				<header class="head-rule">
					<h2 id="facts-title" class="head-rule-title event-title">The eleventh DevFest.cz</h2>
				</header>
				<div class="event-grid">
					<div class="paper event-print">
						<span class="tape">{EVENT.venue}, {config.event.venue.city}</span>
						<div class="paper-photo event-photo">
							<img
								src="/gallery/uhelny-mlyn-chimney.webp"
								alt={`The chimney of ${EVENT.venue}, the converted coal mill at ${config.event.venue.city}`}
								loading="lazy"
								decoding="async"
								width="1824"
								height="1368"
							/>
							<p class="event-subtitle">
								One day in a converted coal mill <span class="fig">25</span> minutes
								north of Prague, for <span class="fig">350</span> medior and senior
								developers from across CEE.
							</p>
						</div>
						<div class="paper-edge" aria-hidden="true">
							<span>02</span><span>2.39 : 1</span><span>08:00</span>
						</div>
					</div>

					<div class="event-card">
						<div class="paper-edge event-card-edge" aria-hidden="true">
							<span class="edge-word">On the back</span>
						</div>
						<dl class="facts-list">
							<div><dt>Date</dt><dd><time datetime={eventDate('iso')}>{EVENT.dateLabel}</time></dd></div>
							<div><dt>Place</dt><dd>{EVENT.venue}, {config.event.venue.city}</dd></div>
							<div><dt>Doors</dt><dd><span class="fig">08:00&ndash;23:00</span></dd></div>
							<div>
								<dt>Audience</dt>
								<dd><span class="fig">350</span> developers</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>
		</section>

		{/* THE APP — the same badges as /app, so nobody needs the venue QR code
		     to find it. */}
		{enabled('app') && <section class="band sec home-app" aria-labelledby="home-app-title">
			<div class="band-inner">
				<header class="head-rule">
					<h2 id="home-app-title" class="head-rule-title">Get the app</h2>
					<p class="head-rule-note">The programme, your schedule and a reminder before every talk, on your phone.</p>
				</header>
				<StoreBadges />
				<p class="home-app-more"><a class="action" href="/app">What’s in the app</a></p>
			</div>
		</section>}

		{/* TICKETS — client:load, not visible: the hero's "Get tickets" jumps
		     straight here, and a visible-gated island only began loading on
		     arrival, so a phone landed on the skeleton. */}
		{enabled('tickets') && <Tickets client:load />}
		{ticketLines.length > 0 && <TicketIndex lines={ticketLines} />}

		{/* SPEAKERS — the register's first lines; hides until data loads. */}
		<SpeakersTeaser client:load />

		{/* PAST EDITIONS — a contact sheet of the last edition, one frame ringed
		     in grease and enlarged beside it. The frames are decorative; the
		     enlargement carries the description. */}
		<section class="band sec" aria-labelledby="gallery-title">
			<div class="band-inner">
				<header class="head-rule">
					<h2 id="gallery-title" class="head-rule-title">Past editions</h2>
					<p class="head-rule-note">Ten editions since <span class="fig">2012</span>.</p>
				</header>
				<div class="past-grid">
					<div class="sheet">
						{STRIPS.map((strip) => (
							<ul class="strip" role="list">
								{strip.map((f) => (
									<li class="frame">
										<span class="frame-no" aria-hidden="true">{f.no}</span>
										<div class="frame-photo">
											<img
												src={`/gallery/devfest-2025-${f.n}.webp`}
												alt=""
												loading="lazy"
												decoding="async"
												width="1080"
												height="720"
											/>
										</div>
										{f.n === RINGED && (
											<svg class="grease" viewBox="0 0 200 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
												<path d="M30 34 C 60 6, 150 4, 186 34 C 204 60, 196 112, 150 128 C 100 142, 30 134, 12 100 C 0 72, 14 44, 58 22" />
											</svg>
										)}
									</li>
								))}
							</ul>
						))}
						<div class="sheet-edge" aria-hidden="true"><span>2015</span><span>2025</span></div>
					</div>
					<div class="paper past-print">
						<span class="tape">The big hall</span>
						<div class="paper-photo past-photo">
							<img
								src={`/gallery/devfest-2025-${RINGED}.webp`}
								alt="The big hall full of attendees facing the stage at DevFest.cz 2025"
								loading="lazy"
								decoding="async"
								width="800"
								height="533"
							/>
						</div>
						<div class="paper-edge" aria-hidden="true"><span>12A</span><span>2025</span></div>
					</div>
				</div>
			</div>
		</section>

		{/* PARTNERS — one plain label per tier; each mark's box comes from its
		     tier (`partnerLogo()`), so the size carries the rank. */}
		{enabled('partners') && homeRows.length > 0 && (
			<section class="band sec" aria-labelledby="partners-title">
				<div class="band-inner">
					<header class="head-rule">
						<h2 id="partners-title" class="head-rule-title">Partners</h2>
						<div class="partners-actions">
							<a class="action" href="/partners">All partners</a>
							<a class="action" href="/partners#partners-cta-title">Become a partner</a>
						</div>
					</header>
					<div class="partners-tiers">
						{homeRows.map((row) => (
							<div class={`partners-tier tier-${row.id}`}>
								<h3 class="partners-label" id={`tier-${row.id}-label`}>{row.label}</h3>
								<ul class="partners-row" aria-labelledby={`tier-${row.id}-label`}>
									{row.partners.map(({ p, tier }) => {
										const { props } = partnerLogo(p, tier, STRIP_SCALE);
										return (
											<li class={`partners-item item-${tier}`}>
												{p.url ? (
													<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
														<Image class={`partners-logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
													</a>
												) : (
													<Image class={`partners-logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
												)}
											</li>
										);
									})}
								</ul>
							</div>
						))}
					</div>
				</div>
			</section>
		)}

		{/* NEWSLETTER — `anchor-target`: the ticket footnote, the footer and the FAQ jump here. */}
		{enabled('newsletter') && <section id="newsletter" class="band sec anchor-target" aria-labelledby="newsletter-title">
			<div class="band-inner newsletter">
				<div>
					<h2 id="newsletter-title" class="display newsletter-title">Newsletter</h2>
					<p class="newsletter-lede">We write when a wave opens or a speaker is confirmed. Nothing else.</p>
				</div>
				<div class="newsletter-form">
					<NewsletterForm client:visible />
				</div>
			</div>
		</section>}
	</main>
</BaseLayout>

<style lang="scss">
	@use './index';
</style>
