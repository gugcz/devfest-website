---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logo from '../assets/logo.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown';
import NewsletterForm from '../components/NewsletterForm';
import HeroBackground from '../components/HeroBackground.astro';
import Ticker from '../components/Ticker.astro';
import Tickets from '../components/Tickets';
import SpeakersTeaser from '../components/SpeakersTeaser';
import { getActivePartnerTiers } from '../lib/partners';
import { EVENT_TOPICS } from '../lib/ticker';
import { TOPICS } from '../lib/topics';

// Homepage "silver+" strip — one labelled row per tier, top tier first, so the
// ladder reads the same here as it does on /partners (row scale steps down with
// the tier via the `.tier-<id>` hook in index.scss).
const homeTiers = await getActivePartnerTiers();

// Partner logo masters live in `src/assets/partners/<tier>/` so the build can
// resize them; the `partners` collection still stores plain path strings, so glob
// the sources and key them by filename (same pattern as team.astro).
const logoSources = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/**/*', {
	eager: true,
});
const logoByFile = new Map<string, ImageMetadata>(
	Object.entries(logoSources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
const logoFor = (logo: string): ImageMetadata =>
	logoByFile.get(logo.split('/').pop() as string) as ImageMetadata;

// SVG wordmarks stay vector (`format="svg"` copies them through unchanged);
// rasters get a srcset sized for the widest strip cap (top tier, 330px) up to
// ~2× DPR — one list for every tier, the CSS cap does the per-tier scaling.
const STRIP_WIDTHS = [330, 495, 660];
const STRIP_SIZES = '330px';
const sizing = (img: ImageMetadata) =>
	img.format === 'svg'
		? ({ format: 'svg', layout: 'none' } as const)
		: ({ widths: STRIP_WIDTHS, sizes: STRIP_SIZES } as const);

// The facts band. Three figures, and deliberately NOT the date or the venue:
// both already sit in the hero's footing strip a screen above, in the header
// stamp, and in the footer. Repeating them here spent the band's whole budget
// restating what the visitor had just read.
//
// Both come from the partner deck, so the site and the deck quote the same
// event — neither is derivable from the repo, so they have to be kept in step
// with it by hand. Three tiles is the hard cap: a fourth pushes the row under
// the 320px-per-column floor and the labels start wrapping (see `.facts` in
// BaseLayout.scss).
//
// Labels are length-constrained. Uppercase mono at this tracking fits ~33
// characters on one line at 1280; past that a label breaks onto two and the row
// stops reading as a row. Check any new wording at 1280, not just at 1440.
// Two, not three. The middle slot had no fact strong enough to stand beside
// these: a bare tracks count is the smallest mark in the row and reads as a
// rank rather than a quantity, and everything else worth saying (side
// programme, community-run, inclusive) is a phrase, not a figure. Two tiles
// take half the row each, which is what lets the figures run at --fs-stat's
// top end.
const facts = [
	{ figure: '350+', label: 'Medior & senior developers, CEE' },
	{ figure: '11th', label: 'Edition. Based in Prague.' },
];

---

<BaseLayout description="DevFest.cz 2026 — Prague's developer conference & festival: AI agents, generative UI, cloud & backends, mobile & web accessibility, and the humans behind it. October 30, 2026. Tickets on sale now.">
	<!-- Preload the LCP hero background so it isn't discovered only after CSS parse -->
	<link
		slot="head"
		rel="preload"
		as="image"
		href="/hero-detective.webp"
		fetchpriority="high"
	/>

	<main class="page-stack">
		<!-- HERO -->
		<section id="hero" class="scene">
			<HeroBackground photoOpacity={0.85} mobilePhotoOpacity={0.55} mobileFocus="42% 88%" />
			<div class="scene-vignette" aria-hidden="true"></div>

			<div class="hero-inner">
				<h1 class="hero-title">
					<Image
						src={logo}
						alt=""
						class="hero-logo"
						priority
						widths={[280, 560, 620, 1240]}
						sizes="(max-width: 700px) 82vw, 560px"
					/>
					<span class="sr-only">DevFest.cz 2026 — Prague Developer Conference. AI agents, generative UI, cloud & backends, mobile & web accessibility. October 30, 2026.</span>
				</h1>

				<p class="hero-statement display">
					Prague&rsquo;s most original<br />conference is <span class="red">back.</span>
				</p>

				<!-- The topic set, set as the statement's own third and fourth
				     lines — same Bebas face, directly under it — rather than a
				     caption below the fold. Column flow (down the left column,
				     then the right) keeps 01 opening the set and 05 closing it. -->
				<div class="topics-tail">
					<p class="topics-tail-eyebrow">What we cover</p>
					<ul class="topics-tail-set">
						{TOPICS.map((t) => (
							<li class="topics-tail-row">{t.name}</li>
						))}
					</ul>
				</div>

				<div class="hero-actions">
					<a href="#tickets" class="btn-primary">Get tickets</a>
					<a href="#newsletter" class="btn-ghost">Stay in the loop</a>
				</div>
			</div>

			<!-- Full-bleed footing strip. The date, the venue and the clock are
			     data, so they sit on one line at the base of the frame instead of
			     taking a second column away from the statement. -->
			<div class="hero-foot">
				<dl class="hero-meta">
					<div class="meta-item">
						<dt class="meta-label">Date</dt>
						<dd class="meta-value">30. 10. 2026</dd>
					</div>
					<div class="meta-item">
						<dt class="meta-label">Place</dt>
						<dd class="meta-value">
							<a
								class="meta-value--link"
								href="https://maps.app.goo.gl/W5bcH4BgFQ1B8QAm8"
								target="_blank"
								rel="noopener noreferrer"
							>Uhelný Mlýn<span class="meta-sub">near Prague</span></a>
						</dd>
					</div>
				</dl>

				<div class="hero-clock" aria-label="Time until doors open">
					<p class="meta-label">Doors open in</p>
					{/*
						transition:persist keeps this island (and its 1s interval)
						alive across soft navigations instead of remounting it from
						the INITIAL_TIME placeholder. Persistence needs a matching
						persisted element on BOTH the outgoing and incoming page, and
						the countdown only exists here — so it helps on same-page
						client-side navigations (e.g. back/forward to `/`), not on
						`/` → `/team`, where the island is torn down as usual.
					*/}
					<Countdown compact client:load transition:persist />
				</div>
			</div>
		</section>

		<!-- TICKER -->
		<Ticker items={EVENT_TOPICS} />

		<!-- THE FACTS — what the event IS, in four figures instead of a paragraph -->
		<section id="facts" aria-labelledby="facts-title">
			<div class="u-container facts-inner reveal">
				<h2 id="facts-title" class="facts-head display">
					One day.<br />One <span class="red">mill.</span>
				</h2>

				<dl class="facts">
					{facts.map((f) => (
						<div class="fact">
							<dt class="fact-label">{f.label}</dt>
							<dd class="fact-figure" set:html={f.figure} />
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- TICKETS -->
		<Tickets client:visible />

		<!-- SPEAKERS TEASER — auto-rotating lineup spotlight; hides until data loads.
		     client:load (not visible): the island renders nothing until Firestore
		     resolves, so a client:visible observer would never fire on the
		     zero-height placeholder. -->
		<SpeakersTeaser client:load />

		<!-- CALL FOR SPEAKERS — hidden: CFP closed
		<section id="speakers" aria-labelledby="speakers-title">
			<div class="u-container speakers-inner reveal">
				<p class="eyebrow">Call for speakers</p>
				<h2 id="speakers-title" class="display" style="font-size: var(--fs-h2)">
					Wanted: <span class="red">your talk.</span>
				</h2>
				<p class="speakers-lede">
					Got a story worth telling? Make your case.
				</p>
				<div class="speakers-cta-group">
					<a
						href="https://sessionize.com/devfest-cz-2026"
						class="btn-primary"
						target="_blank"
						rel="noopener"
					>Submit a talk</a>
					<span class="speakers-tag">CFP open now</span>
				</div>
			</div>
		</section>
		-->

		<!-- PARTNERS — quiet silver+ strip, one row per tier; media partners live on /partners only -->
		{homeTiers.length > 0 && (
			<section id="partners" aria-labelledby="partners-title">
				<div class="partners-inner reveal">
					<p id="partners-title" class="eyebrow partners-eyebrow">Accomplices<span class="sr-only"> — partners</span></p>

					<div class="partners-tiers">
						{homeTiers.map((tier) => (
							<div class={`partners-tier tier-${tier.id}`}>
								<p class="partners-tier-label">{tier.label}</p>
								<ul class="partners-row">
									{tier.partners.map((p) => (
										<li class="partners-item">
											{p.url ? (
												<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
													<Image class={`partners-logo${p.plated ? ' is-plated' : ''}`} src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo))} />
												</a>
											) : (
												<Image class={`partners-logo${p.plated ? ' is-plated' : ''}`} src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo))} />
											)}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>

					<p class="partners-more">
						<a href="/partners">See all partners</a>
					</p>
				</div>
			</section>
		)}

		<!-- GALLERY — photos from past editions -->
		<section id="gallery" aria-labelledby="gallery-title">
			<div class="u-container head-split gallery-head reveal">
				<h2 id="gallery-title" class="display head-title">Look <span class="red">back.</span></h2>
				<p class="head-note">
					Past editions of DevFest.cz &mdash; and the community that makes them.
				</p>
			</div>

			<div class="gallery-marquee" aria-hidden="true">
				<div class="gallery-track">
					{Array.from({ length: 2 }).map(() => (
						<>
							{Array.from({ length: 22 }, (_, i) => {
								const n = String(i + 1).padStart(2, '0');
								return (
									<img
										src={`/gallery/devfest-2025-${n}.webp`}
										alt=""
										loading="lazy"
										decoding="async"
										width="1080"
										height="720"
									/>
								);
							})}
						</>
					))}
				</div>
			</div>
		</section>

		<!-- NEWSLETTER — the home page's one red field, matching the closing
		     statement every subpage ends on -->
		<section id="newsletter" class="band band--accent">
			<div class="band-inner newsletter-inner reveal">
				<div class="newsletter-head">
					<h2 class="newsletter-title display">Follow the<br /><span class="red">leads.</span></h2>
					<p class="newsletter-lede">
						Lineup drops, wave changes, and the odd thing we can&rsquo;t announce yet.
					</p>
				</div>
				<div class="newsletter-form">
					<NewsletterForm client:visible />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './index';
</style>

<script>
	// Bundled module scripts execute once per document, so with <ClientRouter />
	// this has to re-run per navigation. `astro:page-load` covers the initial
	// load as well, so it replaces (never supplements) DOMContentLoaded.
	document.addEventListener('astro:page-load', () => {
		const track = document.querySelector<HTMLElement>('.gallery-track');
		if (!track) return;
		const all = Array.from(track.children) as HTMLElement[];
		const unique = all.slice(0, all.length / 2);
		for (let i = unique.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[unique[i], unique[j]] = [unique[j], unique[i]];
		}
		const shuffled = [...unique, ...unique.map((n) => n.cloneNode(true) as HTMLElement)];
		track.replaceChildren(...shuffled);
	});
</script>
