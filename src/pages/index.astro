---
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown';
import NewsletterForm from '../components/NewsletterForm';
import Footer from '../components/Footer.astro';
import HeroBackground from '../components/HeroBackground.astro';
import Ticker from '../components/Ticker.astro';
// import Tickets from '../components/Tickets'; // TICKETS HIDDEN — restore when sale opens

const tickerTopics = [
	'AI & Machine Learning',
	'Android & Kotlin',
	'Web Technologies',
	'Cloud & DevOps',
	'Flutter & Dart',
	'Security',
	'Open Source',
];
---

<BaseLayout>
	<main class="page">
		<!-- HERO -->
		<section id="hero">
			<HeroBackground photoOpacity={0.85} mobilePhotoOpacity={0.55} />

			<div class="hero-grid">
				<div class="hero-content">
					<h1 class="hero-title">
						<img src="/logo.png" alt="DevFest.cz 2026" class="hero-logo" />
					</h1>

					<p class="hero-subtitle">
						The most original conference in Prague is here again—and it&rsquo;s not without a few mysteries.
					</p>

					<div class="hero-meta">
						<div class="meta-item">
							<span class="meta-label">Date</span>
							<span class="meta-value">30. 10. 2026</span>
						</div>
						<div class="meta-item">
							<span class="meta-label">Place</span>
							<span class="meta-value">Prague</span>
						</div>
						<div class="meta-item">
							<span class="meta-label">Format</span>
							<span class="meta-value">In-person</span>
						</div>
					</div>

					<div class="hero-cta-group">
						<a href="#newsletter" class="btn-primary">Notify me</a>
					</div>
				</div>

				<aside class="hero-countdown" aria-label="Time until doors open">
					<div class="section-label">Doors open in</div>
					<Countdown client:load />
				</aside>
			</div>
		</section>

		<!-- TICKER -->
		<Ticker items={tickerTopics} />

		<!-- TICKETS — hidden until sale opens. Restore by uncommenting:
		<Tickets client:visible />
		-->

		<!-- GALLERY — photos from past editions -->
		<section id="gallery" aria-labelledby="gallery-title">
			<div class="gallery-head">
				<div class="section-label">From the archives</div>
				<h2 id="gallery-title" class="section-title">Past <span class="red">DevFests</span></h2>
				<p class="gallery-lede">
					Cases closed, files reopened. A look back at the people who cracked them with us.
				</p>
			</div>

			<div class="gallery-marquee" aria-hidden="true">
				<div class="gallery-track">
					{Array.from({ length: 2 }).map(() => (
						<>
							<img src="/gallery/devfest-2025-01.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-02.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-03.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-04.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-05.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-06.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-07.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-08.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-09.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-10.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-11.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-12.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-13.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
							<img src="/gallery/devfest-2025-14.jpg" alt="" loading="lazy" decoding="async" width="800" height="533" />
						</>
					))}
				</div>
			</div>
		</section>

		<!-- NEWSLETTER -->
		<section id="newsletter">
			<div class="section-label">The case file</div>
			<h2 class="section-title">Be the first<br /><span class="red">to know.</span></h2>
			<p class="newsletter-lede">
				Doors open soon. Leave your email and we'll wire you the moment tickets drop.
			</p>
			<NewsletterForm client:visible />
		</section>
	</main>
	<Footer />
</BaseLayout>

<style lang="scss">
	.page {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	/* ===================== HERO ===================== */
	#hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
		padding: 0 3rem;
	}

	.hero-grid {
		position: relative;
		z-index: 10;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 6rem;
		align-items: center;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
	}

	.hero-content {
		max-width: 620px;
	}

	.hero-countdown {
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
		padding: 2rem 1.6rem 1.6rem;
		background: transparent;
		border: none;
		animation: fadeInUp 1s ease 0.7s both;

		.section-label {
			margin-bottom: 0.8rem;
			gap: 0.8rem;
			font-size: 0.78rem;

			&::after { flex: 0 0 32px; }
		}
	}

	.hero-title {
		animation: fadeInUp 1s ease 0.2s both;
		line-height: 0;
		filter: drop-shadow(0 8px 28px rgba(0, 0, 0, 0.9));
	}

	.hero-logo {
		width: clamp(280px, 56vw, 620px);
		max-width: 100%;
		height: auto;
		display: block;
	}

	.hero-subtitle {
		font-family: 'IM Fell English', serif;
		font-style: italic;
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		color: var(--color-grey);
		margin-top: 2rem;
		line-height: 1.7;
		max-width: 480px;
		border-left: 2px solid rgba(180, 50, 50, 0.45);
		padding-left: 1.4rem;
		text-wrap: balance;
		hyphens: auto;
		animation: fadeInUp 1s ease 0.4s both;
	}

	.hero-meta {
		margin-top: 3.2rem;
		display: flex;
		gap: 3.6rem;
		flex-wrap: wrap;
		animation: fadeInUp 1s ease 0.6s both;
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.meta-label {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.78rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--color-grey);
	}

	.meta-value {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 1.4rem;
		letter-spacing: 0.08em;
		color: var(--color-text);
	}

	.hero-cta-group {
		margin-top: 3.75rem;
		display: flex;
		gap: 1.5rem;
		align-items: center;
		flex-wrap: wrap;
		animation: fadeInUp 1s ease 0.8s both;
	}

	.btn-primary {
		display: inline-block;
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.9rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		background: #8B1818;
		color: #F5EBDC;
		border: 2px solid #8B1818;
		border-radius: 1px;
		padding: 1.05rem 2.6rem;
		text-decoration: none;
		position: relative;
		overflow: hidden;
		transform: rotate(-1.5deg);
		box-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
		transition: background 0.2s, transform 0.2s, box-shadow 0.2s;

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background-image: var(--noise-stamp);
			background-size: 80px 30px;
			mix-blend-mode: multiply;
			pointer-events: none;
		}

		&:hover {
			background: var(--color-accent-hot);
			transform: rotate(-1.5deg) translateY(-1px);
			box-shadow: 0 4px 14px rgba(204, 0, 0, 0.5), 0 2px 0 rgba(0, 0, 0, 0.25);
		}

		&:active {
			transform: rotate(-1.5deg) translateY(0);
		}

		&:focus-visible {
			outline: 3px solid #F5EBDC;
			outline-offset: 3px;
		}
	}

	/* ===================== GALLERY ===================== */
	#gallery {
		position: relative;
		padding: 8.5rem 0 8rem;
		background:
			linear-gradient(180deg, var(--color-bg) 0%, var(--color-near-black) 12%, var(--color-near-black) 88%, var(--color-bg) 100%);
		overflow: hidden;
		border-top: 1px solid rgba(204, 0, 0, 0.18);
		border-bottom: 1px solid rgba(204, 0, 0, 0.18);

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background:
				radial-gradient(ellipse 55% 70% at 85% 15%, rgba(204, 0, 0, 0.09) 0%, transparent 62%),
				radial-gradient(ellipse 45% 65% at 8% 92%, rgba(139, 24, 24, 0.08) 0%, transparent 60%);
			pointer-events: none;
			z-index: 0;
		}

		// faint horizontal "evidence rail" line behind photos
		&::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			top: 60%;
			height: 1px;
			background: linear-gradient(
				to right,
				transparent 0%,
				rgba(204, 0, 0, 0.22) 15%,
				rgba(232, 224, 204, 0.18) 50%,
				rgba(204, 0, 0, 0.22) 85%,
				transparent 100%
			);
			pointer-events: none;
			z-index: 1;
		}
	}

	.gallery-head {
		position: relative;
		z-index: 2;
		max-width: 1080px;
		margin: 0 auto 5rem;
		padding: 0 3rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.gallery-head .section-label {
		justify-content: center;
	}

	.gallery-head .section-title {
		margin-bottom: 1.6rem;
	}

	.gallery-lede {
		font-family: 'IM Fell English', serif;
		font-style: italic;
		font-size: 1.08rem;
		line-height: 1.7;
		color: var(--color-grey);
		max-width: 520px;
		margin: 0 auto;
	}

	.gallery-marquee {
		position: relative;
		z-index: 2;
		width: 100%;
		overflow: hidden;
		padding: 2.2rem 0;
		mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 8%,
			#000 92%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 8%,
			#000 92%,
			transparent 100%
		);

		&:hover .gallery-track,
		&:focus-within .gallery-track {
			animation-play-state: paused;
		}
	}

	.gallery-track {
		display: flex;
		gap: 2rem;
		width: max-content;
		animation: gallery-scroll 180s linear infinite;
		will-change: transform;
	}

	.gallery-track img {
		display: block;
		height: 320px;
		width: auto;
		max-width: none;
		object-fit: cover;
		padding: 0.55rem 0.55rem 1.4rem;
		background: linear-gradient(180deg, #1a1715 0%, #0f0d0c 100%);
		border: 1px solid rgba(232, 224, 204, 0.12);
		filter: grayscale(0.85) sepia(0.35) contrast(1.08) brightness(0.78) saturate(0.9);
		box-shadow:
			inset 0 0 60px rgba(0, 0, 0, 0.6),
			0 1px 0 rgba(232, 224, 204, 0.06),
			0 14px 28px rgba(0, 0, 0, 0.6),
			0 4px 0 rgba(0, 0, 0, 0.5),
			0 0 0 1px rgba(0, 0, 0, 0.4);
		transition: filter 0.6s ease, box-shadow 0.5s ease;

		&:hover,
		&:focus-visible {
			filter: grayscale(0) sepia(0) contrast(1.05) brightness(1) saturate(1);
			box-shadow:
				inset 0 0 60px rgba(0, 0, 0, 0),
				0 1px 0 rgba(232, 224, 204, 0.18),
				0 16px 32px rgba(0, 0, 0, 0.65),
				0 4px 0 rgba(0, 0, 0, 0.5),
				0 0 0 1px rgba(204, 0, 0, 0.35),
				0 0 18px rgba(204, 0, 0, 0.25);
		}
	}

	@keyframes gallery-scroll {
		from { transform: translateX(0); }
		to   { transform: translateX(-50%); }
	}

	/* ===================== SHARED SECTION ===================== */
	#countdown-section,
	#newsletter {
		padding: 8rem 3rem;
		position: relative;
		max-width: 1080px;
		margin: 0 auto;
		width: 100%;
	}

	#newsletter {
		background: var(--color-near-black);
		max-width: none;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	#newsletter > * {
		max-width: 560px;
		width: 100%;
	}

	#newsletter .section-label {
		justify-content: center;
	}

	#newsletter .newsletter-lede {
		margin-left: auto;
		margin-right: auto;
	}

	.section-label {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.8rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(240, 237, 230, 0.7);
		display: flex;
		align-items: center;
		gap: 1.2rem;
		margin-bottom: 2.6rem;

		&::after {
			content: '';
			flex: 0 0 60px;
			height: 1px;
			background: rgba(204, 0, 0, 0.45);
		}
	}

	.section-title {
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		line-height: 0.92;
		letter-spacing: 0.02em;
		color: var(--color-text);
		margin-bottom: 3rem;

		.red { color: var(--color-accent-hot); }
	}

	.newsletter-lede {
		font-family: 'IM Fell English', serif;
		font-style: italic;
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--color-grey);
		max-width: 520px;
		margin-bottom: 2.6rem;
	}

	/* ===================== RESPONSIVE ===================== */
	@media (max-width: 1240px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 4rem;
			justify-items: center;
		}
		.hero-content {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			max-width: 620px;
		}
		.hero-subtitle {
			text-align: center;
			max-width: 30ch;
		}
		.hero-meta {
			justify-content: center;
		}
		.hero-cta-group {
			justify-content: center;
		}
		.hero-countdown {
			justify-self: center;
			align-items: center;
		}
		.hero-countdown .section-label {
			justify-content: center;
		}
		#newsletter {
			text-align: center;
		}
		#newsletter .section-label {
			justify-content: center;
		}
		.newsletter-lede {
			margin-left: auto;
			margin-right: auto;
		}
	}

	@media (max-width: 900px) {
		#hero { padding: 7rem 1.5rem 5rem; min-height: auto; }
		.hero-meta { gap: 2.2rem; }
		.hero-countdown { padding: 1.6rem 1.2rem 1.4rem; }
		#newsletter { padding: 6.5rem 1.5rem; }
		#gallery { padding: 6.5rem 0 6rem; }
		.gallery-head { padding: 0 1.5rem; margin-bottom: 3.5rem; }
		.gallery-marquee { padding: 1.8rem 0; }
		.gallery-track { gap: 1.4rem; }
		.gallery-track img { height: 240px; padding: 0.45rem 0.45rem 1.2rem; }
	}

	@media (max-width: 600px) {
		#hero { padding: 6rem 1.1rem 4rem; }
		#gallery { padding: 5rem 0 5rem; }
		.gallery-head { padding: 0 1.1rem; margin-bottom: 2.8rem; }
		.gallery-marquee { padding: 1.4rem 0; }
		.gallery-track { gap: 1.1rem; }
		.gallery-track img { height: 190px; padding: 0.4rem 0.4rem 1rem; }
		.gallery-lede { font-size: 0.98rem; }
		.hero-content { gap: 1.5rem; }
		.hero-subtitle {
			font-size: 1rem;
			padding-left: 1.1rem;
			max-width: 28ch;
			line-height: 1.65;
		}
		.hero-meta { gap: 1.6rem; }
		.meta-value { font-size: 1.2rem; }
		.hero-countdown { padding: 1.4rem 0.6rem 1rem; align-self: stretch; }
		.hero-cta-group { gap: 1rem; margin-top: 2.6rem; }
		.btn-primary { padding: 0.9rem 1.8rem; font-size: 0.85rem; }
		.section-label::after { flex-basis: 32px; }
		#newsletter { padding: 5rem 1.1rem; }
	}

	@media (max-width: 380px) {
		#hero { padding: 5.5rem 0.85rem 3.5rem; }
		.hero-subtitle { padding-left: 0.9rem; }
		.hero-countdown { padding: 1.2rem 0.4rem 0.9rem; }
		.btn-primary { padding: 0.85rem 1.4rem; font-size: 0.82rem; letter-spacing: 0.18em; }
		#newsletter { padding: 4.5rem 0.85rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title,
		.hero-subtitle,
		.hero-meta,
		.hero-cta-group,
		.hero-countdown,
		.gallery-track { animation: none; }

		.gallery-marquee {
			overflow-x: auto;
		}
	}
</style>
