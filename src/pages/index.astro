---
/**
 * The home page of the edition in `src/site.config.ts` (ADR 0011). The stage
 * is the DF27 comp: the painting, the logo, the season (or the day once it
 * is announced), the tagline and two portals. Below it, on the veil: what
 * DevFest.cz is and what is announced, the sections the flags have on
 * (tickets, speakers, partners, the app), the last edition in figures, and
 * the newsletter. Nothing about the edition is stated beyond the config.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AetherCanvas from '../components/aether/AetherCanvas.astro';
import SeasonMark from '../components/aether/SeasonMark.astro';
import Portal from '../components/aether/Portal.astro';
import NewsletterForm from '../components/NewsletterForm';
import Countdown from '../components/Countdown';
import HeroOffer from '../components/HeroOffer';
import Tickets from '../components/Tickets';
import SpeakersTeaser from '../components/SpeakersTeaser';
import TicketIndex from '../components/TicketIndex.astro';
import StoreBadges from '../components/StoreBadges.astro';
import {
	getActivePartnerTiers,
	getCommunityPartners,
	getTravelPartners,
	partnerLogo,
	type Partner,
} from '../lib/partners';
import { EVENT, eventDate, hasDate, hasVenue } from '../lib/event';
import { lastEdition } from '../lib/editions';
import { staticTicketLines } from '../lib/tickets-static';
import config from '../site.config';
import { enabled, ticketsHref } from '../lib/flags';

const { event, organizer } = config;
const last = lastEdition();

// The stage's two portals: the page's one solid action (the sale while it
// is on, else the newsletter) and the last edition's archive.
const primary = ticketsHref
	? { href: '#tickets', label: 'Get tickets' }
	: enabled('newsletter')
		? { href: '#newsletter', label: 'Hear it first' }
		: null;

// One row per tier, top tier first; silver and community share a row, travel
// gets the last one. Media partners live on /partners only.
const communityPartners = await getCommunityPartners();
const travelPartners = await getTravelPartners();
const ladder = await getActivePartnerTiers();
type HomeRow = { id: string; label: string; partners: { p: Partner; tier: string }[] };
const tail = [
	...(ladder.find((t) => t.id === 'silver')?.partners.map((p) => ({ p, tier: 'silver' })) ?? []),
	...communityPartners.map((p) => ({ p, tier: 'community' })),
];
const homeRows: HomeRow[] = [
	...ladder
		.filter((t) => t.id !== 'silver')
		.map((t) => ({ id: t.id, label: t.label, partners: t.partners.map((p) => ({ p, tier: t.id })) })),
	{
		id: 'silver',
		label: ladder.some((t) => t.id === 'silver') ? 'Silver and community' : 'Community',
		partners: tail,
	},
	{ id: 'travel', label: 'Travel', partners: travelPartners.map((p) => ({ p, tier: 'travel' })) },
].filter((row) => row.partners.length > 0);
// The prices as of the build, for readers that run no script.
const ticketLines = enabled('tickets') ? await staticTicketLines() : [];

// Frames from past editions' contact sheets (`public/gallery/`).
const PRINTS = [
	{ n: '01', alt: 'A full hall facing the stage at a past DevFest.cz' },
	{ n: '03', alt: 'A speaker in an orange T-shirt raises a hand on stage' },
	{ n: '08', alt: 'The audience laughing during a talk' },
	{ n: '20', alt: 'Attendees laughing over their laptops at a long table' },
] as const;
---

<BaseLayout title={`${EVENT.name} — ${event.tagline}, ${hasDate ? EVENT.dateLabel : event.season.toLowerCase()}`}>
	<link slot="head" rel="preload" as="image" href="/df27-logo.svg" fetchpriority="high" />
	<AetherCanvas />

	<main class="home">
		<section class="stage" aria-labelledby="home-title">
			<h1 id="home-title" class="logo rise" data-aether-anchor>
				<img src="/df27-logo.svg" alt={EVENT.name} width="2880" height="280" fetchpriority="high" />
			</h1>
			{hasDate
				? <p class="stage-date rise rise-2"><time datetime={eventDate('iso')}>{EVENT.dateLabel}</time>{hasVenue && <> · {EVENT.venue}, {EVENT.city}</>}</p>
				: <SeasonMark season={event.season} class="rise rise-2" />}
			<p class="stage-line rise rise-3">{event.tagline}</p>
			{hasDate && <div class="stage-count rise rise-3"><Countdown client:load /></div>}
			{ticketsHref && <div class="stage-offer rise rise-3"><HeroOffer client:load /></div>}
			<div class="stage-actions rise rise-4">
				{primary && <Portal href={primary.href} label={primary.label} variant="solid" />}
				{last && <Portal href={last.href} label={`${last.year} Edition`} reload />}
			</div>
		</section>

		<div class="veil">
			<section class="band" aria-labelledby="about-title">
				<h2 id="about-title" class="rubric">The festival</h2>
				<p class="lead">
					{event.name} is a {event.tagline.toLowerCase()} in {event.city}: talks and workshops in English, run by
					the developer community around {organizer.name} since 2012.
				</p>
				<dl class="facts">
					<div>
						<dt>When</dt>
						<dd>
							{hasDate ? <time datetime={eventDate('iso')}>{EVENT.dateLabel}</time> : event.season}
							{!hasDate && <span class="facts-note">date to be announced</span>}
						</dd>
					</div>
					<div>
						<dt>Where</dt>
						<dd>
							{hasVenue ? <a href={EVENT.mapUrl} target="_blank" rel="noopener noreferrer">{EVENT.venue}</a> : event.city}
							<span class="facts-note">{hasVenue ? EVENT.city : 'venue to be announced'}</span>
						</dd>
					</div>
					<div>
						<dt>Language</dt>
						<dd>English</dd>
					</div>
				</dl>
			</section>

			{/* TICKETS — client:load: the stage's "Get tickets" jumps straight here. */}
			{enabled('tickets') && <Tickets client:load />}
			{ticketLines.length > 0 && <TicketIndex lines={ticketLines} />}

			{/* SPEAKERS — the register's first lines; hides until data loads. */}
			{enabled('lineup') && <SpeakersTeaser client:load />}

			{
				last && (
					<section class="band" aria-labelledby="last-title">
						<h2 id="last-title" class="rubric">{last.year} in figures</h2>
						<dl class="figures">
							{last.audience && (
								<div>
									<dt>developers</dt>
									<dd>{last.audience}</dd>
								</div>
							)}
							<div>
								<dt>talks</dt>
								<dd>{last.talks}</dd>
							</div>
							<div>
								<dt>speakers</dt>
								<dd>{last.speakers}</dd>
							</div>
						</dl>
						<ul class="prints" role="list" aria-label="Photographs from past editions">
							{PRINTS.map(({ n, alt }) => (
								<li class="print">
									<img src={`/gallery/devfest-2025-${n}.webp`} {alt} loading="lazy" decoding="async" width="1080" height="720" />
								</li>
							))}
						</ul>
						<p class="band-link">
							<a href={last.href} data-astro-reload>The {last.year} programme and speakers</a>
						</p>
					</section>
				)
			}

			{/* PARTNERS — one label per tier; each mark's box comes from its tier
			     (`partnerLogo()`), so the size carries the rank. */}
			{enabled('partners') && homeRows.length > 0 && (
				<section class="band band-wide" aria-labelledby="partners-title">
					<h2 id="partners-title" class="rubric">Partners</h2>
					<div class="partners-tiers">
						{homeRows.map((row) => (
							<div class={`partners-tier tier-${row.id}`}>
								<h3 class="partners-label" id={`tier-${row.id}-label`}>{row.label}</h3>
								<ul class="partners-row" aria-labelledby={`tier-${row.id}-label`}>
									{row.partners.map(({ p, tier }) => {
										const { props } = partnerLogo(p, tier, 1);
										return (
											<li class={`partners-item item-${tier}`}>
												{p.url ? (
													<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
														<Image class={`partners-logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
													</a>
												) : (
													<Image class={`partners-logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
												)}
											</li>
										);
									})}
								</ul>
							</div>
						))}
					</div>
					<p class="band-link partners-links">
						<a href="/partners">All partners</a>
						<a href="/partners#partners-cta-title">Become a partner</a>
					</p>
				</section>
			)}

			{/* THE APP — the same badges as /app. */}
			{enabled('app') && (
				<section class="band" aria-labelledby="home-app-title">
					<h2 id="home-app-title" class="rubric">The app</h2>
					<p class="lead lead-short">The programme, the talks and the speakers, on your phone.</p>
					<StoreBadges />
					<p class="band-link"><a href="/app">What’s in the app</a></p>
				</section>
			)}

			{/* NEWSLETTER — `anchor-target`: the stage and the FAQ jump here. */}
			{
				enabled('newsletter') && (
					<section class="band anchor-target" id="newsletter" aria-labelledby="newsletter-title">
						<h2 id="newsletter-title" class="rubric">Hear it first</h2>
						<p class="lead lead-short">
							{hasDate ? `News of ${EVENT.name} as it happens, and a few emails a year after that.` : `One email when ${EVENT.name} has a date, and a few a year after that.`}
						</p>
						<NewsletterForm client:visible />
					</section>
				)
			}
		</div>
	</main>
</BaseLayout>

<style lang="scss">
	@use './index';
</style>
