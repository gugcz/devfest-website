---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import Ticker from '../../components/Ticker.astro';
import Closer from '../../components/Closer.astro';
import { listPressKit } from '../../lib/press-kit';
import { EVENT_TOPICS } from '../../lib/ticker';

// Downloads are read from public/press-kit/ at build time — drop a file in
// that folder and it shows up here automatically (label, type and size are
// derived per entry; the preview tile is chosen from the mark's own pixels).
const pressKit = await listPressKit();

// The sheet is RULED, so a short last row is a hole in the ruling rather than a
// little extra air: at three and four columns ten assets left one or two cells
// of the bottom row unbordered, and the grid only resolved at the one width
// where the count happened to divide. The column counts are fixed per
// breakpoint below (they were `auto-fill`, so nothing here could know them),
// which lets the page work out at build time how many blank cells each count
// needs and emit exactly those — the sheet always closes on a full row.
const KIT_COLS = [2, 3, 4];
const fillersFor = (cols: number) => (cols - (pressKit.length % cols)) % cols;
const fillers = Array.from(
	{ length: Math.max(0, ...KIT_COLS.map(fillersFor)) },
	(_, i) => KIT_COLS.filter((cols) => i < fillersFor(cols)),
);
---

<BaseLayout
	title="Press kit — DevFest.cz 2026"
	description="Download the DevFest.cz 2026 press kit — official logos, wordmarks, and vector source files for media use."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Logos &amp; <span class="red">assets.</span>'}
			lede="Official DevFest.cz 2026 logos and wordmarks. Please keep the logo intact, give it room to breathe, and don't recolour it. Missing a format? Email the press desk."
			seoHeading="DevFest.cz 2026 Press Kit & Brand Assets"
			titleId="downloads-title"
			photo={false}
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band band--lit press-body" aria-label="Press kit downloads">
			<div class="band-inner">
				<a class="back-link" href="/press">&larr; Back to press</a>

				{pressKit.length > 0 ? (
					<>
					<div class="section-head">
						<p class="section-label">
							Asset library
							<span class="section-no">{String(pressKit.length).padStart(2, '0')}</span>
						</p>
						<h2 class="section-title">Download <span class="red">files.</span></h2>
					</div>
					<ul class="presskit-grid reveal">
						{pressKit.map((a) => (
							<li class="kit-item">
								<a class="kit-link" href={a.href} download>
									<span class={`kit-preview${a.darkPreview ? ' kit-preview--dark' : ''}`}>
										{a.isImage ? (
											<img src={a.href} alt="" loading="lazy" decoding="async" />
										) : (
											<span class="kit-badge">{a.ext}</span>
										)}
									</span>
									<span class="kit-meta">
										<span class="kit-meta-text">
											<span class="kit-label">{a.label}</span>
											<span class="kit-spec">{a.ext} &middot; {a.sizeLabel}</span>
										</span>
										<span class="kit-dl" aria-hidden="true">&darr;</span>
									</span>
								</a>
							</li>
						))}
						{fillers.map((cols) => (
							<li
								class={`kit-item kit-filler ${cols.map((c) => `kit-filler--c${c}`).join(' ')}`}
								aria-hidden="true"
							/>
						))}
					</ul>
					</>
				) : (
					<div class="empty-state" role="status">
						<span class="empty-stamp" aria-hidden="true">Coming soon</span>
						<p class="empty-line">
							The press kit is being prepared. In the meantime, email the press desk at
							<a class="inline-link" href="mailto:devfest@gug.cz">devfest@gug.cz</a>.
						</p>
					</div>
				)}
			</div>
		</section>

		<Closer
			eyebrow="Missing something"
			titleHtml={'Ask the<br /><span class="red">press desk</span>.'}
			note="Need a format we have not published, or a quote for a story? Write to us."
			tone="accent"
			titleId="downloads-closer"
			actions={[{ href: 'mailto:devfest@gug.cz', label: 'Email the desk' }, { href: '/press', label: 'Back to press', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './downloads';
</style>
