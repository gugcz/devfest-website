---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import { listPressKit } from '../../lib/press-kit';

// Downloads are read from public/press-kit/ at build time — drop a file in
// that folder and it shows up here automatically (label, type and size are
// derived per entry; the preview tile is chosen from the mark's own pixels).
const pressKit = await listPressKit();
---

<BaseLayout
	title="Press kit — DevFest.cz 2026"
	description="Download the DevFest.cz 2026 press kit — official logos, wordmarks, and vector source files for media use."
>
	<main class="downloads-page">
		<SubpageHero
			label="The press kit"
			titleHtml={'Take the<br /><span class="red">evidence.</span>'}
			lede="Official DevFest.cz 2026 logos and wordmarks. Keep the red dot intact, give the mark room to breathe, and don't recolour it. Missing a format? Wire the press desk."
			titleId="downloads-title"
		/>

		<section class="press-body" aria-label="Press kit downloads">
			<div class="press-inner">
				<a class="back-link" href="/press">&larr; Back to the press room</a>

				{pressKit.length > 0 ? (
					<ul class="presskit-grid">
						{pressKit.map((a) => (
							<li class="kit-item">
								<a class="kit-link" href={a.href} download>
									<span class={`kit-preview${a.darkPreview ? ' kit-preview--dark' : ''}`}>
										{a.isImage ? (
											<img src={a.href} alt="" loading="lazy" decoding="async" />
										) : (
											<span class="kit-badge">{a.ext}</span>
										)}
									</span>
									<span class="kit-meta">
										<span class="kit-meta-text">
											<span class="kit-label">{a.label}</span>
											<span class="kit-spec">{a.ext} &middot; {a.sizeLabel}</span>
										</span>
										<span class="kit-dl" aria-hidden="true">&darr;</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="empty-state" role="status">
						<span class="empty-stamp" aria-hidden="true">Locked up</span>
						<p class="empty-line">
							The kit is being packaged. In the meantime, wire the press desk at
							<a class="inline-link" href="mailto:devfest@gug.cz">devfest@gug.cz</a>.
						</p>
					</div>
				)}
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style lang="scss">
	.downloads-page {
		display: flex;
		flex-direction: column;
	}

	/* ===================== BODY ===================== */
	.press-body {
		position: relative;
		padding: 6rem 3rem 8rem;
		background: var(--color-bg);

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background: radial-gradient(ellipse 50% 60% at 88% 12%, rgba(204, 0, 0, 0.05) 0%, transparent 60%);
			pointer-events: none;
			z-index: 0;
		}
	}

	.press-inner {
		position: relative;
		z-index: 1;
		max-width: 1080px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 2.6rem;
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgba(240, 237, 230, 0.65);
		text-decoration: none;
		border-bottom: 1px dashed rgba(204, 0, 0, 0.5);
		padding-bottom: 2px;
		transition: color 0.2s, border-color 0.2s;

		&:hover,
		&:focus-visible {
			color: var(--color-accent-hot);
			border-color: var(--color-accent-hot);
			outline: none;
		}
	}

	/* ===================== GRID ===================== */
	.presskit-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
		gap: 1.1rem;
	}

	.kit-link {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--color-near-black);
		border: 1px solid rgba(240, 237, 230, 0.08);
		border-left: 2px solid rgba(204, 0, 0, 0.5);
		text-decoration: none;
		transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;

		&:hover,
		&:focus-visible {
			border-color: rgba(204, 0, 0, 0.45);
			transform: translateY(-2px);
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
			outline: none;

			.kit-label { color: var(--color-accent-hot); }
			.kit-dl { color: var(--color-accent-hot); transform: translateY(2px); }
		}
	}

	.kit-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 92px;
		border-bottom: 1px solid rgba(240, 237, 230, 0.08);
		background-color: #d8d4cc;
		background-image:
			linear-gradient(45deg, rgba(0, 0, 0, 0.1) 25%, transparent 25%),
			linear-gradient(-45deg, rgba(0, 0, 0, 0.1) 25%, transparent 25%),
			linear-gradient(45deg, transparent 75%, rgba(0, 0, 0, 0.1) 75%),
			linear-gradient(-45deg, transparent 75%, rgba(0, 0, 0, 0.1) 75%);
		background-size: 14px 14px;
		background-position: 0 0, 0 7px, 7px -7px, -7px 0;

		img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
			padding: 14px 22px;
			display: block;
		}
	}

	/* White / light marks + source files read better on a dark tile. */
	.kit-preview--dark {
		background: #0d0d0d;
		background-image: none;
	}

	.kit-badge {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: rgba(240, 237, 230, 0.85);
		padding: 0.3rem 0.6rem;
		border: 1px solid rgba(240, 237, 230, 0.25);
		border-radius: 1px;
	}

	.kit-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 0.7rem 0.85rem;
	}

	.kit-meta-text {
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
		min-width: 0;
	}

	.kit-label {
		font-family: 'IM Fell English', serif;
		font-size: 0.98rem;
		line-height: 1.25;
		color: var(--color-text);
		transition: color 0.2s;
	}

	.kit-spec {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.58rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(240, 237, 230, 0.55);
	}

	.kit-dl {
		flex-shrink: 0;
		font-size: 1rem;
		color: rgba(240, 237, 230, 0.55);
		transition: color 0.2s, transform 0.2s;
	}

	/* ===================== EMPTY STATE ===================== */
	.empty-state {
		position: relative;
		border: 1px dashed rgba(240, 237, 230, 0.18);
		background: rgba(255, 255, 255, 0.015);
		padding: 2.6rem 2.2rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.1rem;
	}

	.empty-stamp {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.6rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: #f5ebdc;
		padding: 0.3rem 0.7rem;
		background: rgba(204, 0, 0, 0.7);
		border: 1px solid rgba(0, 0, 0, 0.35);
		border-radius: 1px;
		transform: rotate(-2deg);
	}

	.empty-line {
		font-family: 'IM Fell English', serif;
		font-style: italic;
		font-size: 1.02rem;
		line-height: 1.6;
		color: var(--color-grey);
		max-width: 56ch;
		margin: 0;
	}

	.inline-link {
		color: var(--color-text);
		text-decoration: none;
		border-bottom: 1px dashed rgba(204, 0, 0, 0.5);

		&:hover,
		&:focus-visible {
			color: var(--color-accent-hot);
			border-color: var(--color-accent-hot);
			outline: none;
		}
	}

	/* ===================== RESPONSIVE ===================== */
	@media (max-width: 900px) {
		.press-body { padding: 5rem 1.5rem 6.5rem; }
	}

	@media (max-width: 600px) {
		.press-body { padding: 4rem 1.1rem 5.5rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.kit-link,
		.kit-dl { transition: none; }
	}
</style>
