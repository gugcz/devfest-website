---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import EndLine from '../../components/EndLine.astro';
import { listPressKit } from '../../lib/press-kit';

// Downloads are read from public/press-kit/ at build time — drop a file in
// that folder and it shows up here automatically (label, type and size are
// derived per entry; the preview tile is chosen from the mark's own pixels).
const pressKit = await listPressKit();

type Asset = (typeof pressKit)[number];

// One entry per logo variant, its formats as links: `df26_logo_dark.svg`,
// `DF26_logo_dark.png` and `df26_logo_dark.ai` are one mark in three files.
// A group with no previewable file (the brand manual) is a document instead.
const baseName = (file: string) => file.replace(/\.[^.]+$/, '').toLowerCase();
const groups = new Map<string, Asset[]>();
for (const asset of pressKit) {
	const key = baseName(asset.file);
	groups.set(key, [...(groups.get(key) ?? []), asset]);
}

// The listing is sorted vector-first, so a group's first image is its SVG.
const variants = [...groups.values()]
	.filter((files) => files.some((f) => f.isImage))
	.map((files) => {
		const preview = files.find((f) => f.isImage) as Asset;
		return { label: preview.label, preview, files };
	});
const documents = [...groups.values()].filter((files) => !files.some((f) => f.isImage)).flat();
---

<BaseLayout
	title="Press kit — DevFest.cz 2026"
	description="Download the DevFest.cz 2026 press kit — official logos, vector source files and the brand manual for media use."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Logos &amp; assets'}
			lede="Official DevFest.cz 2026 logos and the brand manual. Please keep the logo intact, keep clear space around it, and don't recolour it. Missing a format? Email the press desk."
			seoHeading="DevFest.cz 2026 Press Kit & Brand Assets"
			titleId="downloads-title"
		/>

		<section class="band band--lit press-body" aria-label="Press kit downloads">
			<div class="band-inner">
				<a class="action back-link" href="/contact#press">Back to In the news</a>

				{pressKit.length > 0 ? (
					<>
					{/* The hero already says "Logos & assets"; screen readers keep a
					    section head, the eye does not need a second poster. */}
					<h2 class="sr-only">Download files</h2>
					<ul class="kit-grid" role="list">
						{variants.map(({ label, preview, files }) => (
							<li class="kit-item">
								<h3 class="kit-label">{label}</h3>
								<div class="paper kit-print">
									<span class:list={['kit-preview', { 'kit-preview--dark': preview.darkPreview }]}>
										<img src={preview.href} alt="" loading="lazy" decoding="async" />
									</span>
								</div>
								<ul class="kit-formats" role="list">
									{files.map((f) => (
										<li>
											<a class="kit-format" href={f.href} download>
												<span class="sr-only">{label}, </span>
												{f.ext}
												<span class="kit-format-size">{f.sizeLabel}</span>
											</a>
										</li>
									))}
								</ul>
							</li>
						))}
					</ul>

					{/* The brand manual has no preview: the band's one red fill,
					    its format and size on the button like /contact. */}
					{documents.length > 0 && (
						<ul class="kit-docs" role="list">
							{documents.map((d, i) => (
								<li>
									<a class={i === 0 ? 'btn-primary kit-doc' : 'action kit-doc'} href={d.href} download>
										{d.label}<span class="kit-doc-size">{d.ext} {d.sizeLabel}</span>
									</a>
								</li>
							))}
						</ul>
					)}
					</>
				) : (
					<div class="empty-state" role="status">
						<span class="empty-stamp" aria-hidden="true">Coming soon</span>
						<p class="empty-line">
							The press kit is being prepared. In the meantime, email the press desk at
							<a class="inline-link" href="mailto:devfest@gug.cz">devfest@gug.cz</a>.
						</p>
					</div>
				)}

				<EndLine text="Need a format we have not published?" href="mailto:devfest@gug.cz" label="Write to us" />
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './downloads';
</style>
