---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import Closer from '../../components/Closer.astro';
import { listPressKit } from '../../lib/press-kit';

// Downloads are read from public/press-kit/ at build time — drop a file in
// that folder and it shows up here automatically (label, type and size are
// derived per entry; the preview tile is chosen from the mark's own pixels).
const pressKit = await listPressKit();

// The sheet is RULED, so a short last row is a hole in the ruling. Column
// counts are fixed per breakpoint so the page can emit exactly the blank
// cells each count needs and always close on a full row.
const KIT_COLS = [2, 3, 4];
const fillersFor = (cols: number) => (cols - (pressKit.length % cols)) % cols;
const fillers = Array.from(
	{ length: Math.max(0, ...KIT_COLS.map(fillersFor)) },
	(_, i) => KIT_COLS.filter((cols) => i < fillersFor(cols)),
);
---

<BaseLayout
	title="Press kit — DevFest.cz 2026"
	description="Download the DevFest.cz 2026 press kit — official logos, vector source files and the brand manual for media use."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Logos &amp; <span class="red">assets.</span>'}
			lede="Official DevFest.cz 2026 logos and the brand manual. Please keep the logo intact, give it room to breathe, and don't recolour it. Missing a format? Email the press desk."
			seoHeading="DevFest.cz 2026 Press Kit & Brand Assets"
			titleId="downloads-title"
			photo={false}
		/>

		<section class="band band--lit press-body" aria-label="Press kit downloads">
			<div class="band-inner">
				<a class="back-link" href="/contact#press">&larr; Back to press</a>

				{pressKit.length > 0 ? (
					<>
					{/* The hero already says "Logos & assets"; a second poster head
					    ("Download files.") under a ruled, numbered label said it
					    again. Screen readers keep the section head. */}
					<h2 class="sr-only">Download files</h2>
					<ul class="presskit-grid">
						{pressKit.map((a) => (
							<li class="kit-item">
								<a class="kit-link" href={a.href} download>
									<span class={`kit-preview${a.darkPreview ? ' kit-preview--dark' : ''}`}>
										{a.isImage ? (
											<img src={a.href} alt="" loading="lazy" decoding="async" />
										) : (
											<span class="kit-badge">{a.ext}</span>
										)}
									</span>
									<span class="kit-meta">
										<span class="kit-meta-text">
											<span class="kit-label">{a.label}</span>
											<span class="kit-spec">{a.ext} &middot; {a.sizeLabel}</span>
										</span>
										<span class="kit-dl" aria-hidden="true">&darr;</span>
									</span>
								</a>
							</li>
						))}
						{fillers.map((cols) => (
							<li
								class={`kit-item kit-filler ${cols.map((c) => `kit-filler--c${c}`).join(' ')}`}
								aria-hidden="true"
							/>
						))}
					</ul>
					</>
				) : (
					<div class="empty-state" role="status">
						<span class="empty-stamp" aria-hidden="true">Coming soon</span>
						<p class="empty-line">
							The press kit is being prepared. In the meantime, email the press desk at
							<a class="inline-link" href="mailto:devfest@gug.cz">devfest@gug.cz</a>.
						</p>
					</div>
				)}
			</div>
		</section>

		<Closer
			titleHtml={'Ask the<br />press desk.'}
			note="Need a format we have not published, or a quote for a story? Write to us."
			tone="accent"
			titleId="downloads-closer"
			actions={[{ href: 'mailto:devfest@gug.cz', label: 'Email the desk' }, { href: '/contact#press', label: 'Back to press', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './downloads';
</style>
