---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Closer from '../components/Closer.astro';
import Agenda from '../components/Agenda.tsx';
import Sessions from '../components/Sessions.tsx';
import TalkIndex from '../components/TalkIndex.astro';
import { staticLineup } from '../lib/lineup-static';
import { EVENT, eventDate } from '../lib/event';
import config from '../site.config';
import { ticketsHref } from '../lib/flags';

// ONE PAGE FOR THE PROGRAMME. The timetable answers "when and where", the
// list under it "what is it about" — search, filters and every abstract. They
// were two menu lines (`Sessions`, `Agenda`) for one question; `/sessions`
// now redirects to `#talks` here, query string and all.
const { sessions, rooms } = await staticLineup();
---

<BaseLayout
	title={`Agenda & talks — ${EVENT.name}`}
	description={`The full agenda for ${EVENT.name} — registration from 08:00, keynote at 09:00, two stages of talks, lightning talks and the afterparty. Every talk, room and time slot, plus a searchable list of every talk at Prague's community developer conference.`}
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Agenda'}
			lede="Every talk as the day ran, by room and time, with the full list and abstracts below."
			link={{ href: '#talks', label: 'Browse all talks' }}
			seoHeading={`${EVENT.name} Agenda, Schedule & Sessions`}
			titleId="agenda-title"
		/>

		<section class="band band--lit agenda-sheet" aria-label="Conference timetable">
			<div class="band-inner">
				{/* The hero names this band; its head is for screen readers only. */}
				<h2 class="sr-only">Timetable</h2>

				{/* The timetable hydrates client-side from /api/lineup. Readers that run
				   no script get every talk as of the build, under the list below. */}
				<Agenda client:load />

				{sessions.length === 0 && (
					<noscript>
						<p class="fallback-note">
							The agenda loads with JavaScript enabled. Please turn it on, or check back soon.
						</p>
					</noscript>
				)}
			</div>
		</section>

		<section id="talks" class="band band--lit agenda-talks" aria-labelledby="talks-title">
			<div class="band-inner">
				<div class="head-rule">
					<h2 id="talks-title" class="head-rule-title">Every talk</h2>
					<p class="head-rule-note">Search, or filter by track. Pick one for its abstract and speakers.</p>
				</div>

				{/* Hydrates from the same /api/lineup read as the timetable. */}
				<Sessions client:load />
				{sessions.length > 0 && <TalkIndex sessions={sessions} rooms={rooms} noun="talks" />}
			</div>
		</section>

		<Closer
			titleHtml={`That was<br />${eventDate('dayMonth')}.`}
			note={`${EVENT.venue}, ${config.event.venue.city}. The 2026 edition is over; the programme stays up for the record.`}
			titleId="agenda-closer"
			actions={[...(ticketsHref ? [{ href: ticketsHref, label: 'Get tickets' }] : []), { href: '/speakers', label: 'Meet the speakers', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style>
	/* One gap between two sections, never two paddings stacked: the timetable
	   hands its bottom air to the list's opening, and the list hands its own
	   to the closer's. */
	.agenda-sheet {
		padding-bottom: 0;
	}

	.agenda-talks {
		padding-bottom: 0;
	}

	/* Phone: the list under the head waits for a search, and says so itself. */
	@media (max-width: 720px) {
		.agenda-talks .head-rule-note {
			display: none;
		}
	}
</style>
