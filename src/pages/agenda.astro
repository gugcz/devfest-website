---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Agenda from '../components/Agenda.tsx';
import { getBuildLineup } from '../lib/lineup-build';

// Prerender the timetable so every talk, room and time slot is in the served
// HTML. `agendaSessions` keeps the service/plenum bands (breaks, lunch,
// registration) that `/sessions` drops — the grid renders them as full-width
// rows. The island re-fetches on mount, so a stale build still self-corrects.
const { agendaSessions, speakers } = await getBuildLineup();
---

<BaseLayout
	title="Agenda — DevFest.cz 2026"
	description="The full timetable for DevFest.cz 2026 — every talk, room, and time slot for Prague's largest community developer conference."
>
	<main class="agenda-page">
		<SubpageHero
			label="Running order"
			titleHtml={'The day<br /><span class="red">on a timeline.</span>'}
			lede="Every talk mapped to its room and time slot. Compare the tracks, plan your day — the grid fills in as the schedule is confirmed."
			seoHeading="DevFest.cz 2026 Agenda & Schedule"
			titleId="agenda-title"
		/>

		<section class="agenda-body" aria-label="Conference timetable">
			<div class="agenda-inner">
				<header class="agenda-header">
					<p class="agenda-eyebrow">The schedule</p>
					<h2 class="agenda-heading">When &amp; where</h2>
				</header>

				<!-- Server-rendered from the build snapshot, then hydrated and
				     refreshed from /api/lineup. No <noscript> fallback needed: the
				     timetable is in the HTML whether or not scripts run. -->
				<Agenda
					client:load
					initialSessions={agendaSessions}
					initialSpeakers={speakers}
				/>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './agenda';
</style>
