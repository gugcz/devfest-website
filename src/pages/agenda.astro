---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Closer from '../components/Closer.astro';
import Agenda from '../components/Agenda.tsx';
import Sessions from '../components/Sessions.tsx';

// ONE PAGE FOR THE PROGRAMME. The timetable answers "when and where", the
// list under it "what is it about" — search, filters and every abstract. They
// were two menu lines (`Sessions`, `Agenda`) for one question; `/sessions`
// now redirects to `#talks` here, query string and all.
---

<BaseLayout
	title="Agenda & talks — DevFest.cz 2026"
	description="The full programme for DevFest.cz 2026 — registration from 8:00, keynote at 9:00, two stages of talks, lightning talks and the afterparty. Every talk, room and time slot, plus a searchable list of every talk at Prague's community developer conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'The day<br /><span class="red">on a timeline.</span>'}
			lede="Every talk by room and time, and the full list with abstracts below it. A slot or two may still move before the day."
			link={{ href: '#talks', label: 'Browse all talks' }}
			seoHeading="DevFest.cz 2026 Agenda, Schedule & Sessions"
			titleId="agenda-title"
			focus="82% 60%"
		/>

		<section class="band band--lit" aria-label="Conference timetable">
			<div class="band-inner">
				<!-- The hero names this band; its head is for screen readers only. -->
				<h2 class="sr-only">Timetable</h2>

				<!-- The timetable hydrates client-side from /api/lineup; keep a static
				     note for crawlers and no-JS visitors. -->
				<Agenda client:load />

				<noscript>
					<p class="fallback-note">
						The agenda loads with JavaScript enabled. Please turn it on, or check back soon.
					</p>
				</noscript>
			</div>
		</section>

		<section id="talks" class="band band--lit agenda-talks" aria-labelledby="talks-title">
			<div class="band-inner">
				<div class="head-split">
					<h2 id="talks-title" class="display head-title">Every talk.</h2>
					<p class="head-note">Search, or filter by track and level. Pick one for its abstract and speakers.</p>
				</div>

				<!-- Hydrates from the same /api/lineup read as the timetable. -->
				<Sessions client:load />
			</div>
		</section>

		<Closer
			titleHtml={'Doors open<br />30 October.'}
			note="Uhelný Mlýn, near Prague. Nine in the morning to eight at night."
			tone="accent"
			titleId="agenda-closer"
			actions={[{ href: '/#tickets', label: 'Get tickets' }, { href: '/speakers', label: 'Meet the speakers', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>
