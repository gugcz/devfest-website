---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Closer from '../components/Closer.astro';
import Agenda from '../components/Agenda.tsx';
import { EVENT_TOPICS } from '../lib/ticker';
---

<BaseLayout
	title="Agenda — DevFest.cz 2026"
	description="The full timetable for DevFest.cz 2026 — registration from 8:00, keynote at 9:00, two stages of talks, lightning talks and the afterparty. Every talk, room and time slot for Prague's community developer conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'The day<br /><span class="red">on a timeline.</span>'}
			lede="Every talk mapped to its room and time slot. Compare the two stages and plan your day — the schedule is out, though a slot or two may still shift."
			seoHeading="DevFest.cz 2026 Agenda & Schedule"
			titleId="agenda-title"
			focus="82% 60%"
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band band--lit" aria-label="Conference timetable">
			<div class="band-inner">
				<header class="head-stack">
					<p class="eyebrow">The schedule</p>
					<h2 class="display head-title">When &amp; where</h2>
					<p class="head-stack-link">
						<a class="btn-ghost" href="/sessions">Browse all talks</a>
					</p>
				</header>

				<!-- The timetable hydrates client-side from /api/lineup; keep a static
				     note for crawlers and no-JS visitors. -->
				<Agenda client:load />

				<noscript>
					<p class="fallback-note">
						The agenda loads with JavaScript enabled. Please turn it on, or see the <a href="/sessions">full list of talks</a>.
					</p>
				</noscript>
			</div>
		</section>

		<Closer
			eyebrow="Be there"
			titleHtml={'Doors open<br /><span class="red">30 October</span>.'}
			note="Uhelný Mlýn, near Prague. Nine in the morning to eight at night."
			tone="accent"
			titleId="agenda-closer"
			actions={[{ href: '/#tickets', label: 'Get tickets' }, { href: '/speakers', label: 'Meet the speakers', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>
