---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Closer from '../components/Closer.astro';
import Agenda from '../components/Agenda.tsx';
import { EVENT_TOPICS } from '../lib/ticker';
import { getBuildLineup } from '../lib/lineup-build';
import { pageUrl, sessionsSchema } from '../lib/lineup-schema';

// The timetable is this page's entire content, so without a build-time read the
// indexable HTML is a heading and a loading line — see `src/lib/lineup-build.ts`.
// `agenda` keeps the service + plenum sessions the grid renders as bands.
const { agenda, speakers } = await getBuildLineup();
const url = pageUrl('/agenda');
const jsonLd = sessionsSchema(agenda, url, {
	name: 'DevFest.cz 2026 schedule',
	ordered: true,
});
---

<BaseLayout
	title="Agenda — DevFest.cz 2026"
	description="The full timetable for DevFest.cz 2026 — every talk, room, and time slot for Prague's largest community developer conference."
>
	{jsonLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />}

	<main class="page-stack">
		<SubpageHero
			titleHtml={'The day<br /><span class="red">on a timeline.</span>'}
			lede="Every talk mapped to its room and time slot. Compare the tracks, plan your day — the grid fills in as the schedule is confirmed."
			seoHeading="DevFest.cz 2026 Agenda & Schedule"
			titleId="agenda-title"
			focus="82% 60%"
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band band--lit-red" aria-label="Conference timetable">
			<div class="band-inner">
				<header class="head-stack">
					<p class="eyebrow">The schedule</p>
					<h2 class="display head-title">When &amp; where</h2>
					<p class="head-stack-link">
						<a class="btn-ghost" href="/sessions">Browse all talks</a>
					</p>
				</header>

				<!-- Server-rendered from the build-time lineup, then refetched on
				     mount so the grid stays current between deploys. -->
				<Agenda client:load initialSessions={agenda} initialSpeakers={speakers} />

				{agenda.length === 0 && (
					<noscript>
						<p class="fallback-note">
							The agenda loads with JavaScript enabled. Please turn it on, or see the
							<a href="/sessions">full list of talks</a>.
						</p>
					</noscript>
				)}
			</div>
		</section>

		<Closer
			eyebrow="Be there"
			titleHtml={'Doors open<br /><span class="red">30 October</span>.'}
			note="Uhelný Mlýn, near Prague. Nine in the morning to eight at night."
			tone="accent"
			titleId="agenda-closer"
			actions={[{ href: '/#tickets', label: 'Get tickets' }, { href: '/speakers', label: 'Meet the speakers', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './agenda';
</style>
