---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Closer from '../components/Closer.astro';
import Sessions from '../components/Sessions.tsx';
import { EVENT_TOPICS } from '../lib/ticker';
---

<BaseLayout
	title="Sessions — DevFest.cz 2026"
	description="Every talk at DevFest.cz 2026 — AI agents, generative UI, cloud, mobile, web and the humans behind it — on two stages at Prague's community-built developer conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'The talks on<br />the <span class="red">docket.</span>'}
			lede="Every confirmed talk at DevFest.cz 2026 and who gives it. Search, or filter by track and level."
			link={{ href: '/agenda', label: 'See the schedule' }}
			seoHeading="DevFest.cz 2026 Sessions & Talks"
			titleId="sessions-title"
			focus="28% 55%"
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band band--lit" aria-label="Session list">
			<div class="band-inner">
				<!-- The hero names this band; its head is for screen readers only. -->
				<h2 class="sr-only">All sessions</h2>

				<!-- The grid hydrates client-side from Firestore; keep a static note
				     for crawlers and no-JS visitors. -->
				<Sessions client:load />

				<noscript>
					<p class="fallback-note">
						The session agenda loads with JavaScript enabled. Please turn it on, or
						check back soon.
					</p>
				</noscript>
			</div>
		</section>

		<Closer
			titleHtml={'Plan your<br /><span class="red">day</span>.'}
			note="The schedule puts every talk in a room and a time slot."
			tone="accent"
			titleId="sessions-closer"
			actions={[{ href: '/#tickets', label: 'Get tickets' }, { href: '/agenda', label: 'See the schedule', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>
