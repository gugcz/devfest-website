---
// Rendered on demand so the schedule ships in the server HTML — the Admin SDK
// read below bypasses App Check, so mobile never waits on a reCAPTCHA token (the
// old client Firestore read is gone). Must stay a literal `false`: Astro's
// prerender detection is static, so a non-literal silently falls back to
// prerendering. The axe build (A11Y_MOCK) runs this handler via scripts/a11y.mjs
// with the firebase-admin reads aliased to fixtures.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Sessions from '../components/Sessions.tsx';
import { applyContentCache } from '../lib/ssr-cache';
import { readSessions, readSpeakersById } from '../lib/lineup-data';

const { sessions, failed } = await readSessions();
// Full speaker profiles for the session → speaker drill-down (best-effort; a
// failure degrades it to the embedded summary and never 503s the page).
const speakersById = await readSpeakersById();

// Edge-cache only a populated render; an empty (healthy) or failed read stays
// uncached, and only a thrown read is a 503 (empty is a valid "announced soon").
applyContentCache(Astro.response, !failed && sessions.length > 0);
if (failed) Astro.response.status = 503;
---

<BaseLayout
	title="Sessions — DevFest.cz 2026"
	description="The talks and sessions on the agenda at DevFest.cz 2026 — Prague's largest community developer conference."
>
	<main class="sessions-page">
		<SubpageHero
			label="Case files"
			titleHtml={'The talks<br /><span class="red">on the docket.</span>'}
			lede="Every talk confirmed for DevFest.cz 2026, with the speakers behind it. Search or filter by track to find your thing — the full schedule lands closer to the event."
			seoHeading="DevFest.cz 2026 Sessions & Talks"
			titleId="sessions-title"
		/>

		<section class="sessions-body" aria-label="Session list">
			<div class="sessions-inner">
				<header class="sessions-header">
					<p class="sessions-eyebrow">The sessions</p>
					<h2 class="sessions-heading">What&rsquo;s on</h2>
				</header>

				<!-- The grid is server-rendered from Firestore (Admin SDK); the island
				     hydrates from these props for search, filters and the detail
				     dialog. Present in the HTML with or without JavaScript. -->
				<Sessions client:load sessions={sessions} speakersById={speakersById} failed={failed} />
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './sessions';
</style>
