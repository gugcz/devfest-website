---
// Rendered on demand so the schedule ships in the server HTML — the Admin SDK
// read below bypasses App Check, so mobile never waits on a reCAPTCHA token (the
// old client Firestore read is gone). Under A11Y_MOCK the route prerenders
// instead, so the static axe harness gets a fixture-filled file to audit.
// Literal `false` — Astro's prerender detection is static; a non-literal silently
// falls back to prerendering. The axe build (A11Y_MOCK) runs this handler via
// scripts/a11y.mjs with the firebase-admin reads aliased to fixtures.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Sessions from '../components/Sessions.tsx';
import { adminFirestore } from '../lib/firebase-admin';
import { applyContentCache } from '../lib/ssr-cache';
import { isDisplayableSession, sessionFromDoc, type Session } from '../lib/sessions';
import { speakerFromDoc, type Speaker } from '../lib/speakers';

let sessions: Session[] = [];
let ok = false;
try {
	const snap = await adminFirestore().collection('sessions').orderBy('order').get();
	sessions = snap.docs.map((doc) => sessionFromDoc(doc.id, doc.data())).filter(isDisplayableSession);
	ok = sessions.length > 0;
} catch (err) {
	console.error('[sessions] SSR Firestore read failed:', err);
}

// Best-effort: full speaker profiles (bio/links/talks) keyed by id, so the
// session → speaker drill-down in SessionDetail enriches its stacked dialog from
// props instead of a client Firestore read. Independent of `ok` — a failure here
// only degrades the drill-down to the embedded summary, it doesn't 503 the page.
let speakersById: Record<string, Speaker> = {};
try {
	const snap = await adminFirestore().collection('speakers').orderBy('order').get();
	speakersById = Object.fromEntries(
		snap.docs.map((doc) => [doc.id, speakerFromDoc(doc.id, doc.data())]),
	);
} catch (err) {
	console.warn('[sessions] SSR speaker-profile read failed; drill-down uses summaries:', err);
}

applyContentCache(Astro.response, ok);
if (!ok) Astro.response.status = 503;
---

<BaseLayout
	title="Sessions — DevFest.cz 2026"
	description="The talks and sessions on the agenda at DevFest.cz 2026 — Prague's largest community developer conference."
>
	<main class="sessions-page">
		<SubpageHero
			label="Case files"
			titleHtml={'The talks<br /><span class="red">on the docket.</span>'}
			lede="Every talk confirmed for DevFest.cz 2026, with the speakers behind it. Search or filter by track to find your thing — the full schedule lands closer to the event."
			seoHeading="DevFest.cz 2026 Sessions & Talks"
			titleId="sessions-title"
		/>

		<section class="sessions-body" aria-label="Session list">
			<div class="sessions-inner">
				<header class="sessions-header">
					<p class="sessions-eyebrow">The sessions</p>
					<h2 class="sessions-heading">What&rsquo;s on</h2>
				</header>

				<!-- The grid is server-rendered from Firestore (Admin SDK); the island
				     hydrates from these props for search, filters and the detail
				     dialog. Present in the HTML with or without JavaScript. -->
				<Sessions client:load sessions={sessions} speakersById={speakersById} failed={!ok} />
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './sessions';
</style>
