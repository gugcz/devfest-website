---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Sessions from '../components/Sessions.tsx';
---

<BaseLayout
	title="Sessions — DevFest.cz 2026"
	description="The talks and sessions on the agenda at DevFest.cz 2026 — Prague's community-built developer conference."
>
	<main class="sessions-page">
		<SubpageHero
			label="Case files"
			titleHtml={'The talks on<br />the <span class="red">docket</span>.'}
			lede="Every talk confirmed for DevFest.cz 2026, with the speakers behind it. Search or filter by track to find your thing — the full schedule lands closer to the event."
			seoHeading="DevFest.cz 2026 Sessions & Talks"
			titleId="sessions-title"
		/>

		<section class="sessions-body" aria-label="Session list">
			<div class="sessions-inner">
				<header class="sessions-header">
					<p class="sessions-eyebrow">The sessions</p>
					<h2 class="sessions-heading">What&rsquo;s on</h2>
					<p class="sessions-crosslink">
						<a class="btn-ghost" href="/agenda">
							See the schedule
							<span class="btn-ghost-arrow" aria-hidden="true">&rarr;</span>
						</a>
					</p>
				</header>

				<!-- The grid hydrates client-side from Firestore; keep a static note
				     for crawlers and no-JS visitors. -->
				<Sessions client:load />

				<noscript>
					<p class="sessions-noscript">
						The session agenda loads with JavaScript enabled. Please turn it on, or
						check back soon.
					</p>
				</noscript>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './sessions';
</style>
