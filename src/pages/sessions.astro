---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Closer from '../components/Closer.astro';
import Sessions from '../components/Sessions.tsx';
import { EVENT_TOPICS } from '../lib/ticker';
import { getBuildLineup } from '../lib/lineup-build';
import { pageUrl, sessionsSchema } from '../lib/lineup-schema';
import { ldJson } from '../lib/json-ld';

// Talk titles in the static HTML rather than only after hydration — see
// `src/lib/lineup-build.ts`. An unreachable endpoint yields an empty programme,
// which is the page exactly as it shipped before.
const { sessions } = await getBuildLineup();

// Rotate the running order once per build, so no track or room keeps a
// permanent top-of-grid advantage. This used to happen in the island on every
// page load; it cannot any more, because the grid is server-rendered and a
// per-load shuffle would differ between the server's HTML and the client's
// first render. Per deploy is a fair substitute — the hosting workflow also
// redeploys daily (see .github/workflows/firebase-hosting-merge.yml).
const rotated = sessions
	.map((session) => ({ session, sort: Math.random() }))
	.sort((a, b) => a.sort - b.sort)
	.map(({ session }) => session);
const url = pageUrl('/sessions');
const jsonLd = sessionsSchema(rotated, url, { name: 'DevFest.cz 2026 sessions' });
---

<BaseLayout
	title="Sessions — DevFest.cz 2026"
	description="The talks and sessions on the agenda at DevFest.cz 2026 — Prague's community-built developer conference."
>
	{jsonLd && <script type="application/ld+json" slot="head" set:html={ldJson(jsonLd)} />}

	<main class="page-stack">
		<SubpageHero
			titleHtml={'The talks on<br />the <span class="red">docket.</span>'}
			lede="Every talk confirmed for DevFest.cz 2026, with the speakers behind it. Search or filter by track to find your thing — the full schedule lands closer to the event."
			seoHeading="DevFest.cz 2026 Sessions & Talks"
			titleId="sessions-title"
			focus="28% 55%"
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band band--lit-red" aria-label="Session list">
			<div class="band-inner">
				<header class="head-stack">
					<p class="eyebrow">The sessions</p>
					<h2 class="display head-title">What&rsquo;s on</h2>
					<p class="head-stack-link">
						<a class="btn-ghost" href="/agenda">See the schedule</a>
					</p>
				</header>

				<!-- Server-rendered from the build-time lineup, then refetched on
				     mount so the programme stays current between deploys. -->
				<Sessions client:load initialSessions={rotated} />

				{rotated.length === 0 && (
					<noscript>
						<p class="fallback-note">
							The session agenda loads with JavaScript enabled. Please turn it on, or
							check back soon.
						</p>
					</noscript>
				)}
			</div>
		</section>

		<Closer
			eyebrow="Be there"
			titleHtml={'Pick your<br /><span class="red">day</span>.'}
			note="Every talk, mapped to a room and a time slot."
			tone="accent"
			titleId="sessions-closer"
			actions={[{ href: '/agenda', label: 'See the schedule' }, { href: '/#tickets', label: 'Get tickets', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './sessions';
</style>
