---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Sessions from '../components/Sessions.tsx';
import { shuffle } from '../lib/sessions';
import { getBuildLineup } from '../lib/lineup-build';

// Prerender the grid so talk titles and abstracts are in the served HTML.
//
// The randomisation that used to run per page load now runs here, once per
// build: the island keeps whatever order it is handed unless the set of talks
// actually changed, so a visitor never watches the grid re-order under them.
// The daily rebuild re-rolls it, which is enough to stop any one track keeping
// the top of the grid.
const { sessions, speakers } = await getBuildLineup();
const shuffledSessions = shuffle(sessions);
---

<BaseLayout
	title="Sessions — DevFest.cz 2026"
	description="The talks and sessions on the agenda at DevFest.cz 2026 — Prague's community-built developer conference."
>
	<main class="sessions-page">
		<SubpageHero
			label="Case files"
			titleHtml={'The talks on<br />the <span class="red">docket</span>.'}
			lede="Every talk confirmed for DevFest.cz 2026, with the speakers behind it. Search or filter by track to find your thing — the full schedule lands closer to the event."
			seoHeading="DevFest.cz 2026 Sessions & Talks"
			titleId="sessions-title"
		/>

		<section class="sessions-body" aria-label="Session list">
			<div class="sessions-inner">
				<header class="sessions-header">
					<p class="sessions-eyebrow">The sessions</p>
					<h2 class="sessions-heading">What&rsquo;s on</h2>
					<p class="sessions-crosslink">
						<a class="btn-ghost" href="/agenda">
							See the schedule
							<span class="btn-ghost-arrow" aria-hidden="true">&rarr;</span>
						</a>
					</p>
				</header>

				<!-- Server-rendered from the build snapshot, then hydrated and
				     refreshed from /api/lineup. No <noscript> fallback needed: the
				     grid is in the HTML whether or not scripts run. -->
				<Sessions
					client:load
					initialSessions={shuffledSessions}
					initialSpeakers={speakers}
				/>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './sessions';
</style>
