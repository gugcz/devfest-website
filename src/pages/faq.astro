---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Closer from '../components/Closer.astro';
import { EVENT_TOPICS } from '../lib/ticker';

// ─────────────────────────────────────────────────────────────────────────
// FAQ CONTENT — single source of truth: the `faq` content collection
// (`src/content/faq.json`, schema in `src/content.config.ts`).
//
// A living list: we know a handful of things for certain now and will add
// more over time. The rendered accordion, the running item numbers,
// and the FAQPage JSON-LD (Google rich results) all DERIVE from that data,
// so adding or editing a Q&A means touching only the JSON.
//
//   • `a` may contain inline HTML (links, <strong>, …). It is rendered with
//     set:html for display and reused verbatim in the structured data.
//   • Add / remove groups and items freely; `order` fixes the group sequence
//     (getCollection() does not preserve file order), items keep array order.
// ─────────────────────────────────────────────────────────────────────────
const faqGroups = (await getCollection('faq'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		id: entry.id,
		label: entry.data.label,
		items: entry.data.items,
	}));

// Running item number across all groups → "N° 01" labels, plus a per-group
// count (zero-padded) for the editorial section header ("04 entries").
let fileCounter = 0;
const groupsForDisplay = faqGroups.map((group) => ({
	...group,
	count: String(group.items.length).padStart(2, '0'),
	items: group.items.map((item) => {
		fileCounter += 1;
		return { ...item, num: String(fileCounter).padStart(2, '0') };
	}),
}));

// FAQPage structured data — flattened from the same source so it can never
// drift from what's rendered. https://developers.google.com/search/docs/appearance/structured-data/faqpage
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqGroups.flatMap((group) =>
		group.items.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.a,
			},
		}))
	),
};
const faqJsonLd = JSON.stringify(faqSchema);
---

<BaseLayout
	title="FAQ — DevFest.cz 2026"
	description="Frequently asked questions about DevFest.cz 2026 — tickets, venue, travel, program, and what to expect on the day."
>
	<script type="application/ld+json" slot="head" set:html={faqJsonLd} />

	<main class="page-stack">
		<SubpageHero
			titleHtml={'Questions,<br /><span class="red">answered.</span>'}
			lede="Answers to the questions we hear most. Can't find yours? Get in touch."
			seoHeading="DevFest.cz 2026 FAQ"
			titleId="faq-title"
			photo={false}
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />


		<!-- FILES -->
		{/* Its own heading, not the hero's `faq-title`: two <section>s carrying
		    the same accessible name are two regions with one name, which is the
		    `landmark-unique` axe violation this page used to be the only holder
		    of. The heading is visually hidden — the category heads inside the
		    list are what a sighted visitor reads as structure. */}
		<section class="band band--lit" aria-labelledby="faq-list-heading">
			<div class="band-inner">
				<h2 id="faq-list-heading" class="sr-only">All questions</h2>
				{groupsForDisplay.map((group, groupIndex) => (
					<div class="faq-group reveal">
						{/* Category pinned in its own column beside the questions —
						    an editorial two-column split rather than a caption stacked
						    over a narrow centred list. */}
						<div class="faq-head">
							<h2 class="faq-cat" id={`faq-cat-${group.id}`}>{group.label}</h2>
						</div>

						<div class="field faq-list">
							{group.items.map((item, itemIndex) => (
								/* The first question opens on arrival. Every <details>
								   collapsed meant the page a speaker and a journalist
								   both land on showed no answer at all — a list of
								   questions and nothing else. One open item is enough
								   to show what an answer looks like; opening more would
								   bury the rest of the list. */
								<details class="faq-item" open={groupIndex === 0 && itemIndex === 0}>
									<summary class="field-row field-row--link faq-q">
										<span class="faq-q-text">{item.q}</span>
										<span class="faq-marker" aria-hidden="true">+</span>
									</summary>
									<div class="faq-a">
										<p set:html={item.a} />
									</div>
								</details>
							))}
						</div>
					</div>
				))}

			</div>
		</section>

		<Closer
			eyebrow="Still stuck"
			titleHtml={'Ask us<br /><span class="red">directly</span>.'}
			note="If the answer is not here, one of the desks will have it."
			tone="accent"
			titleId="faq-closer"
			actions={[{ href: '/contact', label: 'Contact us' }, { href: '/#tickets', label: 'Get tickets', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './faq';
</style>
