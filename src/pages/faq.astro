---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import EndLine from '../components/EndLine.astro';

// FAQ content: the `faq` collection (`src/content/faq.json`). Accordion and
// FAQPage JSON-LD both derive from it. `a` may contain inline HTML
// (`set:html`); `order` fixes group sequence, items keep array order.
const faqGroups = (await getCollection('faq'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		id: entry.id,
		label: entry.data.label,
		items: entry.data.items,
	}));

let fileCounter = 0;
const groupsForDisplay = faqGroups.map((group) => ({
	...group,
	items: group.items.map((item) => {
		fileCounter += 1;
		return { ...item, num: String(fileCounter).padStart(2, '0') };
	}),
}));

// FAQPage structured data — flattened from the same source so it can never
// drift from what's rendered. https://developers.google.com/search/docs/appearance/structured-data/faqpage
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqGroups.flatMap((group) =>
		group.items.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.a,
			},
		}))
	),
};
// `<` escaped so a `</script>` in an answer can't end the element.
const faqJsonLd = JSON.stringify(faqSchema).replace(/</g, '\\u003c');
---

<BaseLayout
	title="FAQ — DevFest.cz 2026"
	description="Frequently asked questions about DevFest.cz 2026 — ticket waves and prices, the venue and how to get there, the schedule, speakers, the afterparty, and what to expect on the day."
>
	<script type="application/ld+json" slot="head" set:html={faqJsonLd} />

	<main class="page-stack">
		<SubpageHero
			titleHtml={'Questions'}
			lede="Answers to the questions we hear most. Can't find yours?"
			link={{ href: 'mailto:devfest@gug.cz', label: 'Get in touch' }}
			seoHeading="DevFest.cz 2026 FAQ"
			titleId="faq-title"
			photo={false}
		/>


		{/* Its own heading, not the hero's `faq-title`: two <section>s carrying
		    the same accessible name are two regions with one name, which is the
		    `landmark-unique` axe violation this page used to be the only holder
		    of. The heading is visually hidden — the category heads inside the
		    list are what a sighted visitor reads as structure. */}
		<section class="band band--lit" aria-labelledby="faq-list-heading">
			<div class="band-inner faq">
				<h2 id="faq-list-heading" class="sr-only">All questions</h2>

				{/* The categories, pinned beside the slips on a desktop; a wrapped
				    row of links above them on a phone. */}
				<nav class="faq-index" aria-label="FAQ categories">
					<p class="faq-index-label">Categories</p>
					<ol role="list">
						{groupsForDisplay.map((group, groupIndex) => (
							<li>
								<a href={`#faq-cat-${group.id}`}>
									<span class="faq-index-no" aria-hidden="true">{String(groupIndex + 1).padStart(2, '0')}</span>
									<span>{group.label}</span>
								</a>
							</li>
						))}
					</ol>
					<p class="faq-index-ask">
						Can't find yours? <a class="action" href="mailto:devfest@gug.cz">devfest@gug.cz</a>
					</p>
				</nav>

				<div class="faq-body">
					{groupsForDisplay.map((group, groupIndex) => (
						<div class="faq-group">
							<h2 class="faq-cat" id={`faq-cat-${group.id}`}>{group.label}</h2>

							<div class="faq-slips">
								{group.items.map((item, itemIndex) => (
									/* The first question opens on arrival. Every <details>
									   collapsed meant the page a speaker and a journalist
									   both land on showed no answer at all. One open item is
									   enough to show what an answer looks like. */
									<details class="paper faq-item" open={groupIndex === 0 && itemIndex === 0}>
										<summary class="faq-q">
											<span class="faq-no">Q {item.num}</span>
											<span class="faq-q-text">{item.q}</span>
											<span class="faq-marker" aria-hidden="true">
												<span class="faq-marker-open">Open</span>
												<span class="faq-marker-close">Close</span>
											</span>
										</summary>
										<div class="faq-a">
											<p set:html={item.a} />
										</div>
									</details>
								))}
							</div>
						</div>
					))}

					{/* The page ends on one line to the inbox, not a closing band: a
					    visitor who read this far wants an answer, not a pitch. */}
					<EndLine text="Still stuck?" href="mailto:devfest@gug.cz" label="Write to devfest@gug.cz" />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './faq';
</style>
