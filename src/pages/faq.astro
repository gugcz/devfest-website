---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Closer from '../components/Closer.astro';

// FAQ content: the `faq` collection (`src/content/faq.json`). Accordion and
// FAQPage JSON-LD both derive from it. `a` may contain inline HTML
// (`set:html`); `order` fixes group sequence, items keep array order.
const faqGroups = (await getCollection('faq'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		id: entry.id,
		label: entry.data.label,
		items: entry.data.items,
	}));

// How many answers stand open when the page loads, counted down the page.
const OPEN_ON_ARRIVAL = 3;

let fileCounter = 0;
const groupsForDisplay = faqGroups.map((group) => ({
	...group,
	items: group.items.map((item) => {
		fileCounter += 1;
		return { ...item, num: String(fileCounter).padStart(2, '0') };
	}),
}));

// FAQPage structured data — flattened from the same source so it can never
// drift from what's rendered. https://developers.google.com/search/docs/appearance/structured-data/faqpage
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqGroups.flatMap((group) =>
		group.items.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.a,
			},
		}))
	),
};
// `<` escaped so a `</script>` in an answer can't end the element.
const faqJsonLd = JSON.stringify(faqSchema).replace(/</g, '\\u003c');
---

<BaseLayout
	title="FAQ — DevFest.cz 2026"
	description="Frequently asked questions about DevFest.cz 2026 — ticket waves and prices, the venue and how to get there, the schedule, speakers, the afterparty, and what to expect on the day."
>
	<script type="application/ld+json" slot="head" set:html={faqJsonLd} />

	<main class="page-stack">
		<SubpageHero
			titleHtml={'Questions,<br /><span class="red">answered.</span>'}
			lede="Answers to the questions we hear most. Can't find yours? Get in touch."
			seoHeading="DevFest.cz 2026 FAQ"
			titleId="faq-title"
			photo={false}
		/>


		<!-- THE TRANSCRIPT -->
		{/* A FAQ is an interview: a question, then its answer. So it is set as a
		    transcript, "Q." over the question and "A." over the answer, with the
		    first three answers already open: a page of closed questions showed a
		    visitor nothing until they clicked. The group index on the left stays
		    beside the list while it scrolls (a row of chips on a phone).
		    Its own heading, not the hero's `faq-title`: two <section>s carrying
		    the same accessible name are two regions with one name, which is the
		    `landmark-unique` axe violation. */}
		<section class="band band--lit" aria-labelledby="faq-list-heading">
			<div class="band-inner faq-sheet">
				<nav class="faq-index" aria-label="Question groups">
					<h2 id="faq-list-heading" class="faq-index-title">All questions</h2>
					<ol class="faq-index-list">
						{groupsForDisplay.map((group, groupIndex) => (
							<li>
								<a href={`#faq-cat-${group.id}`}>
									<span class="faq-index-num" aria-hidden="true">{String(groupIndex + 1).padStart(2, '0')}</span>
									{group.label}
								</a>
							</li>
						))}
					</ol>
				</nav>

				<div class="faq-groups">
					{groupsForDisplay.map((group, groupIndex) => (
						<div class="faq-group">
							<h2 class="faq-cat" id={`faq-cat-${group.id}`}>
								<span aria-hidden="true">{String(groupIndex + 1).padStart(2, '0')} · </span>{group.label}<span class="faq-cat-count"> · {group.items.length} questions</span>
							</h2>

							<div class="faq-list">
								{group.items.map((item) => (
									<details class="faq-item" open={Number(item.num) <= OPEN_ON_ARRIVAL}>
										<summary class="faq-q">
											<span class="faq-who faq-who--q" aria-hidden="true">Q.</span>
											<span class="faq-q-text">{item.q}</span>
											<span class="faq-marker" aria-hidden="true">+</span>
										</summary>
										<div class="faq-a">
											<span class="faq-who" aria-hidden="true">A.</span>
											<p set:html={item.a} />
										</div>
									</details>
								))}
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<Closer
			titleHtml={'Ask us<br />directly.'}
			note="If the answer is not here, one of the desks will have it."
			tone="accent"
			titleId="faq-closer"
			actions={[{ href: '/contact', label: 'Contact us' }, { href: '/#tickets', label: 'Get tickets', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './faq';
</style>
