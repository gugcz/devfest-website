---
// ─── SPEAKER SHARE CARD ───────────────────────────────────────────────────
// The `/attending` card for speakers: pick your name, get "I'M SPEAKING" with
// your talk title. UNLISTED = `noindex` + out of the sitemap + linked from
// NOWHERE (not access control) — the link goes out to speakers directly.
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import SpeakerCard from '../components/SpeakerCard';
import { EVENT, pageTitle } from '../lib/event';
---

<BaseLayout
	title={`I'm speaking — ${EVENT.name}`}
	description={`Make a ${EVENT.name} speaker card with your name and talk title.`}
	noindex
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'I’m speaking'}
			lede="Pick your name and we set your talk on the card. Download it or share it straight to your feed."
			seoHeading={pageTitle("I'm speaking")}
			titleId="speaker-card-title"
		/>

		<section class="band band--lit" aria-labelledby="speaker-card-form-heading">
			<div class="band-inner">
				<h2 id="speaker-card-form-heading" class="sr-only">Build your speaker card</h2>
				<SpeakerCard client:load />
			</div>
		</section>
	</main>
</BaseLayout>
