---
// ─── VENUE SCREENS ────────────────────────────────────────────────────────
// What the TVs around the venue show on the day: `/tv?room=<id or name>`
// pins a screen to the room it hangs next to (the talk on now, what's next,
// the other rooms), plain `/tv` shows every room. A credits band under both
// names the organiser and loops through the partners. `?at=10:15` fakes the
// time to check a screen before the day. `?rotate=90` (or `270`) turns the
// picture a quarter for a TV hung on its side that still reports landscape.
// UNLISTED = `noindex` + out of the sitemap + linked from NOWHERE (not
// access control).
import BaseLayout from '../layouts/BaseLayout.astro';
import TvScreen, { type PartnerGroup } from '../components/TvScreen';
import gugLogo from '../assets/gug-logo.svg';
import { getActivePartnerTiers, getCommunityPartners, getTravelPartners, logoBox } from '../lib/partners';
import { EVENT } from '../lib/event';

// The same set and order as the homepage strip: the ladder top tier first,
// community and travel last.
const tiers = [
	...(await getActivePartnerTiers()).map((tier) => ({ tier: tier.label, partners: tier.partners })),
	{ tier: 'Community', partners: await getCommunityPartners() },
	{ tier: 'Travel', partners: await getTravelPartners() },
];
// Every tier gets the Gold reference box, so the band keeps one height page
// after page; inside it each mark gets the same ink area (`logoBox`), in the
// screen's `--u` (0.06u per px of the box: a 5:1 wordmark ≈ 12u wide).
const U_PER_PX = 0.06;
// Two logos fit beside the hashtag at a size that reads; a bigger tier
// splits into even pages (5 → 2 + 1 + 2), each still labelled with its tier.
const PER_PAGE = 2;
const partners: PartnerGroup[] = tiers.flatMap(({ tier, partners }) => {
	const label = `${tier} partner${partners.length === 1 ? '' : 's'}`;
	const logos = partners.map((p) => {
		const { img, box } = logoBox(p, 'gold');
		return { name: p.name, src: img.src, w: +(box.width * U_PER_PX).toFixed(2), dark: p.mono === 'dark' };
	});
	const pages = Math.ceil(logos.length / PER_PAGE);
	return Array.from({ length: pages }, (_, i) => ({
		label,
		logos: logos.slice(Math.round((i * logos.length) / pages), Math.round(((i + 1) * logos.length) / pages)),
	}));
});
---

<BaseLayout
	title={`Venue screen — ${EVENT.name}`}
	description={`${EVENT.name} agenda for the screens at the venue.`}
	noindex
	kiosk
>
	<TvScreen client:load partners={partners} organizerLogo={gugLogo.src} />
</BaseLayout>
