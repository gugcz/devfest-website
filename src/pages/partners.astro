---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Closer from '../components/Closer.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { getActivePartnerTiers, getMediaPartners, getCommunityPartners } from '../lib/partners';

const activeTiers = await getActivePartnerTiers();

// Off-ladder rows, rendered below the tiers as cream logo plates. Same markup
// and styling for both — only the heading differs — so they share one loop.
const plateRows = [
	{ id: 'media', label: 'Media', partners: await getMediaPartners() },
	{ id: 'community', label: 'Community', partners: await getCommunityPartners() },
].filter((row) => row.partners.length > 0);

// One wall per row, tiers first then the off-ladder rows — only the ground
// (`plated`) and the per-partner logoProps() call differ between them.
const wallRows = [
	...activeTiers.map((tier) => ({ ...tier, plated: false as const })),
	...plateRows.map((row) => ({ ...row, plated: true as const })),
];

// ─── LOGO OPTIMISATION ─────────────────────────────────────────────────────
// The masters live in `src/assets/partners/<tier>/` so the build can resize
// them and emit modern formats (assets in `public/` are served untouched).
// The `partners` collection still stores plain path strings, so — same pattern
// as team.astro — we glob the sources and key them by filename.
const logoSources = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/**/*', {
	eager: true,
});
const logoByFile = new Map<string, ImageMetadata>(
	Object.entries(logoSources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
const logoFor = (logo: string): ImageMetadata =>
	logoByFile.get(logo.split('/').pop() as string) as ImageMetadata;

// SVG wordmarks stay vector — `format="svg"` makes astro:assets copy them
// through unchanged (rasterising a logo would be a downgrade); rasters get a
// real srcset sized to the box the mark actually renders in.
//
// ─── OPTICAL NORMALISATION ────────────────────────────────────────────────
// Every cell is the same size now (see `.logo-grid` in partners.scss), but
// equal cells do not make equal-looking logos: a cap on WIDTH renders a square
// glyph as a huge block beside a wordmark, and a cap on HEIGHT renders that
// same wordmark as a hairline of type. What reads as "the same weight" is
// roughly equal ink AREA, so each mark is given a box of the same area, shaped
// to its own aspect ratio, and only then clamped so nothing touches the cell's
// edges. A 5:1 wordmark lands at ~190×38, a square glyph at ~76×76.
const LOGO_AREA = 7200;
const LOGO_MAX_W = 230;
const LOGO_MAX_H = 76;
// A plated mark (the `plated` flag in the partners collection) ships with its
// own padding and background baked into the file, so the same area cap would
// render the ink inside it far too small. It gets a larger box and fills the
// cell's width.
const PLATE_SCALE = 2.1;

const opticalBox = (img: ImageMetadata, plated = false) => {
	const ratio = img.width && img.height ? img.width / img.height : 3;
	const area = LOGO_AREA * (plated ? PLATE_SCALE : 1);
	const maxW = plated ? 240 : LOGO_MAX_W;
	const maxH = plated ? 120 : LOGO_MAX_H;
	let height = Math.sqrt(area / ratio);
	let width = height * ratio;
	if (width > maxW) {
		width = maxW;
		height = width / ratio;
	}
	if (height > maxH) {
		height = maxH;
		width = height * ratio;
	}
	return { width: Math.round(width), height: Math.round(height) };
};

// One call site's worth of per-logo props: the optical box as custom
// properties, plus a srcset that matches it (an `w`-descriptor image needs
// `sizes` to state its real layout width, or the browser picks the wrong file).
const logoProps = (logo: string, plated = false) => {
	const img = logoFor(logo);
	const box = opticalBox(img, plated);
	const shared = {
		src: img,
		style: `--logo-w:${box.width}px;--logo-h:${box.height}px`,
	};
	return img.format === 'svg'
		? { ...shared, format: 'svg' as const, layout: 'none' as const }
		: {
				...shared,
				widths: [box.width, box.width * 2, box.width * 3],
				sizes: `${box.width}px`,
			};
};

const PRESENTATION_URL = 'https://canva.link/828fiq93km2hwds';
const FILIP = { name: 'Filip Goszler', role: 'Partnerships', email: 'filip@gug.cz' };

const tickerTopics = [
	'Reach Developers',
	'Sponsor a Track',
	'Brand Visibility',
	'Support the Community',
	'Hire Talent',
];
---

<BaseLayout
	title="Partners — DevFest.cz 2026"
	description="Back DevFest.cz 2026 — partner with the community-built developer conference in the Czech Republic."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'In good <span class="red">company.</span>'}
			lede="DevFest.cz is a non-profit, community-run conference. Our partners make it possible — funding the venue, the talks, and everything in between."
			seoHeading="Partner with DevFest.cz 2026"
			titleId="partners-title"
			focus="12% 50%"
		/>

		<Ticker items={tickerTopics} size="sm" />

		{wallRows.map((row) => (
			<section class="logo-wall" aria-labelledby={`${row.id}-partners-title`}>
				<div class="wall-inner">
					{/* Tier name alone at poster scale. Six sections each headed
					    "<Tier> partners" with the second word in red was the same
					    lockup six times down one page, so the heading is just the
					    name — the logos under it are the count. */}
					<div class="wall-head">
						<h2 id={`${row.id}-partners-title`} class="wall-title">
							{row.label}<span class="sr-only"> partners</span>
						</h2>
					</div>
					{/* The SAME grid module for every row — only the ground differs:
					    off-ladder marks ship dark (made for light backgrounds), so
					    their cells are cream (`logo-grid--plated`). */}
					<ul class={`logo-grid${row.plated ? ' logo-grid--plated' : ''}`}>
						{row.partners.map((p) => (
							<li class="logo-cell">
								<PartnerLogo partner={p} className="logo" imageProps={logoProps(p.logo, row.plated ? false : p.plated)} />
							</li>
						))}
					</ul>
				</div>
			</section>
		))}
		<!-- CLOSING STATEMENT — the page's one red field -->
		<Closer
			tone="accent"
			class="partners-cta"
			eyebrow="Get in touch"
			titleHtml={'Back the<br />next <span class="red">case</span>.'}
			titleId="partners-cta-title"
			note="Tell us what you’re after — brand reach, hiring, or backing the community — and we’ll find the tier that fits."
			actions={[
				{ href: PRESENTATION_URL, label: 'See partnership deck', external: true },
				{ href: `mailto:${FILIP.email}`, label: 'Email Filip', kind: 'ghost' },
			]}
		>
			<p class="partners-contact">
				<span class="contact-name">{FILIP.name} &mdash; {FILIP.role}</span>
				<a class="email-link" href={`mailto:${FILIP.email}`}>{FILIP.email}</a>
			</p>
		</Closer>
	</main>
</BaseLayout>

<style lang="scss">
	@use './partners';
</style>
