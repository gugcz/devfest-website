---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Closer from '../components/Closer.astro';
import { columnsFor, getActivePartnerTiers, getMediaPartners, getCommunityPartners } from '../lib/partners';

const activeTiers = await getActivePartnerTiers();

// Off-ladder rows, rendered below the tiers on the SAME wall — one plate
// treatment for every row now, ladder or not.
const plateRows = [
	{ id: 'media', label: 'Media', partners: await getMediaPartners() },
	{ id: 'community', label: 'Community', partners: await getCommunityPartners() },
].filter((row) => row.partners.length > 0);

// One row shape for the whole page: id, label, partners, and the column count
// that IS the tier signal (cell size encodes value — see `columnsFor`). No pad
// cells — a row that doesn't divide evenly re-flows and simply leaves the
// last line short, left-aligned by the grid itself.
const rows = [...activeTiers, ...plateRows].map((row) => {
	const cols = columnsFor(row.id, row.partners.length);
	// Mobile folds every multi-column row to 2-up (platinum stays 1-up). An
	// odd count in that grid staircases its last cell unless it spans both
	// columns — flagged here so the CSS only has to key off one attribute.
	const oddOnMobile = cols > 1 && row.partners.length % 2 !== 0;
	return { ...row, cols, oddOnMobile };
});

// ─── LOGO OPTIMISATION ─────────────────────────────────────────────────────
// The masters live in `src/assets/partners/<tier>/` so the build can resize
// them and emit modern formats (assets in `public/` are served untouched).
// The `partners` collection still stores plain path strings, so — same pattern
// as team.astro — we glob the sources and key them by filename.
const logoSources = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/**/*', {
	eager: true,
});
const logoByFile = new Map<string, ImageMetadata>(
	Object.entries(logoSources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
const logoFor = (logo: string): ImageMetadata =>
	logoByFile.get(logo.split('/').pop() as string) as ImageMetadata;

// SVG wordmarks stay vector — `format="svg"` makes astro:assets copy them
// through unchanged (rasterising a logo would be a downgrade). Every mark,
// SVG or raster, renders at its own intrinsic ratio: `.logo` in partners.scss
// clamps it with a per-tier `max-height` + `object-fit: contain`, so what
// makes every mark read as the same optical weight is the shared height
// ceiling, not a per-logo computed box.
const logoProps = (logo: string) => {
	const img = logoFor(logo);
	return img.format === 'svg'
		? { src: img, format: 'svg' as const, layout: 'none' as const }
		: { src: img, width: img.width, height: img.height };
};

const DECK_READY = true;
const PRESENTATION_URL = 'https://canva.link/828fiq93km2hwds';
const FILIP = { name: 'Filip Goszler', role: 'Partnerships', email: 'filip@gug.cz' };
---

<BaseLayout
	title="Partners — DevFest.cz 2026"
	description="Back DevFest.cz 2026 — partner with the community-built developer conference in the Czech Republic."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'In good <span class="red">company.</span>'}
			lede="DevFest.cz is a non-profit, community-run conference. Our partners make it possible — funding the venue, the talks, and everything in between."
			seoHeading="Partner with DevFest.cz 2026"
			titleId="partners-title"
			photo={false}
		/>

		{rows.map((row) => (
			<section class="logo-wall" aria-labelledby={`${row.id}-partners-title`}>
				<div class="wall-inner">
					{/* Tier name alone at poster scale — the heading is just the
					    name; the cell SIZE under it is the tier's weight, and the
					    label steps down with it (see `.wall-title` in partners.scss). */}
					<div class="wall-head">
						<h2 id={`${row.id}-partners-title`} class="wall-title" data-tier={row.id}>
							{row.label}<span class="sr-only"> partners</span>
						</h2>
					</div>
					<ul
						class="logo-grid"
						data-tier={row.id}
						data-cols={row.cols}
						data-odd={row.oddOnMobile ? 'true' : undefined}
						style={`--cols:${row.cols}`}
					>
						{row.partners.map((p) => (
							<li class="logo-cell">
								{p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
										<Image class={`logo${p.plated ? ' is-plated' : ''}`} alt={p.name} loading="lazy" {...logoProps(p.logo)} />
									</a>
								) : (
									<Image class={`logo${p.plated ? ' is-plated' : ''}`} alt={p.name} loading="lazy" {...logoProps(p.logo)} />
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		))}
		<Closer
			titleHtml="Back the next case."
			tone="plain"
			titleId="partners-cta-title"
			actions={[
				DECK_READY
					? { href: PRESENTATION_URL, label: 'See partnership deck', external: true }
					: { href: `mailto:${FILIP.email}`, label: 'Email Filip' },
			]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './partners';
</style>
