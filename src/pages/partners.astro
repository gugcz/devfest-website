---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import { getActivePartnerTiers, getMediaPartners, getCommunityPartners, type Partner } from '../lib/partners';

// Every logo wall on the page, top tier first: the ladder, then the two
// off-ladder rows — community, then media. One loop, one heading treatment
// for every tier; a logo's size comes from its rank (`CELLS`).
type Wall = { id: string; label: string; partners: Partner[] };
const walls: Wall[] = [
	...(await getActivePartnerTiers()),
	{ id: 'community', label: 'Community', partners: await getCommunityPartners() },
	{ id: 'media', label: 'Media', partners: await getMediaPartners() },
].filter((wall) => wall.partners.length > 0);

// Desktop reference box per tier, in px: the box size carries the rank. No
// cell is drawn; `opticalBox` sizes each logo as a share of it.
type Cell = { w: number; h: number };
const CELLS: Record<string, Cell> = {
	platinum: { w: 600, h: 300 },
	diamond: { w: 312, h: 190 },
	gold: { w: 246, h: 150 },
	silver: { w: 246, h: 150 },
	community: { w: 200, h: 110 },
	media: { w: 200, h: 110 },
};
const cellFor = (id: string): Cell => CELLS[id] ?? CELLS.gold;

// Marks that ship dark (made for a light ground). Nothing plates them on
// this page, so CSS inverts them (`.logo--dark-ink`) until light variants
// exist. Stopgap: belongs in the partners collection as a per-partner flag.
const DARK_INK = new Set(['dotekomanie.avif', 'whitewhalemedia.svg']);
const logoClass = (p: Partner) =>
	`logo${p.plated ? ' is-plated' : ''}${DARK_INK.has(p.logo.split('/').pop() as string) ? ' logo--dark-ink' : ''}`;

// ─── LOGO OPTIMISATION ─────────────────────────────────────────────────────
// The masters live in `src/assets/partners/<tier>/` so the build can resize
// them and emit modern formats (assets in `public/` are served untouched).
// The `partners` collection still stores plain path strings, so — same pattern
// as team.astro — we glob the sources and key them by filename.
const logoSources = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/**/*', {
	eager: true,
});
const logoByFile = new Map<string, ImageMetadata>(
	Object.entries(logoSources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
const logoFor = (logo: string): ImageMetadata =>
	logoByFile.get(logo.split('/').pop() as string) as ImageMetadata;

// SVG wordmarks stay vector (`format="svg"`); rasters get a srcset sized to
// their box.
//
// ─── OPTICAL NORMALISATION ────────────────────────────────────────────────
// Equal ink AREA reads as equal weight: each mark gets a box of the same
// area shaped to its ratio, as a share of its tier's cell (in a Gold cell a
// 5:1 wordmark lands ≈190×38, a square glyph ≈75×75).
const LOGO_AREA = 0.195;
const LOGO_MAX_W = 0.78;
const LOGO_MAX_H = 0.5;
// A plated mark (the `plated` flag in the partners collection) ships with its
// own padding and background baked into the file, so the same area cap would
// render the ink inside it far too small. It gets a larger box.
const PLATE_SCALE = 2.1;
const PLATE_MAX_W = 0.86;
const PLATE_MAX_H = 0.6;

const opticalBox = (img: ImageMetadata, cell: Cell, plated = false) => {
	const ratio = img.width && img.height ? img.width / img.height : 3;
	const area = cell.w * cell.h * LOGO_AREA * (plated ? PLATE_SCALE : 1);
	const maxW = cell.w * (plated ? PLATE_MAX_W : LOGO_MAX_W);
	const maxH = cell.h * (plated ? PLATE_MAX_H : LOGO_MAX_H);
	let height = Math.sqrt(area / ratio);
	let width = height * ratio;
	if (width > maxW) {
		width = maxW;
		height = width / ratio;
	}
	if (height > maxH) {
		height = maxH;
		width = height * ratio;
	}
	return { width: Math.round(width), height: Math.round(height) };
};

// One call site's worth of per-logo props: the optical box as custom
// properties, plus a srcset that matches it (an `w`-descriptor image needs
// `sizes` to state its real layout width, or the browser picks the wrong file).
const logoProps = (p: Partner, cell: Cell) => {
	const img = logoFor(p.logo);
	const box = opticalBox(img, cell, p.plated);
	const shared = {
		src: img,
		style: `--logo-w:${box.width / 16}rem;--logo-h:${box.height / 16}rem`,
	};
	return img.format === 'svg'
		? { ...shared, format: 'svg' as const, layout: 'none' as const }
		: {
				...shared,
				widths: [box.width, box.width * 2, box.width * 3],
				sizes: `${box.width}px`,
			};
};

const DECK_READY = true;
const PRESENTATION_URL = 'https://canva.link/828fiq93km2hwds';
const FILIP = { name: 'Filip Goszler', role: 'Partnerships', email: 'filip@gug.cz' };

---

<BaseLayout
	title="Partners — DevFest.cz 2026"
	description="Back DevFest.cz 2026 — partner with the community-built developer conference in the Czech Republic."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'In good company'}
			lede="DevFest.cz is a non-profit conference run by its community. The companies below pay for the venue and the day."
			seoHeading="Partner with DevFest.cz 2026"
			titleId="partners-title"
			plate="/gallery/devfest-2025-01.webp"
			focus="center"
		/>

		{walls.map((wall, i) => {
			const cell = cellFor(wall.id);
			return (
				<section
					class:list={[
						'logo-wall',
						{ 'logo-wall--lead': wall.id === 'platinum', 'logo-wall--first': i === 0, 'logo-wall--last': i === walls.length - 1 },
					]}
					aria-labelledby={`${wall.id}-partners-title`}
				>
					<div class="wall-inner">
						{/* One heading step for every tier: the logo size says the
						    rank, so no tier needs a poster head of its own. */}
						<h2 id={`${wall.id}-partners-title`} class="wall-title">
							{wall.label}<span class="sr-only"> partners</span>
						</h2>
						<ul class="logo-grid">
							{wall.partners.map((p) => (
								<li class="logo-item">
									{p.url ? (
										<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
											<Image class={logoClass(p)} alt={p.name} loading="lazy" {...logoProps(p, cell)} />
										</a>
									) : (
										<Image class={logoClass(p)} alt={p.name} loading="lazy" {...logoProps(p, cell)} />
									)}
								</li>
							))}
						</ul>
					</div>
				</section>
			);
		})}
		<!-- CLOSING STATEMENT — the page's one red field -->
		<section class="band band--accent partners-cta" aria-labelledby="partners-cta-title">
			<div class="band-inner closer">
				<div>
					<h2 id="partners-cta-title" class="display closer-title">
						Back the<br />next case.
					</h2>
				</div>

				<div class="closer-side">
					<p class="closer-note">
						Tell us what you&rsquo;re after, whether that is reach, hiring or backing
						the community, and we&rsquo;ll find the tier that fits.
					</p>

					<p class="partners-contact">
						<span class="contact-name">{FILIP.name} &mdash; {FILIP.role}</span>
						<a class="email-link" href={`mailto:${FILIP.email}`}>{FILIP.email}</a>
					</p>

					<div class="closer-actions">
						{DECK_READY ? (
							<a class="btn-primary" href={PRESENTATION_URL} target="_blank" rel="noopener noreferrer">
								See partnership deck
							</a>
						) : (
							<span class="partners-cta-soon" aria-disabled="true">
								<span class="partners-cta-label">Partnership deck</span>
								<span class="partners-cta-stamp" aria-hidden="true">Coming soon</span>
							</span>
						)}
						<a class="btn-ghost" href={`mailto:${FILIP.email}`}>Email Filip</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './partners';
</style>
