---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import { getActivePartnerTiers, getMediaPartners, getCommunityPartners } from '../lib/partners';

const activeTiers = await getActivePartnerTiers();

// Off-ladder rows, rendered below the tiers as cream logo plates. Same markup
// and styling for both — only the heading differs — so they share one loop.
const plateRows = [
	{ id: 'media', label: 'Media', partners: await getMediaPartners() },
	{ id: 'community', label: 'Community', partners: await getCommunityPartners() },
].filter((row) => row.partners.length > 0);

// ─── LOGO OPTIMISATION ─────────────────────────────────────────────────────
// The masters live in `src/assets/partners/<tier>/` so the build can resize
// them and emit modern formats (assets in `public/` are served untouched).
// The `partners` collection still stores plain path strings, so — same pattern
// as team.astro — we glob the sources and key them by filename.
const logoSources = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/**/*', {
	eager: true,
});
const logoByFile = new Map<string, ImageMetadata>(
	Object.entries(logoSources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
const logoFor = (logo: string): ImageMetadata =>
	logoByFile.get(logo.split('/').pop() as string) as ImageMetadata;

// SVG wordmarks stay vector — `format="svg"` makes astro:assets copy them
// through unchanged (rasterising a logo would be a downgrade); rasters get a
// real srcset. Widths cover the tile caps in partners.scss up to ~2× DPR.
const TIER_WIDTHS = [200, 300, 400, 600, 800];
const TIER_SIZES = '(max-width: 900px) 200px, 400px';
// A plated logo is laid out at the cell's full content width (see
// `.tier-logo.is-plated`), which is wider than a cut-out wordmark renders — and
// `sizes` is what fixes an `w`-descriptor image's layout width, so it has to
// describe the plate, not the wordmark, or the plate renders at the wordmark's
// width no matter what the CSS says.
const TIER_SIZES_PLATED = '(max-width: 900px) 78vw, 260px';
const PLATE_WIDTHS = [160, 260, 320, 520];
const PLATE_SIZES = '(max-width: 900px) 160px, 260px';

const sizing = (img: ImageMetadata, widths: number[], sizes: string) =>
	img.format === 'svg'
		? ({ format: 'svg', layout: 'none' } as const)
		: ({ widths, sizes } as const);

const DECK_READY = true;
const PRESENTATION_URL = 'https://canva.link/828fiq93km2hwds';
const FILIP = { name: 'Filip Goszler', role: 'Partnerships', email: 'filip@gug.cz' };

const tickerTopics = [
	'Reach Developers',
	'Sponsor a Track',
	'Brand Visibility',
	'Support the Community',
	'Hire Talent',
];
---

<BaseLayout
	title="Partners — DevFest.cz 2026"
	description="Back DevFest.cz 2026 — partner with the community-built developer conference in the Czech Republic."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'In good <span class="red">company.</span>'}
			lede="DevFest.cz is a non-profit, community-run conference. Our partners make it possible — funding the venue, the talks, and everything in between."
			seoHeading="Partner with DevFest.cz 2026"
			titleId="partners-title"
			focus="12% 50%"
		/>

		<Ticker items={tickerTopics} size="sm" />

		{activeTiers.map((tier) => (
			<section class={`tier-partners tier-${tier.id}`} aria-labelledby={`${tier.id}-partners-title`}>
				<div class="tier-inner">
					{/* Tier name alone at poster scale. Six sections each headed
					    "<Tier> partners" with the second word in red was the same
					    lockup six times down one page, so the heading is just the
					    name — the logos under it are the count. */}
					<div class="tier-head">
						<h2 id={`${tier.id}-partners-title`} class="tier-title">
							{tier.label}<span class="sr-only"> partners</span>
						</h2>
					</div>
					<ul class="tier-grid">
						{tier.partners.map((p) => (
							<li class="tier-item">
								{p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
										<Image class={`tier-logo${p.plated ? ' is-plated' : ''}`} src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), TIER_WIDTHS, p.plated ? TIER_SIZES_PLATED : TIER_SIZES)} />
									</a>
								) : (
									<Image class={`tier-logo${p.plated ? ' is-plated' : ''}`} src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), TIER_WIDTHS, p.plated ? TIER_SIZES_PLATED : TIER_SIZES)} />
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		))}

		{plateRows.map((row) => (
			<section class="plate-partners" aria-labelledby={`${row.id}-partners-title`}>
				<div class="plate-inner">
					<div class="plate-head">
						<h2 id={`${row.id}-partners-title`} class="plate-title">
							{row.label}<span class="sr-only"> partners</span>
						</h2>
					</div>
					<ul class="plate-grid">
						{row.partners.map((p) => (
							<li class="plate-item">
								{p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
										<Image src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), PLATE_WIDTHS, PLATE_SIZES)} />
									</a>
								) : (
									<Image src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), PLATE_WIDTHS, PLATE_SIZES)} />
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		))}
		<!-- CLOSING STATEMENT — the page's one red field -->
		<section class="band band--accent" aria-labelledby="partners-cta-title">
			<div class="band-inner closer reveal">
				<div>
					<p class="eyebrow closer-eyebrow">Get in touch</p>
					<h2 id="partners-cta-title" class="display closer-title">
						Back the<br />next <span class="red">case</span>.
					</h2>
				</div>

				<div class="closer-side">
					<p class="closer-note">
						Tell us what you&rsquo;re after &mdash; brand reach, hiring, or backing the
						community &mdash; and we&rsquo;ll find the tier that fits.
					</p>

					<p class="partners-contact">
						<span class="contact-name">{FILIP.name} &mdash; {FILIP.role}</span>
						<a class="email-link" href={`mailto:${FILIP.email}`}>{FILIP.email}</a>
					</p>

					<div class="closer-actions">
						{DECK_READY ? (
							<a class="btn-primary" href={PRESENTATION_URL} target="_blank" rel="noopener noreferrer">
								See partnership deck
							</a>
						) : (
							<span class="partners-cta-soon" aria-disabled="true">
								<span class="partners-cta-label">Partnership deck</span>
								<span class="partners-cta-stamp" aria-hidden="true">Coming soon</span>
							</span>
						)}
						<a class="btn-ghost" href={`mailto:${FILIP.email}`}>Email Filip</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './partners';
</style>
