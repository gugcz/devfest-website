---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import filipPhoto from '../assets/team/filip-goszler-bw.webp';
import {
	getActivePartnerTiers,
	getMediaPartners,
	getCommunityPartners,
	getTravelPartners,
	partnerLogo,
	type Partner,
} from '../lib/partners';

// Every logo wall on the page, top tier first: the ladder, then the two
// off-ladder rows — community, travel, then media. Each tier is a plain label and its
// marks on the table; a logo's size comes from its tier's reference box
// (`partnerLogo` in src/lib/partners.ts).
type Wall = { id: string; label: string; partners: Partner[] };
const walls: Wall[] = [
	...(await getActivePartnerTiers()),
	{ id: 'community', label: 'Community', partners: await getCommunityPartners() },
	{ id: 'travel', label: 'Travel', partners: await getTravelPartners() },
	{ id: 'media', label: 'Media', partners: await getMediaPartners() },
].filter((wall) => wall.partners.length > 0);

// How much larger than its reference box a tier sets on this page. Passed to
// `partnerLogo` (not a CSS `--logo-scale`) so the srcset is cut for the size
// the mark actually renders at. Each scaled box fits its grid cell at 1440, so
// no mark is clamped by its cell and every mark in a tier keeps the same ink
// area; each tier's box stays smaller than the one above it, so the rank reads
// from size alone. The narrower widths step whole tiers down in partners.scss.
const TIER_SCALE: Record<string, number> = {
	platinum: 1.5,
	diamond: 1.5,
	gold: 1.28,
	silver: 1.28,
	community: 1.2,
	travel: 1.2,
	media: 1.2,
};

const DECK_READY = true;
const PRESENTATION_URL = 'https://canva.link/828fiq93km2hwds';
const FILIP = { name: 'Filip Goszler', role: 'Partnerships', email: 'filip@gug.cz' };
---

<BaseLayout
	title="Partners — DevFest.cz 2026"
	description="Back DevFest.cz 2026 — partner with the community-built developer conference in the Czech Republic."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Partners'}
			lede="DevFest.cz is a non-profit conference run by its community. The companies below pay for the venue and the day."
			seoHeading="Partner with DevFest.cz 2026"
			titleId="partners-title"
		/>

		<div class="tiers">
			<div class="tiers-inner">
				{walls.map((wall) => (
					<section class:list={['tier', `tier-${wall.id}`]} aria-labelledby={`${wall.id}-partners-title`}>
						<h2 id={`${wall.id}-partners-title`} class="tier-label">
							{wall.label}<span class="sr-only"> partners</span>
						</h2>
						<div class="tier-body">
							<ul class="wall">
								{wall.partners.map((p) => {
									const { props } = partnerLogo(p, wall.id, TIER_SCALE[wall.id] ?? 1);
									return (
										<li class="logo-item">
											{p.url ? (
												<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
													<Image class={`logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
												</a>
											) : (
												<Image class={`logo logo--${p.mono}`} alt={p.name} loading="lazy" {...props} />
											)}
										</li>
									);
								})}
							</ul>
						</div>
					</section>
				))}
			</div>
		</div>

		{/* CLOSER — the title on the table, Filip's card beside it; the deck
		     button is the page's one red. */}
		<section class="partners-cta" aria-labelledby="partners-cta-title">
			<div class="cta-inner">
				<h2 id="partners-cta-title" class="display cta-title">
					Become a<br />partner
				</h2>

				<div class="paper cta-card">
					<p class="paper-edge cta-edge"><span>2026</span></p>
					<div class="cta-body">
						<div class="paper-photo cta-mug">
							<Image src={filipPhoto} alt={FILIP.name} widths={[120, 240]} sizes="120px" loading="lazy" />
						</div>
						<div>
							<p class="cta-say">
								Tell us what you want from the day and we&rsquo;ll find the tier that fits.
							</p>
							<p class="cta-who">
								<span class="cta-name">{FILIP.name}</span>
								<span class="cta-role">{FILIP.role}</span>
								<a class="cta-mail" href={`mailto:${FILIP.email}`}>{FILIP.email}</a>
							</p>
						</div>
					</div>

					<div class="cta-actions">
						{DECK_READY ? (
							<a class="btn-primary" href={PRESENTATION_URL} target="_blank" rel="noopener noreferrer">
								See partnership deck
							</a>
						) : (
							<span class="partners-cta-soon" aria-disabled="true">
								<span>Partnership deck</span>
								<span class="partners-cta-stamp">Coming soon</span>
							</span>
						)}
						<a class="action cta-action" href={`mailto:${FILIP.email}`}>Email Filip</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use './partners';
</style>
