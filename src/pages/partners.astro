---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import { getPartnerTiers, getMediaPartners } from '../lib/partners';

const activeTiers = (await getPartnerTiers()).filter((t) => t.partners.length > 0);
const mediaPartners = await getMediaPartners();

// ─── LOGO OPTIMISATION ─────────────────────────────────────────────────────
// The masters live in `src/assets/partners/<tier>/` so the build can resize
// them and emit modern formats (assets in `public/` are served untouched).
// The `partners` collection still stores plain path strings, so — same pattern
// as team.astro — we glob the sources and key them by filename.
const logoSources = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/**/*', {
	eager: true,
});
const logoByFile = new Map<string, ImageMetadata>(
	Object.entries(logoSources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
const logoFor = (logo: string): ImageMetadata =>
	logoByFile.get(logo.split('/').pop() as string) as ImageMetadata;

// SVG wordmarks stay vector — `format="svg"` makes astro:assets copy them
// through unchanged (rasterising a logo would be a downgrade); rasters get a
// real srcset. Widths cover the tile caps in partners.scss up to ~2× DPR.
const TIER_WIDTHS = [200, 300, 400, 600, 800];
const TIER_SIZES = '(max-width: 900px) 200px, 400px';
const MEDIA_WIDTHS = [160, 260, 320, 520];
const MEDIA_SIZES = '(max-width: 900px) 160px, 260px';

const sizing = (img: ImageMetadata, widths: number[], sizes: string) =>
	img.format === 'svg'
		? ({ format: 'svg', layout: 'none' } as const)
		: ({ widths, sizes } as const);

const DECK_READY = true;
const PRESENTATION_URL = 'https://canva.link/828fiq93km2hwds';
const FILIP = { name: 'Filip Goszler', role: 'Partnerships', email: 'filip@gug.cz' };

const tickerTopics = [
	'Reach Developers',
	'Sponsor a Track',
	'Brand Visibility',
	'Support the Community',
	'Hire Talent',
];
---

<BaseLayout
	title="Partners — DevFest.cz 2026"
	description="Back DevFest.cz 2026 — partner with the community-built developer conference in the Czech Republic."
>
	<main class="partners-page">
		<SubpageHero
			label="Partners"
			titleHtml={'In good <span class="red">company</span>.'}
			lede="DevFest.cz is a non-profit, community-run conference. Our partners make it possible — funding the venue, the talks, and everything in between."
			seoHeading="Partner with DevFest.cz 2026"
			titleId="partners-title"
		/>

		<Ticker items={tickerTopics} fontSize="0.7rem" />

		{activeTiers.map((tier) => (
			<section class={`tier-partners tier-${tier.id}`} aria-labelledby={`${tier.id}-partners-title`}>
				<div class="tier-inner">
					<div class="tier-head">
						<h2 id={`${tier.id}-partners-title`} class="tier-title">
							{tier.label} <span class="red">{tier.partners.length === 1 ? 'partner' : 'partners'}</span>
						</h2>
					</div>
					<ul class="tier-grid">
						{tier.partners.map((p) => (
							<li class="tier-item">
								{p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
										<Image class="tier-logo" src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), TIER_WIDTHS, TIER_SIZES)} />
									</a>
								) : (
									<Image class="tier-logo" src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), TIER_WIDTHS, TIER_SIZES)} />
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		))}

		{mediaPartners.length > 0 && (
			<section class="media-partners" aria-labelledby="media-partners-title">
				<div class="media-inner">
					<div class="media-head">
						<h2 id="media-partners-title" class="media-title">
							Media <span class="red">partners</span>
						</h2>
					</div>
					<ul class="media-grid">
						{mediaPartners.map((p) => (
							<li class="media-item">
								{p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
										<Image src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), MEDIA_WIDTHS, MEDIA_SIZES)} />
									</a>
								) : (
									<Image src={logoFor(p.logo)} alt={p.name} loading="lazy" {...sizing(logoFor(p.logo), MEDIA_WIDTHS, MEDIA_SIZES)} />
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		)}
		<!-- BODY -->
		<section class="partners-body" aria-labelledby="partners-cta-title">
			<div class="partners-inner">
				<span class="eyebrow">Get in touch</span>
				<div class="partners-block reveal">
					<div class="partners-block-main">
						<span class="card-label">{FILIP.role}</span>
						<h2 id="partners-cta-title" class="card-title">Become a partner</h2>
						<p class="card-desc">
							Tell us what you're after — brand reach, hiring, or backing the
							community — and we'll find the tier that fits.
						</p>
					</div>

					<div class="partners-block-action">
						<div class="partners-contact">
							<span class="contact-name">{FILIP.name}</span>
							<a class="email-link" href={`mailto:${FILIP.email}`}>{FILIP.email}</a>
						</div>

						<div class="partners-cta-wrap">
							{DECK_READY ? (
								<a class="btn-primary partners-cta" href={PRESENTATION_URL} target="_blank" rel="noopener noreferrer">
									<span>See partnership deck</span>
									<span class="partners-cta-arrow" aria-hidden="true">→</span>
								</a>
							) : (
								<span class="partners-cta-soon" aria-disabled="true">
									<span class="partners-cta-label">Partnership deck</span>
									<span class="partners-cta-stamp" aria-hidden="true">Coming soon</span>
								</span>
							)}
							<p class="partners-cta-note">
								{DECK_READY
									? 'Tiers, perks, and audience stats in one PDF.'
									: 'Brochure coming soon. In the meantime, email Filip.'}
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

	</main>
</BaseLayout>

<style lang="scss">
	@use './partners';
</style>
