---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import Ticker from '../components/Ticker.astro';
import Desk from '../components/Desk.astro';
import Closer from '../components/Closer.astro';
import { fetchOg } from '../lib/og';
import { EVENT_TOPICS } from '../lib/ticker';

// A media mention is just a URL. Outlet, title, image, description and date
// are all read from the article's Open Graph tags at build time. Any field set
// here wins over the scraped value — use that to pin a source that blocks
// scraping or ships a poor preview.
interface MediaMention {
	href: string;
	outlet?: string;
	title?: string;
	date?: string; // ISO — overrides article:published_time
	dateLabel?: string;
	image?: string;
	description?: string;
}

interface ResolvedMention {
	href: string;
	outlet: string;
	title: string;
	date?: string;
	dateLabel?: string;
	image?: string;
	description?: string;
}

const mediaCoverageRaw: readonly MediaMention[] = [
	{ href: 'https://smartmania.cz/pripad-se-posouva-devfest-cz-2026-odhaluje-prvni-recniky-a-meni-cenu-vstupenek/' },
	{ href: 'https://dotekomanie.cz/2026/06/pripad-otevren-devfest-cz-2026-spousti-prodej-vstupenek-a-odhaluje-detektivni-tema/' },
];

const DATE_FMT = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

function hostname(url: string): string {
	try {
		return new URL(url).hostname.replace(/^www\./, '');
	} catch {
		return url;
	}
}

// Resolve each entry from its Open Graph tags at build time. fetchOg never
// throws (returns {} on failure), so a dead/blocked source degrades to a
// hostname + bare-link card instead of breaking the build.
const mediaCoverage: ResolvedMention[] = await Promise.all(
	mediaCoverageRaw.map(async (m): Promise<ResolvedMention> => {
		const og = await fetchOg(m.href);
		const iso = m.date ?? og.publishedTime;
		let dateLabel = m.dateLabel;
		if (!dateLabel && iso) {
			const d = new Date(iso);
			if (!Number.isNaN(d.getTime())) dateLabel = DATE_FMT.format(d);
		}
		return {
			href: m.href,
			outlet: m.outlet ?? og.siteName ?? hostname(m.href),
			title: m.title ?? og.title ?? m.href,
			date: iso ? iso.slice(0, 10) : undefined,
			dateLabel,
			image: m.image ?? og.image,
			description: m.description ?? og.description,
		};
	})
);

---

<BaseLayout
	title="Press — DevFest.cz 2026"
	description="Press room for DevFest.cz 2026 — media enquiries, press kit, official releases, and coverage of Prague's developer conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'In the <span class="red">news.</span>'}
			lede="Covering DevFest.cz 2026? Find the key facts, our logos, and someone to talk to. We're glad to help journalists, bloggers, and media partners."
			seoHeading="DevFest.cz 2026 Press & Media"
			titleId="press-title"
		/>

		<Ticker items={EVENT_TOPICS} size="sm" />


		<!-- IN THE PRESS + DESK + PRESS KIT -->
		<section class="band band--lit" aria-label="Press desk and press kit">
			<div class="band-inner press-inner">
								<!-- MEDIA COVERAGE -->
				<section class="press-section" aria-labelledby="coverage-heading">
					<header class="section-head">
						<h2 id="coverage-heading" class="section-title">In the press</h2>
					</header>

					{mediaCoverage.length > 0 ? (
						<ul class="field coverage-list reveal">
							{mediaCoverage.map((m) => (
								<li class="coverage-row">
									<a class="field-row field-row--link coverage-card" href={m.href} target="_blank" rel="noopener noreferrer">
										{m.image && (
											<span class="coverage-thumb">
												<img src={m.image} alt="" loading="lazy" decoding="async" width="400" height="225" />
											</span>
										)}
										<span class="coverage-text">
											<span class="coverage-outlet">{m.outlet}</span>
											<span class="coverage-title">{m.title}</span>
											{m.description && <span class="coverage-desc">{m.description}</span>}
											<span class="coverage-meta">
												<span class="coverage-read">
													Read article
													<span class="coverage-arrow" aria-hidden="true">↗</span>
												</span>
												{m.dateLabel && <time class="coverage-date" datetime={m.date}>{m.dateLabel}</time>}
											</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="empty-state" role="status">
							<span class="empty-stamp" aria-hidden="true">No coverage yet</span>
							<p class="empty-line">
								Coverage of DevFest.cz 2026 will appear here. Wrote about us?
								Send us the link.
							</p>
						</div>
					)}
				</section>
					<!-- DESK: MEDIA ENQUIRIES + PRESS KIT -->
					<section class="press-section" aria-labelledby="desk-heading">
						<header class="section-head">
							<h2 id="desk-heading" class="section-title">Press desk</h2>
						</header>
						<div class="field desk-grid reveal">
							<Desk
								label="Media enquiries"
								title="Talk to us"
								titleId="enquiries-heading"
								level={3}
								desc="Interviews, quotes, press passes, fact-checks, and media partnerships."
								contacts={[{ name: 'Press desk', email: 'devfest@gug.cz' }]}
							/>
							<Desk
								label="Press kit"
								title="Logos & wordmarks"
								titleId="presskit-heading"
								level={3}
								desc="Logos and wordmarks for the 2026 edition. Please keep the logo intact and give it room to breathe."
								action={{ href: '/press/downloads', label: 'Open the press kit' }}
							/>
						</div>
					</section>

			</div>
		</section>

		<Closer
			eyebrow="Press kit"
			titleHtml={'Take the<br /><span class="red">assets</span>.'}
			note="Logos and wordmarks for the 2026 edition, ready to drop into a story."
			tone="accent"
			titleId="press-closer"
			actions={[{ href: '/press/downloads', label: 'Open the press kit' }, { href: 'mailto:devfest@gug.cz', label: 'Email the desk', kind: 'ghost' }]}
		/>
	</main>
</BaseLayout>

<style lang="scss">
	@use './press';
</style>
