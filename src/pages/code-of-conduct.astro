---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';

// The full text lives in the CoC team's Google Doc; this page is the one-pager.
const FULL_COC_URL =
	'https://docs.google.com/document/d/16n7_UlJMYUNeCAsSTMxq9tp9yOq2SDppzulPsvhZYak/preview';

// The two halves the hero promises, pinned beside the text.
const SECTIONS = [
	{ id: 'short-version', title: 'The short version' },
	{ id: 'who-to-talk-to', title: 'Who to talk to' },
];
---

<BaseLayout
	title="Code of Conduct — DevFest.cz 2026"
	description="Code of Conduct for DevFest.cz 2026 — the short version, and who to talk to at the conference."
>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Code of<br />Conduct'}
			lede="The short version, and who to talk to at the conference."
			seoHeading="DevFest.cz 2026 Code of Conduct"
			titleId="coc-title"
			photo={false}
		/>

		<div class="band band--lit">
			<div class="band-inner reading">
				<nav class="reading-index" aria-label="Contents">
					<p class="reading-index-label">Contents</p>
					<ol role="list">
						{SECTIONS.map(({ id, title }, i) => (
							<li>
								<a href={`#${id}`}>
									<span class="reading-index-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
									<span>{title}</span>
								</a>
							</li>
						))}
					</ol>
				</nav>

				<div class="policy">
					<section id="short-version">
						<h2>The short version</h2>
						<p>
							DevFest.cz is a community event where we strive to create safer and welcoming
							spaces for community members to learn from each other. Oppressive or harassing
							language or behaviour is not allowed. If you are asked to stop, you will stop
							immediately. The full Code of Conduct is there to help you understand what this
							means in practice &mdash; <a
								href={FULL_COC_URL}
								target="_blank"
								rel="noopener noreferrer">you can find it here</a
							>.
						</p>
					</section>

					<section id="who-to-talk-to">
						<h2>Who to talk to</h2>
						<p>
							If you see or experience something that is or might be a violation of the Code of
							Conduct, please reach out to the organisers or directly to the Code of Conduct
							Listener.
						</p>
						{/* The listener as a typed card: the one contact a visitor
						    may need in a hurry, so it reads at a glance. */}
						<div class="paper listener">
							<span class="tape">Code of Conduct Listener</span>
							<p class="listener-name">Eliška Čejpová</p>
							<ul class="listener-lines" role="list">
								<li>
									<a class="listener-link listener-link--tel" href="tel:+420728409551">+420&#160;728&#160;409&#160;551</a>
								</li>
								<li>
									<a class="listener-link" href="mailto:eliska.cejpova@gug.cz">eliska.cejpova@gug.cz</a>
								</li>
							</ul>
						</div>
					</section>
				</div>
			</div>
		</div>
	</main>
</BaseLayout>

<style lang="scss">
	// Same reading column as the privacy policy.
	@use './privacy-policy';
</style>
