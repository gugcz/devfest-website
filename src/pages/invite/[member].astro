---
// ─── PERSONAL INVITATION ──────────────────────────────────────────────────
// One unlisted page per team member: `/invite/<team.json id>`. A member shares
// their own link with their own people; the page speaks in their voice and
// carries a single action.
//
// UNLISTED, and all three parts of that matter:
//   1. `noindex` (BaseLayout also drops the canonical + JSON-LD for it),
//   2. excluded from the sitemap (the filter in `astro.config.mjs`),
//   3. linked from NOWHERE on the site — do not add these to the menu, the
//      footer or `/team`. A link anywhere makes the "secret" cosmetic.
// It is not access control (the URLs are guessable and the content isn't
// sensitive) — it is what keeps the page from reading as public marketing.
//
// Visual direction B ("The Plate"), approved 3 Sep 2026: the portrait owns the
// right half of the frame and the black-and-white → colour bleed is the page's
// ONLY effect. Type never sits on the face — on desktop the plate is feathered
// away from the text column; on a phone there is no side-by-side frame, so the
// scrim does that job instead. That scrim is a legibility requirement, not a
// finish (see the media query below).
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ticker from '../../components/Ticker.astro';
import Closer from '../../components/Closer.astro';
import InviteCta from '../../components/InviteCta.tsx';
import { EVENT_TOPICS } from '../../lib/ticker';
import { INVITE_EVENT, inviteCopy } from '../../lib/invite';

export async function getStaticPaths() {
	const team = await getCollection('team');
	return team.map((entry) => ({
		// The collection key is the `id` field in `src/content/team.json`, which
		// is already a slug — the invite URL and the roster stay in one place.
		params: { member: entry.id },
		props: { slug: entry.id, member: entry.data },
	}));
}

const { slug, member } = Astro.props;
const copy = inviteCopy(member);

// Same optimisation path as `/team`: the masters live in `src/assets/team` so
// the build can emit sized AVIF variants. Here the plate is full-bleed rather
// than a card, so the widths go up accordingly.
const sources = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.webp', {
	eager: true,
});
const sourceByFile = new Map<string, ImageMetadata>(
	Object.entries(sources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
// The masters in `src/assets/team` are 700×875, so nothing wider can be
// emitted — a desktop plate is that 700px upscaled across 62% of the frame, and
// asking for 1080/1440/1800 only produced the same single 700w candidate. The
// widths below are therefore SMALLER ones, which is the saving actually
// available: with the `sizes` below, a 1× phone takes a 350/525w file instead
// of the full plate. A sharper desktop plate needs new masters, not new widths.
const PLATE_WIDTHS = [350, 525, 700];
const plate = async (file?: string) => {
	if (!file) return undefined;
	const src = sourceByFile.get(file.split('/').pop() as string);
	if (!src) return undefined;
	return getImage({ src, widths: PLATE_WIDTHS, format: 'avif' });
};
const base = await plate(member.photo);
const color = await plate(member.photoColor ?? member.photo);
---

<BaseLayout
	title={`${copy.titleFlat} — DevFest.cz 2026`}
	description={`A personal invitation to DevFest.cz 2026 from ${member.name}. ${INVITE_EVENT.date}, ${INVITE_EVENT.city}.`}
	noindex
>
	<main class="page-stack">
		<section class="invite scene" aria-labelledby="invite-title" data-bleed>
			{base && (
				<div class="invite-plate" aria-hidden="true">
					{/* The base plate is the LCP element on this page — it is the page.
					    Eager and high priority; the colour layer that fades over it is
					    the enhancement and must not compete for the same bandwidth. */}
					<img
						class="plate-base"
						src={base.src}
						srcset={base.srcSet.attribute}
						sizes="(max-width: 860px) 100vw, 62vw"
						alt=""
						width="700"
						height="875"
						fetchpriority="high"
						decoding="async"
					/>
					{color && (
						<img
							class="plate-color"
							src={color.src}
							srcset={color.srcSet.attribute}
							sizes="(max-width: 860px) 100vw, 62vw"
							alt=""
							width="700"
							height="875"
							fetchpriority="low"
							decoding="async"
						/>
					)}
				</div>
			)}
			<div class="scene-vignette" aria-hidden="true"></div>

			<div class="band-inner">
				<div class="invite-content">
					<p class="eyebrow">{member.alias}{member.role ? ` · ${member.role}` : ''}</p>
					<h1 id="invite-title" class="display invite-title" set:html={copy.titleHtml} />
					<p class="invite-lede">{copy.body[0]} {copy.body[1]}</p>
					<div class="invite-actions">
						<InviteCta
							client:load
							memberId={slug}
							memberName={member.name}
							label={copy.cta}
						/>
						<span class="invite-meta">{INVITE_EVENT.stamp}</span>
					</div>
				</div>
			</div>
		</section>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band" aria-label="From the invitation">
			<div class="band-inner invite-note">
				<p>{copy.body[2]}</p>
				{/* The one line that differs between the eleven pages. */}
				<p class="invite-quote">“{copy.roleLine}”<br /><span>— {member.name}</span></p>
			</div>
		</section>

		<Closer
			eyebrow="The list closes"
			titleHtml={'Take the <span class="red">ticket.</span>'}
			note="Waves move and the room is one day only."
			tone="accent"
			actions={[
				{ href: '/sessions', label: "See who's speaking", kind: 'ghost' },
				{ href: '/team', label: 'Meet the crew', kind: 'ghost' },
			]}
		>
			{/* The repeat of the page's one action, as the same tracked control —
			    a plain link here would leave a click GA4 cannot attribute. */}
			<InviteCta
				slot="actions"
				client:visible
				memberId={slug}
				memberName={member.name}
				label={copy.cta}
			/>
		</Closer>
	</main>
</BaseLayout>

<style lang="scss">
	// The photograph owns the right half of the frame and is feathered into the
	// page black on its left edge; the type sits on that black, never on a face.
	.invite {
		position: relative;
		min-height: 92svh;
		display: flex;
		align-items: center;
		overflow: hidden;
		isolation: isolate;
	}

	.invite-plate {
		position: absolute;
		inset: 0 0 0 38%;
		z-index: -2;
		mask-image: linear-gradient(90deg, transparent 0%, #000 26%, #000 100%);

		img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 42% 18%;
		}

		.plate-base {
			opacity: 0.9;
		}

		.plate-color {
			opacity: 0;
			transition: opacity 1.4s ease-out;
			mask-image: radial-gradient(circle at 54% 30%, #000 0%, rgba(0, 0, 0, 0.55) 46%, transparent 72%);
		}
	}

	.invite.is-lit .plate-color {
		opacity: 1;
	}

	// The bleed is the page's only effect, so it is the only thing to reduce:
	// the colour still arrives (it is the point of the page), it just arrives
	// without the fade.
	@media (prefers-reduced-motion: reduce) {
		.invite-plate .plate-color {
			transition: none;
		}
	}

	// Vertical settle so the bottom of the frame closes on page black.
	.invite::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, rgba(5, 5, 5, 0.55) 0%, rgba(5, 5, 5, 0) 26%, rgba(5, 5, 5, 0.6) 82%, #050505 100%);
	}

	// The section is a flex container, so the shared container must be told to
	// take the full width — otherwise it shrinks to the content and centres.
	.invite > :global(.band-inner) {
		width: 100%;
		padding-inline: var(--gutter);
	}

	.invite-content {
		padding-block: clamp(3rem, 7vw, 5rem);
		max-width: 30rem;
	}

	.invite-title {
		font-size: clamp(2.6rem, 5.4vw, 5rem);
		margin: 0.3em 0 0;
	}

	.invite-lede {
		font-family: var(--font-special-elite);
		font-size: var(--fs-body);
		line-height: 1.75;
		max-width: 38ch;
		color: rgba(240, 237, 230, 0.86);
		margin-top: clamp(1.25rem, 2vw, 1.75rem);
	}

	.invite-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
	}

	.invite-meta {
		font-family: var(--font-jetbrains-mono);
		font-size: var(--fs-label-lg);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(240, 237, 230, 0.7);
	}

	.invite-note {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		gap: clamp(2rem, 5vw, 5rem);
		padding-block: clamp(2.5rem, 4.5vw, 4rem);
		font-family: var(--font-special-elite);
		font-size: var(--fs-body);
		line-height: 1.8;
	}

	.invite-quote {
		font-family: var(--font-jetbrains-mono);
		font-size: var(--fs-ui);
		line-height: 1.7;
		color: rgba(240, 237, 230, 0.72);

		span {
			color: rgba(240, 237, 230, 0.5);
		}
	}

	@media (max-width: 860px) {
		// On a phone the plate goes back to full-bleed behind the type, with a
		// heavier scrim: there is no room for a side-by-side frame.
		.invite-plate {
			inset: 0;
			mask-image: none;
		}

		.invite-plate .plate-base {
			opacity: 0.5;
		}

		// No side-by-side frame to keep the type off the face, so the scrim has
		// to do it: a heavy top-down wash over the read zone. This is a
		// legibility condition — the lede and the CTA sit directly over the
		// photograph here. Do not lighten it.
		.invite::after {
			background: linear-gradient(180deg, rgba(5, 5, 5, 0.88) 0%, rgba(5, 5, 5, 0.82) 46%, rgba(5, 5, 5, 0.7) 68%, #050505 100%);
		}

		.invite-content {
			max-width: none;
		}

		.invite-note {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// The one effect on the page: the plate settles, then bleeds into colour.
	// Enhancement only — with no JS the page shows the black-and-white plate,
	// which is the same photograph `/team` shows at rest.
	//
	// Bundled module scripts run once per document, but <ClientRouter /> swaps
	// the page on every soft navigation — so this runs on `astro:page-load`
	// (which fires on the initial load too). Without it, arriving here from
	// another page leaves the plate black and white forever.
	document.addEventListener('astro:page-load', () => {
		const scene = document.querySelector('[data-bleed]');
		if (scene) requestAnimationFrame(() => setTimeout(() => scene.classList.add('is-lit'), 260));
	});
</script>
