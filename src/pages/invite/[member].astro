---
// ─── PERSONAL INVITATION ──────────────────────────────────────────────────
// One unlisted page per team member: `/invite/<team.json id>`. UNLISTED =
// `noindex` + out of the sitemap + linked from NOWHERE (not access control).
// Visual direction B ("The Plate"): portrait owns the right half, B&W →
// colour bleed is the ONLY effect. Type never sits on the face; the phone
// scrim is a legibility requirement, not a finish. See .claude/rules/invite.md.
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ticker from '../../components/Ticker.astro';
import Closer from '../../components/Closer.astro';
import InviteCta from '../../components/InviteCta.tsx';
import { EVENT_TOPICS } from '../../lib/ticker';
import { INVITE_EVENT, inviteCopy } from '../../lib/invite';
import { ogCardVersion } from '../../lib/og-version';

export async function getStaticPaths() {
	const team = await getCollection('team');
	return team.map((entry) => ({
		// The collection key is the `id` field in `src/content/team.json`, which
		// is already a slug — the invite URL and the roster stay in one place.
		params: { member: entry.id },
		props: { slug: entry.id, member: entry.data },
	}));
}

const { slug, member } = Astro.props;
const copy = inviteCopy(member);

// Defaults to production so a plain `npm run build` still emits an unfurl
// that resolves — the OG image only exists once the built PNG is deployed,
// so pointing this at a preview build's own origin is opt-in, for verifying
// the card on that channel before merge (see the issue thread on DEVF-45).
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://devfest.cz';
// Versioned so Slack (and any other cache honouring the 1-year `max-age`
// below) sees a changed card instead of replaying its first unfurl forever —
// see `src/lib/og-version.ts`.
const ogImageUrl = new URL(
	`/og/invite/${slug}.jpg?v=${ogCardVersion(member)}`,
	SITE_URL
).href;

// Same optimisation path as `/team`: the masters live in `src/assets/team` so
// the build can emit sized AVIF variants. Here the plate is full-bleed rather
// than a card, so the widths go up accordingly.
const sources = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.webp', {
	eager: true,
});
const sourceByFile = new Map<string, ImageMetadata>(
	Object.entries(sources).map(([path, mod]) => [path.split('/').pop() as string, mod.default])
);
// Masters in `src/assets/team` are 700×875, so nothing wider can be emitted.
// The widths below are SMALLER ones — a 1× phone takes a 350/525w file
// instead of the full plate. A sharper desktop plate needs new masters.
const PLATE_WIDTHS = [350, 525, 700];
const plate = async (file?: string) => {
	if (!file) return undefined;
	const src = sourceByFile.get(file.split('/').pop() as string);
	if (!src) return undefined;
	return getImage({ src, widths: PLATE_WIDTHS, format: 'avif' });
};
const base = await plate(member.photo);
const color = await plate(member.photoColor ?? member.photo);
---

<BaseLayout
	title={`${copy.titleFlat} — DevFest.cz 2026`}
	description={`A personal invitation to DevFest.cz 2026 from ${member.name}. ${INVITE_EVENT.date}, ${INVITE_EVENT.city}.`}
	noindex
	ogImage={ogImageUrl}
	ogImageAlt={`${member.name} invites you to DevFest.cz 2026`}
>
	<main class="page-stack">
		<section class="invite scene" aria-labelledby="invite-title" data-bleed>
			{base && (
				<div class="invite-plate" aria-hidden="true">
					{/* The base plate is the LCP element on this page — it is the page.
					    Eager and high priority; the colour layer that fades over it is
					    the enhancement and must not compete for the same bandwidth. */}
					<img
						class="plate-base"
						src={base.src}
						srcset={base.srcSet.attribute}
						sizes="(max-width: 860px) 100vw, 62vw"
						alt=""
						width="700"
						height="875"
						fetchpriority="high"
						decoding="async"
					/>
					{color && (
						<img
							class="plate-color"
							src={color.src}
							srcset={color.srcSet.attribute}
							sizes="(max-width: 860px) 100vw, 62vw"
							alt=""
							width="700"
							height="875"
							fetchpriority="low"
							decoding="async"
						/>
					)}
				</div>
			)}
			<div class="scene-vignette" aria-hidden="true"></div>

			<div class="band-inner">
				<div class="invite-content">
					<div class="invite-hero">
						<p class="eyebrow">{member.alias}</p>
						<h1 id="invite-title" class="display invite-title" set:html={copy.titleHtml} />
					</div>
					<p class="invite-lede">{copy.body[0]}</p>
					<div class="invite-actions">
						<InviteCta
							client:load
							memberId={slug}
							memberName={member.name}
							label={copy.cta}
						/>
						<span class="invite-meta">{INVITE_EVENT.stamp}</span>
					</div>
				</div>
			</div>
		</section>

		<Ticker items={EVENT_TOPICS} size="sm" />

		<section class="band" aria-label="From the invitation">
			<div class="band-inner invite-note">
				<p>{copy.body[1]} {copy.body[2]}</p>
				{/* The one line that differs between the eleven pages; the role
				    lived in the eyebrow before, it lives in the attribution now. */}
				<p class="invite-quote">
					“{copy.roleLine}”<br />
					<span>— {member.name}{member.role ? `, ${member.role}` : ''}</span>
				</p>
			</div>
		</section>

		<Closer
			eyebrow="The list closes"
			titleHtml={'Take the <span class="red">ticket.</span>'}
			note="Waves move and the room is one day only."
			tone="accent"
			actions={[
				{ href: '/sessions', label: "See who's speaking", kind: 'ghost' },
				{ href: '/team', label: 'Meet the crew', kind: 'ghost' },
			]}
		>
			{/* The repeat of the page's one action, as the same tracked control —
			    a plain link here would leave a click GA4 cannot attribute. */}
			<InviteCta
				slot="actions"
				client:visible
				memberId={slug}
				memberName={member.name}
				label={copy.cta}
			/>
		</Closer>
	</main>
</BaseLayout>

<style lang="scss">
	@use './member';
</style>

<script>
	// The one effect: the plate settles, then bleeds into colour. Enhancement
	// only — no JS shows the B&W plate. Runs on `astro:page-load` because
	// <ClientRouter /> swaps the page on soft navigations; otherwise arriving
	// from another page leaves the plate B&W forever.
	document.addEventListener('astro:page-load', () => {
		const scene = document.querySelector('[data-bleed]');
		if (scene) requestAnimationFrame(() => setTimeout(() => scene.classList.add('is-lit'), 260));
	});
</script>
