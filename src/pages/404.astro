---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NextStep from '../components/NextStep.astro';
import NextStepList from '../components/NextStepList.astro';
import { EVENT } from '../lib/event';
import config from '../site.config';
import { enabled, enabledOnly } from '../lib/flags';

// A dead URL is still a visitor who wanted something specific. The page used
// to state the fault and offer one link home; it now offers the routes people
// actually arrive looking for. Ordered by what a stale link most often points
// at: last year's lineup, last year's programme, and tickets.
const STEPS = enabledOnly([
	{
		title: 'The lineup',
		noteHtml: 'Everyone confirmed so far, with their talks.',
		actions: [{ href: '/speakers', label: 'See the speakers' }],
	},
	{
		title: 'The agenda',
		noteHtml: 'The timetable, and every talk by track under it.',
		actions: [{ href: '/agenda', label: 'See the agenda' }],
	},
	{
		feature: 'tickets' as const,
		title: 'Tickets',
		noteHtml:
			'Pricing waves and what each one includes.' +
			(enabled('invoice') ? ' Companies can pay by <a href="/invoice">invoice</a> instead.' : ''),
		actions: [{ href: '/#tickets', label: 'Get tickets', kind: 'primary' as const }],
	},
	{
		title: 'Still lost?',
		noteHtml:
			'The FAQ answers most of it, and one of the desks answers the rest. ' +
			`Last year&rsquo;s edition lives on <a href="${config.event.previousEditionUrl}">its own site</a>.`,
		actions: [
			{ href: '/faq', label: 'Read the FAQ' },
			{ href: '/contact', label: 'Contact us' },
		],
	},
]);
---

<BaseLayout
	title={`404 — ${EVENT.name}`}
	description="The page you're looking for doesn't exist."
	noindex
>
	{/* A share link to a talk or speaker added since the last build has no
	     page yet (src/lib/share.ts). Hosting answers it with this page, so
	     send it on to the sheet it names. */}
	<script is:inline>
		(() => {
			const m = /^\/(talks|speakers)\/([A-Za-z0-9-]{1,64})\/?$/.exec(location.pathname);
			if (!m) return;
			const to = m[1] === 'talks' ? `/agenda?talk=${m[2]}` : `/speakers?speaker=${m[2]}`;
			location.replace(to);
		})();
	</script>
	<main class="page-stack">
		<SubpageHero
			titleHtml={'Nothing filed<br />under that'}
			lede="404 — the page you asked for doesn't exist, or it moved when the 2026 site replaced the old one."
			seoHeading="Page not found"
			titleId="notfound-title"
		/>

		<section class="band band--lit" aria-labelledby="notfound-next-heading">
			<div class="band-inner">
				<NextStepList label="Try one of these" labelId="notfound-next-heading">
					{STEPS.map((step) => <NextStep {...step} />)}
				</NextStepList>
			</div>
		</section>
	</main>
</BaseLayout>
