---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConversionPing from '../components/ConversionPing.astro';
import LandingNotice from '../components/LandingNotice.astro';
---

<BaseLayout
	title="Subscribed · DevFest.cz 2026"
	description="You're subscribed to DevFest.cz 2026 updates. We'll let you know when tickets drop."
	noindex
>
	<LandingNotice
		headline="You're on the list."
		subtext="We'll reach out when tickets drop. Stay tuned."
	/>
	{/* SmartEmailing redirects here after a confirmed sign-up — the completion
	    half of the `newsletter_submit` event fired by NewsletterForm. */}
	<ConversionPing event="generate_lead" />
</BaseLayout>
