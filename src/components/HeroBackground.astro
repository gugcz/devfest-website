---
interface Props {
	photoOpacity?: number;
	mobilePhotoOpacity?: number;
	/**
	 * Which part of the plate the frame sits on (`background-position`). One
	 * photograph carries every hero; an identical crop on five pages read as
	 * one template. Same scene, different shot.
	 */
	focus?: string;
	mobileFocus?: string;
	/** Opt-in desktop `width` for the plate. Defaults to the shipped 60%. */
	width?: string;
}

const {
	photoOpacity = 0.85,
	mobilePhotoOpacity = 0.55,
	focus = 'center',
	mobileFocus = '38% center',
	width,
} = Astro.props;
---

<div class="hero-bg" aria-hidden="true"></div>
<div
	class="hero-photo"
	aria-hidden="true"
	style={`--hero-photo-opacity:${photoOpacity};--hero-photo-opacity-mobile:${mobilePhotoOpacity};--hero-photo-pos:${focus};--hero-photo-pos-mobile:${mobileFocus};${width ? `--hero-photo-width:${width};` : ''}`}
></div>

<style lang="scss">
	@use './HeroBackground';
</style>
