---
interface Props {
	photoOpacity?: number;
	mobilePhotoOpacity?: number;
	/**
	 * Which part of the plate the frame sits on, as a `background-position`.
	 *
	 * One photograph carries every hero on the site, and five pages running the
	 * identical crop is what made them read as one template with the words
	 * swapped. Re-framing is the cheapest honest variation available: same
	 * scene, different shot.
	 */
	focus?: string;
	mobileFocus?: string;
	/**
	 * Opt-in `background-size` for the phone crop, e.g. `auto 130%`. The plate
	 * is a square and the phone frame is 9:19.5, so a bare `cover` at some
	 * focus points still leaves the subject too small to read at arm's length
	 * — `mobileFocus` alone repositions the crop, this scales it. Left unset,
	 * the phone crop stays `cover` like every other hero.
	 */
	mobileZoom?: string;
}

const {
	photoOpacity = 0.85,
	mobilePhotoOpacity = 0.55,
	focus = 'center',
	mobileFocus = '38% center',
	mobileZoom,
} = Astro.props;
---

<div class="hero-bg" aria-hidden="true"></div>
<div
	class="hero-photo"
	aria-hidden="true"
	style={`--hero-photo-opacity:${photoOpacity};--hero-photo-opacity-mobile:${mobilePhotoOpacity};--hero-photo-pos:${focus};--hero-photo-pos-mobile:${mobileFocus};${mobileZoom ? `--hero-photo-size-mobile:${mobileZoom};` : ''}`}
></div>

<style lang="scss">
	@use './HeroBackground';
</style>
