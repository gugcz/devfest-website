---
interface Props {
	photoOpacity?: number;
	mobilePhotoOpacity?: number;
	/**
	 * Which part of the plate the frame sits on (`background-position`). One
	 * photograph carries every hero; an identical crop on five pages read as
	 * one template. Same scene, different shot.
	 */
	focus?: string;
	mobileFocus?: string;
	/** Opt-in `background-size` for the phone crop (e.g. `auto 130%`) when
	 * `cover` leaves the subject too small; `mobileFocus` only repositions. */
	mobileZoom?: string;
	/** Opt-in desktop `width` for the plate. Defaults to the shipped 60%. */
	width?: string;
	/** Opt-in desktop `background-size`. Left unset, the desktop crop stays `cover`. */
	size?: string;
	/** Public path of a different plate (a documentary shot from a past
	 * edition). Defaults to the detective key art. */
	src?: string;
}

const {
	photoOpacity = 0.85,
	mobilePhotoOpacity = 0.55,
	focus = 'center',
	mobileFocus = '38% center',
	mobileZoom,
	width,
	size,
	src,
} = Astro.props;
---

<div class="hero-bg" aria-hidden="true"></div>
<div
	class="hero-photo"
	aria-hidden="true"
	style={`--hero-photo-opacity:${photoOpacity};--hero-photo-opacity-mobile:${mobilePhotoOpacity};--hero-photo-pos:${focus};--hero-photo-pos-mobile:${mobileFocus};${mobileZoom ? `--hero-photo-size-mobile:${mobileZoom};` : ''}${width ? `--hero-photo-width:${width};` : ''}${size ? `--hero-photo-size:${size};` : ''}${src ? `--hero-photo-src:url('${src}');` : ''}`}
></div>

<style lang="scss">
	@use './HeroBackground';
</style>
