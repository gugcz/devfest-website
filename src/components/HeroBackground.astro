---
interface Props {
	photoOpacity?: number;
	mobilePhotoOpacity?: number;
}

const { photoOpacity = 0.85, mobilePhotoOpacity = 0.55 } = Astro.props;
---

<div class="hero-bg" aria-hidden="true"></div>
<div
	class="hero-photo"
	aria-hidden="true"
	style={`--hero-photo-opacity:${photoOpacity};--hero-photo-opacity-mobile:${mobilePhotoOpacity};`}
></div>

<style lang="scss">
	@use './HeroBackground';
</style>
