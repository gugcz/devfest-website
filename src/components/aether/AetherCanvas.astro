---
/**
 * The painted background (`src/lib/aether`), fixed behind the whole page.
 * The sigil centres on the element marked `data-aether-anchor` (the home
 * page's logo, a subpage's title).
 * Without WebGL the body's gradients show through.
 */
---

<canvas id="aether" class="aether-canvas" aria-hidden="true"></canvas>

<script>
	import { startAether } from '../../lib/aether';

	let stop: (() => void) | null = null;
	let painting: Element | null = null;

	// Once per page: <ClientRouter /> keeps this module alive across soft
	// navigations, so it starts on every page that has the canvas and stops
	// (freeing the GPU) before the page is swapped out. Astro also fires
	// `astro:page-load` on the window's `load`, which can come after a soft
	// navigation: the canvas already painting is left as it is (a canvas
	// handed to the painting's worker cannot be handed over twice).
	document.addEventListener('astro:page-load', () => {
		const canvas = document.getElementById('aether');
		if (canvas && canvas === painting) return;
		stop?.();
		stop = null;
		painting = canvas;
		const anchor = document.querySelector('[data-aether-anchor]');
		if (canvas instanceof HTMLCanvasElement && anchor instanceof HTMLElement) stop = startAether(canvas, anchor);
	});
	document.addEventListener('astro:before-swap', () => {
		painting = null;
		stop?.();
		stop = null;
	});
</script>

<style>
	/* Under every block of the page, over the body's gradient: a section
	   without its own stacking still covers it with its ground.
	   As tall as the large viewport (the URL bar hidden), never `inset: 0`:
	   a fixed box with a bottom edge follows a phone's URL bar as it slides
	   in or out while scrolling, and every new height re-centres the smoke. */
	.aether-canvas {
		position: fixed;
		z-index: -1;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		height: 100lvh;
		display: block;
		opacity: 0;
		transition: opacity 1.8s ease;
	}

	.aether-canvas.is-live {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.aether-canvas {
			transition: none;
		}
	}
</style>
