---
/**
 * The cookie slip (`docs/design.md`, "Cookie slip"). The markup contract and
 * the behaviour live in `src/lib/cookie-banner.ts`. A heading asks, one line
 * says why, and every choice is the same framed portal: none is pushed.
 * The choices wrap, so a third one fits without a new layout.
 */
---

<div id="cookie-banner" class="cookie-banner cookie-banner--hidden" tabindex="-1" role="region" aria-labelledby="cookie-title" aria-live="polite" aria-hidden="true">
	<p id="cookie-title" class="cookie-title">Can we count your visit?</p>
	<p class="cookie-text">
		Google Analytics shows us which pages help. "Allow all" also lets Meta and
		LinkedIn measure our ads. Nothing runs unless you allow it.
		Details in our <a href="/privacy-policy">Privacy Policy</a>.
	</p>
	<div class="cookie-actions">
		<button id="cookie-accept-all" type="button" class="btn-framed cookie-btn">Allow all</button>
		<button id="cookie-accept" type="button" class="btn-framed cookie-btn">Analytics only</button>
		<button id="cookie-decline" type="button" class="btn-framed cookie-btn">Decline</button>
	</div>
</div>

<script>
	import '../../lib/cookie-banner';
</script>

<style lang="scss">
	@use '../../styles/aether' as *;

	.cookie-banner {
		position: fixed;
		right: min(var(--gutter), 5vw);
		bottom: calc(min(1.25rem, 4vw) + env(safe-area-inset-bottom));
		z-index: 10000;
		width: min(30rem, calc(100% - 2 * min(var(--gutter), 5vw)));
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem 1.6rem 1.4rem;
		background: var(--ink-veil);
		border: 1px solid var(--print-edge);
		color: var(--ivory);
		transition: opacity 0.3s, transform 0.3s, visibility 0s;

		&:focus-visible {
			@include focus-ring(-4px);
		}
	}

	.cookie-banner--hidden {
		opacity: 0;
		pointer-events: none;
		transform: translateY(1.5rem);
		visibility: hidden;
		transition-delay: 0s, 0s, 0.3s;
	}

	.cookie-title {
		margin: 0;
		font-size: var(--fs-row-sm);
		font-weight: 600;
		line-height: 1.25;
		color: var(--ivory);
	}

	.cookie-text {
		margin: 0;
		font-size: var(--fs-small);
		line-height: 1.55;
		color: var(--ivory-muted);

		a {
			color: var(--ivory);
		}
	}

	// Every choice is the same framed portal, at the same width. They share a
	// row while they fit and wrap otherwise, a third choice included.
	.cookie-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	// The portal's 280px minimum is released, but only down to the longest
	// word: `break-word` keeps a word whole in the min-content width, so
	// "Analytics only" wraps between its words (or the choice takes its own
	// row) instead of mid-word. `max-width: 100%` still caps it on a phone.
	.cookie-btn {
		flex: 1 1 9rem;
		min-width: auto;
		overflow-wrap: break-word;
	}

	@media (prefers-reduced-motion: reduce) {
		.cookie-banner {
			transition: none;
		}
	}
</style>
