---
/**
 * One partner mark: optional link wrap, shared alt/aria-label and the
 * `is-plated` class flag. The three call sites (home strip, /partners tiers,
 * /partners media & community rows) each compute their own sizing —
 * `imageProps` carries that, this component only owns what was identical.
 */
import { Image } from 'astro:assets';
import type { Partner } from '../lib/partners';

interface Props {
	partner: Partner;
	className: string;
	imageProps: Record<string, unknown>;
}

const { partner, className, imageProps } = Astro.props;
const logoClass = `${className}${partner.plated ? ' is-plated' : ''}`;
// `<Image>`'s props are a discriminated union keyed on `src`'s shape (local
// asset vs. remote, `format`/`widths` vs. `layout: 'none'`) — a generic bag
// from three different call sites can't type-check against it structurally,
// so `class`/`alt`/`loading` are folded into the same object rather than
// spread alongside it (a typed spread of a `Record` would otherwise read as
// a possible duplicate of them). Each call site's own `imageProps` builder is
// still fully typed.
const image = { class: logoClass, alt: partner.name, loading: 'lazy', ...imageProps } as Parameters<typeof Image>[0];
---

{partner.url ? (
	<a href={partner.url} target="_blank" rel="noopener noreferrer" aria-label={partner.name}>
		<Image {...image} />
	</a>
) : (
	<Image {...image} />
)}
