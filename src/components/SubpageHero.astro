---
import HeroBackground from './HeroBackground.astro';

interface Props {
	titleHtml: string;
	lede: string;
	titleId?: string;
	/** Visually-hidden keyword text prepended to the <h1>, ahead of the
	 * decorative title (e.g. "DevFest.cz 2026 Speakers"). Omit to skip. */
	seoHeading?: string;
	/** Key-art plate behind the title. Pages ABOUT the event keep it;
	 * transactional ones (contact, FAQ, invoice, downloads) open on type. */
	photo?: boolean;
	/** `background-position` for the key-art plate — see HeroBackground. */
	focus?: string;
	/** Public path of a page-specific plate; see HeroBackground `src`. */
	plate?: string;
	/** One cross-link under the lede, to the page's sibling view (sessions ↔
	 * agenda). It used to sit under a second section headline in the band. */
	link?: { href: string; label: string };
}

const {
	titleHtml,
	lede,
	titleId = 'subpage-hero-title',
	seoHeading,
	photo = true,
	focus = 'center',
	plate,
	link,
} = Astro.props;
---

<section class:list={['subpage-hero', 'scene', { 'subpage-hero--plain': !photo }]} aria-labelledby={titleId}>
	{photo && (
		<>
			<HeroBackground photoOpacity={0.7} mobilePhotoOpacity={0.4} focus={focus} src={plate} />
			<div class="scene-vignette" aria-hidden="true"></div>
		</>
	)}

	<div class="hero-content">
		<h1 id={titleId} class="hero-title">
			{seoHeading && <span class="sr-only">{seoHeading} — </span>}
			<span set:html={titleHtml} />
		</h1>
		<p class="hero-lede">{lede}</p>
		{link && (
			<p class="hero-link">
				<a class="action" href={link.href}>{link.label}</a>
			</p>
		)}
	</div>
</section>

<style lang="scss">
	@use './SubpageHero';
</style>
