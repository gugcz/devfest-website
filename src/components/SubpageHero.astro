---
interface Props {
	titleHtml: string;
	lede: string;
	titleId?: string;
	/** Visually-hidden keyword text prepended to the <h1>, ahead of the
	 * decorative title (e.g. "DevFest.cz 2026 Speakers"). Omit to skip. */
	seoHeading?: string;
	/** Kept for the callers' sake: a page without a `plate` opens on type. */
	photo?: boolean;
	/** `object-position` for the print's photograph. */
	focus?: string;
	/** Public path of the one print beside the title. Pages ABOUT the event
	 * carry one; transactional ones (contact, FAQ, invoice) open on type. */
	plate?: string;
	/** One cross-link under the lede, to the page's sibling view. */
	link?: { href: string; label: string };
}

const {
	titleHtml,
	lede,
	titleId = 'subpage-hero-title',
	seoHeading,
	photo = true,
	focus = 'center',
	plate,
	link,
} = Astro.props;
const print = photo && plate;
---

<section class:list={['subpage-hero', { 'subpage-hero--print': print }]} aria-labelledby={titleId}>
	<div class="hero-content">
		<h1 id={titleId} class="hero-title">
			{seoHeading && <span class="sr-only">{seoHeading} — </span>}
			<span set:html={titleHtml} />
		</h1>
		<div class="hero-side">
			<p class="hero-lede">{lede}</p>
			{link && (
				<p class="hero-link">
					<a class="action" href={link.href}>{link.label}</a>
				</p>
			)}
		</div>
		{print && (
			<figure class="paper hero-print" aria-hidden="true">
				<div class="paper-photo">
					<img src={plate} alt="" loading="eager" decoding="async" style={`object-position:${focus}`} />
				</div>
				<figcaption class="paper-edge"><span>01</span><span>30.10.2026</span></figcaption>
			</figure>
		)}
	</div>
</section>

<style lang="scss">
	@use './SubpageHero';
</style>
