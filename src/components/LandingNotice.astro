---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
	code?: string;
	headline: string;
	subtext: string;
	backLabel?: string;
}

const { code, headline, subtext, backLabel = 'Back to homepage' } = Astro.props;
---

<main class="landing">
	<h1 class="title">
		<Image
			src={logo}
			alt="DevFest.cz 2026"
			class="logo"
			priority
			widths={[280, 520, 560, 1040]}
			sizes="(max-width: 467px) 280px, (max-width: 867px) 60vw, 520px"
		/>
	</h1>
	{code && <p class="code">{code}</p>}
	<p class="headline">{headline}</p>
	<p class="subtext">{subtext}</p>
	<a class="back-link btn-ghost" href="/">
		<span class="back-arrow" aria-hidden="true">&#8592;</span>
		{backLabel}
	</a>
	<div class="decoration-line" aria-hidden="true"></div>
</main>

<style lang="scss">
	@use './LandingNotice';
</style>
