---
interface Props {
	code?: string;
	headline: string;
	subtext: string;
	backLabel?: string;
}

const { code, headline, subtext, backLabel = 'Back to homepage' } = Astro.props;
---

<main class="landing">
	<h1 class="title">
		<img src="/logo.png" alt="DevFest.cz 2026" class="logo" />
	</h1>
	{code && <p class="code">{code}</p>}
	<p class="headline">{headline}</p>
	<p class="subtext">{subtext}</p>
	<a class="back-link btn-ghost" href="/">
		<span class="back-arrow" aria-hidden="true">&#8592;</span>
		{backLabel}
	</a>
	<div class="decoration-line" aria-hidden="true"></div>
</main>

<style lang="scss">
	@use './LandingNotice';
</style>
