---
/**
 * The portal: the aether's one button. A beveled brass frame drawn in ink;
 * on hover or focus a band of cold light runs through it and the arrow
 * steps forward. One per screen (`docs/design.md`, "Portal").
 */
interface Props {
	href: string;
	label: string;
	/** Another build (an archive): a full page load, no soft navigation. */
	reload?: boolean;
	class?: string;
}

const { href, label, reload = false, class: className } = Astro.props;
---

<a class:list={['portal', className]} href={href} {...(reload ? { 'data-astro-reload': true } : {})}>
	<svg class="portal-frame" viewBox="0 0 280 62" aria-hidden="true" focusable="false">
		<g fill="none" filter="url(#aether-ink)">
			<path class="portal-outer" d="M16 2H264L278 16V46L264 60H16L2 46V16Z"></path>
			<path class="portal-inner" d="M20 8H260L272 20V42L260 54H20L8 42V20Z"></path>
		</g>
	</svg>
	<span class="portal-label">{label}</span>
	<svg class="portal-arrow" viewBox="0 0 28 12" aria-hidden="true" focusable="false">
		<path d="M1 6H26M20 1L26 6L20 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
</a>

<style lang="scss">
	@use '../../styles/aether' as *;

	.portal {
		@include label;
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		width: 280px;
		height: 62px;
		color: var(--ivory);
		text-decoration: none;
		isolation: isolate;
		transition: color 0.3s ease, filter 0.3s ease;

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: -1;
			clip-path: polygon(16px 2px, 264px 2px, 278px 16px, 278px 46px, 264px 60px, 16px 60px, 2px 46px, 2px 16px);
			background: linear-gradient(
				100deg,
				rgba(6, 16, 22, 0.86) 0 42%,
				rgba(116, 235, 224, 0.34) 50%,
				rgba(6, 16, 22, 0.86) 58% 100%
			);
			background-size: 320% 100%;
			background-position: 100% 0;
			transition: background-position 0.8s var(--ease-rise);
		}
	}

	.portal-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.portal-outer {
		stroke: var(--brass);
		stroke-width: 1.6;
		transition: stroke 0.3s ease;
	}

	.portal-inner {
		stroke: var(--brass);
		stroke-width: 0.8;
		opacity: 0.5;
		transition: stroke 0.3s ease, opacity 0.3s ease;
	}

	.portal-label {
		position: relative;
		// Optical centring: the tracking leaves a space after the last letter.
		padding-left: 0.24em;
	}

	.portal-arrow {
		position: relative;
		width: 28px;
		height: 12px;
		color: var(--brass);
		transition: transform 0.3s ease, color 0.3s ease;
	}

	.portal:hover,
	.portal:focus-visible {
		color: var(--brass-light);
		filter: drop-shadow(0 0 14px rgba(116, 235, 224, 0.4));

		&::before {
			background-position: 0 0;
		}

		.portal-outer,
		.portal-inner {
			stroke: var(--aether);
		}

		.portal-inner {
			opacity: 0.8;
		}

		.portal-arrow {
			color: var(--aether);
			transform: translateX(5px);
		}
	}

	.portal:active {
		filter: drop-shadow(0 0 22px rgba(116, 235, 224, 0.65));
	}

	.portal:focus-visible {
		@include focus-ring(5px);
	}

	@media (prefers-reduced-motion: reduce) {
		.portal,
		.portal::before,
		.portal-arrow,
		.portal-outer,
		.portal-inner {
			transition: none;
		}
	}
</style>
