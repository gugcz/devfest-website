---
/** A DESK — one inbox in an open field of them (/contact). CONTAINS its
 * controls, so `.field-row--holds`, never the red reach field. */
interface Contact {
	/** Optional person or team above the address ("Filip Goszler — Lead"). */
	name?: string;
	email: string;
}

interface Props {
	/** Mono eyebrow above the title ("General", "Press kit"). */
	label: string;
	/** The desk name. Rendered as the heading at `level`. */
	title: string;
	/** `id` for the heading, so the caller can `aria-labelledby` it. */
	titleId?: string;
	/** Heading level — /contact's desks are h2 under an h1, /press's are h3. */
	level?: 2 | 3;
	/** One line on what the desk handles. */
	desc: string;
	/** Addresses, on the row's right axis. */
	contacts?: Contact[];
	/** A link instead of addresses (the press kit desk points at a page). */
	action?: { href: string; label: string };
}

const { label, title, titleId, level = 2, desc, contacts = [], action } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="field-row field-row--short field-row--holds desk" aria-labelledby={titleId}>
	<div class="desk-head">
		<span class="desk-label">{label}</span>
		<Heading id={titleId} class="desk-title">{title}</Heading>
		<p class="desk-desc">{desc}</p>
	</div>

	<div class="desk-body">
		{contacts.length > 0 && (
			<ul class="desk-contacts">
				{contacts.map((c) => (
					<li>
						{c.name && <span class="desk-contact-name">{c.name}</span>}
						<a class="desk-email" href={`mailto:${c.email}`}>{c.email}</a>
					</li>
				))}
			</ul>
		)}

		{action && <a class="desk-action" href={action.href}>{action.label}</a>}
	</div>
</article>

<style lang="scss">
	@use './Desk';
</style>
