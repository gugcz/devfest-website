---
/** A NEXT STEP — one thing to do, as a typed paper index card on the black
 * table (`/thank-you`, `/newsletter-subscription-thank-you`, `/404`).
 * Rendered inside `NextStepList`. The default slot takes media that belongs
 * to the step, under its actions. */
interface Action {
	href: string;
	label: string;
	/** The red fill (primary) or a black text action on the paper (ghost).
	 * Default ghost: one red fill per screen, never one per card. */
	kind?: 'primary' | 'ghost';
	external?: boolean;
	/** `download` on the calendar file, so it saves rather than renders. */
	download?: boolean;
}

interface Props {
	title: string;
	/** One or two lines on what this is. May contain inline HTML (links). */
	noteHtml: string;
	actions: readonly Action[];
	/** 1-based position on a route. Set it only when the steps are a real
	 * sequence; the `<ol>` already tells assistive tech, so the figure is
	 * visual only. */
	index?: number;
}

const { title, noteHtml, actions, index } = Astro.props;
---

<li class="paper step">
	{index !== undefined && (
		<span class="step-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
	)}
	<h3 class="step-title">{title}</h3>
	<p class="step-note" set:html={noteHtml} />

	{actions.length > 0 && (
		<div class="step-actions">
			{actions.map(({ href, label, kind = 'ghost', external, download }) => (
				<a
					class={kind === 'primary' ? 'btn-primary' : 'step-go'}
					href={href}
					{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					{...(download ? { download: true } : {})}
				>
					{label}
				</a>
			))}
		</div>
	)}

	<slot />
</li>

<style lang="scss">
	@use './NextStep';
</style>
