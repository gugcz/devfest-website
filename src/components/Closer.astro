---
/** The closing statement every page ends on, on the black ground. (The red
 * field it used to sit on is gone: red is spent on a word, a button and a
 * state, never on a ground.) */
interface Action {
	href: string;
	label: string;
	/** Filled (primary) or outlined (ghost). First action should be filled. */
	kind?: 'primary' | 'ghost';
	external?: boolean;
}

interface Props {
	eyebrow?: string;
	/** Rendered with set:html (for a `<br />`). Plain cream: the red word is
	 * spent once per page, on the page's h1 (SubpageHero), never on a closer. */
	titleHtml: string;
	note?: string;
	/**
	 * The closing actions as plain links. Omit them and pass an `actions` slot
	 * instead when a control has to be an island (the invitation pages resolve
	 * their ti.to href client-side and report the click).
	 */
	actions?: readonly Action[];
	titleId?: string;
	/** Extra class on the section, for a page that lays out its actions. */
	class?: string;
}

const {
	eyebrow,
	titleHtml,
	note,
	actions = [],
	titleId,
	class: extraClass,
} = Astro.props;
---

<section class:list={['band closer-band', extraClass]} aria-labelledby={titleId}>
	<div class="band-inner closer">
		<div>
			{eyebrow && <p class="eyebrow closer-eyebrow">{eyebrow}</p>}
			<h2 id={titleId} class="display closer-title" set:html={titleHtml} />
		</div>

		<div class="closer-side">
			{note && <p class="closer-note">{note}</p>}
			<div class="closer-actions">
				<slot name="actions" />
				{actions.map(({ href, label, kind = 'primary', external }) => (
					<a
						href={href}
						class={kind === 'primary' ? 'btn-primary' : 'btn-ghost'}
						{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{label}
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use './Closer';
</style>
