---
/** The closing statement every page ends on. `tone="accent"` puts it on the
 * red field — at most ONE accent band per page. */
interface Action {
	href: string;
	label: string;
	/** Filled (primary) or outlined (ghost). First action should be filled. */
	kind?: 'primary' | 'ghost';
	external?: boolean;
}

interface Props {
	eyebrow?: string;
	/** Allows a <span class="red"> accent word; rendered with set:html. */
	titleHtml: string;
	note?: string;
	/**
	 * The closing actions as plain links. Omit them and pass an `actions` slot
	 * instead when a control has to be an island (the invitation pages resolve
	 * their ti.to href client-side and report the click).
	 */
	actions?: readonly Action[];
	tone?: 'accent' | 'raised' | 'plain';
	titleId?: string;
}

const {
	eyebrow,
	titleHtml,
	note,
	actions = [],
	tone = 'raised',
	titleId,
} = Astro.props;

const toneClass = tone === 'accent' ? ' band--accent' : tone === 'raised' ? ' band--raised' : '';
---

<section class={`band${toneClass} closer-band`} aria-labelledby={titleId}>
	<div class="band-inner closer reveal">
		<div>
			{eyebrow && <p class="eyebrow closer-eyebrow">{eyebrow}</p>}
			<h2 id={titleId} class="display closer-title" set:html={titleHtml} />
		</div>

		<div class="closer-side">
			{note && <p class="closer-note">{note}</p>}
			<div class="closer-actions">
				<slot name="actions" />
				{actions.map(({ href, label, kind = 'primary', external }) => (
					<a
						href={href}
						class={kind === 'primary' ? 'btn-primary' : 'btn-ghost'}
						{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{label}
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use './Closer';
</style>
