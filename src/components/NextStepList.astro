---
/** The `NextStep` index cards with their label. The label is a typewriter
 * note, not a poster head: the card titles under it are the larger type, and
 * a section head smaller than its own cards read upside down. */
interface Props {
	label: string;
	/** Id for the `<h2>`, so the section can be `aria-labelledby` it. */
	labelId: string;
}

const { label, labelId } = Astro.props;
---

<h2 id={labelId} class="eyebrow step-list-label">{label}</h2>
<ul class="step-list" role="list">
	<slot />
</ul>

<style lang="scss">
	// The cards laid straight on the table, even in height: three across,
	// four across when there are four. Air between them, never a rule.
	.step-list-label {
		margin: 0 0 clamp(2rem, 3.5vw, 3rem);
	}

	.step-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 2.6vw, 2.25rem);
		align-items: stretch;

		&:has(> :nth-child(4)) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 1240px) {
		.step-list:has(> :nth-child(4)) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 900px) {
		.step-list,
		.step-list:has(> :nth-child(4)) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 36rem;
		}
	}
</style>
