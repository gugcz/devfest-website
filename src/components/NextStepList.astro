---
/** The `NextStep` plates under their rubric, centred on the veil. */
interface Props {
	label: string;
	/** Id for the `<h2>`, so the section can be `aria-labelledby` it. */
	labelId: string;
}

const { label, labelId } = Astro.props;
---

<h2 id={labelId} class="step-list-label">{label}</h2>
<ul class="step-list" role="list">
	<slot />
</ul>

<style lang="scss">
	@use '../styles/aether' as *;

	.step-list-label {
		@include rubric;
		margin: 0 0 clamp(2rem, 3.5vw, 3rem);
	}

	// Plates of one width, as many to a row as fit, the row centred.
	.step-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 21rem));
		justify-content: center;
		gap: clamp(1.25rem, 2.5vw, 2rem);
		align-items: stretch;
	}
</style>
