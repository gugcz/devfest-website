---
interface Props {
	items: readonly string[];
	fontSize?: string;
}

const { items, fontSize = '0.85rem' } = Astro.props;
const doubled = [...items, ...items];
---

<div class="ticker-wrap" aria-hidden="true" style={`--ticker-font-size:${fontSize};`}>
	<div class="ticker">
		{doubled.map((item) => (
			<span class="ticker-item">{item} <span class="ticker-sep">///</span></span>
		))}
	</div>
</div>

<style lang="scss">
	@use './Ticker';
</style>
