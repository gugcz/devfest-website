---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface NavLink {
	href: string;
	label: string;
	external?: boolean;
	cta?: boolean;
}

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
// On the home page #tickets is a same-page anchor; from subpages we need
// to send the visitor back to / first so the section actually exists.
const ticketsHref = isHome ? '#tickets' : '/#tickets';

const links: readonly NavLink[] = [
	{ href: '/speakers', label: 'Speakers' },
	{ href: '/sessions', label: 'Sessions' },
	{ href: '/agenda', label: 'Agenda' },
	{ href: '/team', label: 'Team' },
	{ href: '/partners', label: 'Partners' },
	{ href: '/press', label: 'Press' },
	{ href: '/faq', label: 'FAQ' },
	{ href: '/contact', label: 'Contact' },
	{ href: ticketsHref, label: 'Tickets', cta: true },
];

const isCurrent = (href: string) => {
	if (href.startsWith('http')) return false;
	// Same-page or cross-page anchor links (#tickets, /#tickets) jump within
	// content; they are not the "current page" in the WCAG aria-current sense.
	if (href.includes('#')) return false;
	const path = href.replace(/\/$/, '') || '/';
	return path === currentPath;
};
---

<header id="site-header" class="site-header" data-state="top" data-home={isHome ? 'true' : 'false'}>
	<a href="/" class="brand" aria-label="DevFest.cz 2026 — home">
		<!-- Header sits above the fold on every page, so it loads eagerly; the
		     intrinsic width/height come from the source (5:1), and `widths` caps
		     the srcset at the 210px CSS maximum up to 2× DPR. -->
		<Image
			src={logo}
			alt="DevFest.cz 2026"
			class="brand-logo"
			loading="eager"
			widths={[210, 420]}
			sizes="210px"
		/>
	</a>

	<nav class="nav" aria-label="Primary">
		<button
			id="nav-toggle"
			class="nav-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="nav-list"
			aria-label="Open menu"
		>
			<span class="nav-toggle-bars" aria-hidden="true">
				<span></span><span></span><span></span>
			</span>
			<span class="nav-toggle-label">Menu</span>
		</button>

		<ul id="nav-list" class="nav-list" data-open="false">
			{links.map(({ href, label, external, cta }) => {
				const current = isCurrent(href);
				return (
					<li>
						<a
							href={href}
							class={`nav-link${cta ? ' nav-link--cta' : ''}${current ? ' nav-link--current' : ''}`}
							{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							{...(current ? { 'aria-current': 'page' } : {})}
						>
							{label}
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
</header>

<script>
	import { currentScrollY, isScrollLocked, lockScroll } from '../lib/scroll-lock';

	// Bundled module scripts run once per document, but <ClientRouter /> replaces
	// the header on every soft navigation — so re-bind on `astro:page-load`
	// (fires on the initial load too, replacing DOMContentLoaded). The
	// window/document/matchMedia listeners below would otherwise pile up across
	// navigations while pointing at a detached header, so they're all registered
	// with an AbortController that is aborted right before the next swap.
	document.addEventListener('astro:page-load', () => {
		const ac = new AbortController();
		const { signal } = ac;
		document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

		const header = document.getElementById('site-header');
		const toggle = document.getElementById('nav-toggle');
		const list = document.getElementById('nav-list');

		// Scroll state — sets data-state for brand reveal on home page.
		// `currentScrollY()`, not `window.scrollY`: an open overlay pins the body
		// and the live value reads 0, which would drop the brand behind the
		// overlay and pop it back on close.
		const onScrollState = () => {
			if (!header) return;
			header.dataset.state = currentScrollY() > 24 ? 'scrolled' : 'top';
		};
		onScrollState();
		window.addEventListener('scroll', onScrollState, { passive: true, signal });

		// Hide-on-scroll-down, show-on-scroll-up. Avoids the "partial shrink"
		// look on Chrome mobile where the browser URL bar collapses gradually;
		// instead nav fully slides out of view, lining up with the disappearing
		// browser chrome.
		let lastY = 0;
		let delta = 0;
		let hidden = false;
		let raf = false;
		const HIDE_THRESHOLD = 10;
		const MIN_SCROLL_Y = 80;
		// Only auto-hide on touch / small-viewport devices — on desktop the
		// fixed nav stays visible so the user can jump sections without scroll-up.
		const hideMql = window.matchMedia('(max-width: 760px)');
		// Safari (macOS + iOS) collapses its own URL bar on scroll — stacking a
		// second hide animation on top looks broken, so skip auto-hide there.
		// Match `Safari` UA token while excluding the Chromium-family browsers
		// that also include `Safari` in their string (Chrome, Edge, Firefox iOS).
		const ua = navigator.userAgent;
		const isSafari = /Safari/.test(ua) && !/(Chrome|CriOS|FxiOS|EdgiOS|Edg\/|Android)/.test(ua);
		const onScrollHide = () => {
			// Sit out entirely while an overlay holds the page. The lock parks the
			// body at scroll 0 and puts it back on release, and feeding those two
			// jumps through the delta accumulator would read as a hard scroll down
			// and slide the nav away just as the overlay closes. Leaving `lastY`
			// untouched means the release lands as a zero delta.
			if (isScrollLocked()) {
				raf = false;
				return;
			}
			const y = window.scrollY;
			if (header) {
				const diff = y - lastY;
				delta += diff;
				// Reset direction accumulator when scroll direction flips so the
				// next gesture isn't fighting leftover delta from the previous one.
				if ((diff > 0 && delta < 0) || (diff < 0 && delta > 0)) delta = diff;
				// Don't hide while the drawer is open — the user needs the toggle.
				const drawerOpen = toggle?.getAttribute('aria-expanded') === 'true';
				const canHide = hideMql.matches && !isSafari;
				if (canHide && delta > HIDE_THRESHOLD && y > MIN_SCROLL_Y && !hidden && !drawerOpen) {
					header.dataset.hidden = 'true';
					hidden = true;
					delta = 0;
				} else if ((!canHide || delta < -HIDE_THRESHOLD) && hidden) {
					header.dataset.hidden = 'false';
					hidden = false;
					delta = 0;
				}
			}
			lastY = y;
			raf = false;
		};
		// Restore visibility if user resizes from mobile → desktop while hidden.
		hideMql.addEventListener(
			'change',
			(ev) => {
				if (!ev.matches && header && hidden) {
					header.dataset.hidden = 'false';
					hidden = false;
					delta = 0;
				}
			},
			{ signal }
		);
		window.addEventListener(
			'scroll',
			() => {
				if (!raf) {
					requestAnimationFrame(onScrollHide);
					raf = true;
				}
			},
			{ passive: true, signal }
		);

		// Mobile drawer toggle — make non-drawer regions inert when open so
		// keyboard focus and AT navigation stay within the menu.
		const inertTargets = (): Element[] =>
			Array.from(document.querySelectorAll('#main-content, footer, #cookie-banner'));

		// Release for the drawer's scroll lock; null whenever the drawer is shut.
		let releaseScroll: (() => void) | null = null;

		const setOpen = (open: boolean) => {
			if (!toggle || !list) return;
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			list.dataset.open = String(open);
			// Same lock the detail dialogs use. The `body { overflow: hidden }` this
			// replaces never actually held: `html { overflow-x: clip }` stops the
			// overflow propagating to the viewport, so the page scrolled behind the
			// open drawer in every browser. See `scroll-lock.ts`.
			if (open) {
				releaseScroll ??= lockScroll();
			} else {
				releaseScroll?.();
				releaseScroll = null;
			}
			// Force header visible when the drawer opens — user needs the toggle.
			if (open && header) {
				header.dataset.hidden = 'false';
				hidden = false;
				delta = 0;
			}
			for (const el of inertTargets()) {
				if (open) {
					el.setAttribute('inert', '');
				} else {
					el.removeAttribute('inert');
				}
			}
		};

		toggle?.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			setOpen(!isOpen);
		});

		// Close drawer when a link is followed
		list?.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('a')) setOpen(false);
		});

		// Close on Escape
		document.addEventListener(
			'keydown',
			(e) => {
				if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
					setOpen(false);
					toggle.focus();
				}
			},
			{ signal }
		);

		// Reset open state when crossing to the horizontal-nav breakpoint
		// (must match the drawer breakpoint in Menu.scss).
		const mql = window.matchMedia('(min-width: 1241px)');
		mql.addEventListener('change', (ev) => {
			if (ev.matches) setOpen(false);
		}, { signal });
	});
</script>

<style lang="scss">
	@use './Menu';
</style>
