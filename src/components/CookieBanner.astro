---
---

<div id="cookie-banner" class="cookie-banner cookie-banner--hidden" role="region" aria-label="Cookie consent" aria-live="polite" aria-hidden="true">
	<p class="cookie-text">
		May we use analytics cookies?
		Details in our <a href="/privacy-policy" class="cookie-link">Privacy Policy</a>.
	</p>
	<div class="cookie-actions">
		<button id="cookie-accept" type="button" class="btn-primary cookie-btn cookie-btn--accept">Accept</button>
		<button id="cookie-decline" type="button" class="btn-ghost cookie-btn cookie-btn--decline">Decline</button>
	</div>
</div>

<script>
	// Consent storage lives in `src/lib/consent.ts` because `src/lib/firebase.ts`
	// reads the same decision to decide whether GA4 boots at all. Static import
	// (not dynamic): the module is a few lines of localStorage access and pulls in
	// no Firebase code.
	import { readConsent, storeConsent } from '../lib/consent';

	// Boot GA4 (only after an accept) and record the page view. Undecided or
	// declined loads nothing and sends nothing. `trackPageView()` is a no-op for
	// the page the boot has just reported; the rest are <ClientRouter /> soft
	// navigations GA4 cannot see by itself.
	async function trackPageView() {
		try {
			const mod = await import('../lib/firebase');
			await mod.trackPageView();
		} catch (err) {
			console.warn('[cookie-banner] Failed to track page view:', err);
		}
	}

	// While the slip is up, `--cookie-slip-h` on <html> holds the band it covers
	// at the foot of the viewport (its height plus its bottom offset), and
	// `scroll-padding-bottom` in `BaseLayout.scss` reads it: a focused element
	// scrolled into view lands above the slip, not under it (WCAG 2.4.11).
	const slipHeight = new ResizeObserver(([entry]) => {
		const banner = entry.target as HTMLElement;
		const covered = banner.offsetHeight + parseFloat(getComputedStyle(banner).bottom);
		document.documentElement.style.setProperty('--cookie-slip-h', `${Math.ceil(covered)}px`);
	});

	function showBanner() {
		const banner = document.getElementById('cookie-banner');
		if (!banner) return;
		banner.setAttribute('aria-hidden', 'false');
		banner.classList.remove('cookie-banner--hidden');
		slipHeight.disconnect();
		slipHeight.observe(banner);
	}

	function hideBanner() {
		const banner = document.getElementById('cookie-banner');
		banner?.setAttribute('aria-hidden', 'true');
		banner?.classList.add('cookie-banner--hidden');
		slipHeight.disconnect();
		document.documentElement.style.removeProperty('--cookie-slip-h');
	}

	// Re-bind on `astro:page-load`, never DOMContentLoaded: bundled module scripts
	// run once per document, but <ClientRouter /> swaps the banner markup on every
	// soft navigation. `astro:page-load` covers the initial load too.
	document.addEventListener('astro:page-load', () => {
		// Nothing loads until (and unless) the visitor accepts — `initAnalytics()`
		// reads the stored decision. A stored `accepted` boots GA4 right here, on
		// the entry page, so the document-load `page_view` is attributed.
		trackPageView();

		// Banner starts hidden — reveal only if no decision yet
		if (!readConsent()) {
			showBanner();
		}

		document.getElementById('cookie-accept')?.addEventListener('click', () => {
			storeConsent('accepted');
			hideBanner();
			// Boots GA4 now: reports the entry page (campaign parameters, referrer),
			// then the current one if the visitor soft-navigated before accepting.
			trackPageView();
		});

		document.getElementById('cookie-decline')?.addEventListener('click', () => {
			storeConsent('declined');
			hideBanner();
		});
	});

	// Escape dismisses the banner (as a decline) from ANYWHERE. Bound on
	// `document` at module scope, not inside `astro:page-load` (which would
	// stack a listener per navigation); the banner is looked up on keypress so
	// it always hits the current document's. One Escape closes one layer: while
	// the mobile menu is open it makes the banner `inert`, and that Escape
	// belongs to the menu (this listener runs first, before the menu un-inerts).
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const banner = document.getElementById('cookie-banner');
		if (!banner || banner.inert || banner.classList.contains('cookie-banner--hidden')) return;
		(document.getElementById('cookie-decline') as HTMLButtonElement | null)?.click();
	});

	// Scroll padding only applies when the browser scrolls. Focus moving to an
	// element already on screen but under the slip scrolls nothing, so do it
	// here; `nearest` honours the padding and stops just above the slip.
	document.addEventListener('focusin', (e) => {
		const banner = document.getElementById('cookie-banner');
		const target = e.target;
		if (!banner || banner.inert || banner.classList.contains('cookie-banner--hidden')) return;
		if (!(target instanceof Element) || banner.contains(target)) return;
		const slip = banner.getBoundingClientRect();
		const box = target.getBoundingClientRect();
		const under = box.bottom > slip.top && box.top < slip.bottom && box.right > slip.left && box.left < slip.right;
		if (under) target.scrollIntoView({ block: 'nearest' });
	});
</script>

<style lang="scss">
	@use './CookieBanner';
</style>
