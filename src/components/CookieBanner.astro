---
---

<div id="cookie-banner" class="cookie-banner cookie-banner--hidden" role="region" aria-label="Cookie consent" aria-live="polite" aria-hidden="true">
	<p class="cookie-text">
		We use analytics cookies to understand how visitors use this site.
		See our <a href="/privacy-policy" class="cookie-link">Privacy Policy</a> for details.
	</p>
	<div class="cookie-actions">
		<button id="cookie-accept" type="button" class="btn-primary cookie-btn cookie-btn--accept">Accept</button>
		<button id="cookie-decline" type="button" class="btn-ghost cookie-btn cookie-btn--decline">Decline</button>
	</div>
</div>

<script>
	// Consent storage lives in `src/lib/consent.ts` because `src/lib/firebase.ts`
	// reads the same decision to seed the GA4 Consent Mode default. Static import
	// (not dynamic): the module is a few lines of localStorage access and pulls in
	// no Firebase code.
	import { readConsent, storeConsent } from '../lib/consent';

	// Boot Analytics in Consent Mode and record the page view. Safe for every
	// visitor — an undecided one gets only aggregated identifier-free pings, with
	// no cookie / `client_id` until they accept. `trackPageView()` initialises
	// Analytics on first use (idempotent) and swallows the initial call, which
	// GA4's own `config` already reported; the rest are the `<ClientRouter />`
	// soft navigations GA4 cannot see by itself. The module stays cached across
	// soft navigations, so both guards hold.
	async function trackPageView() {
		try {
			const mod = await import('../lib/firebase');
			await mod.trackPageView();
		} catch (err) {
			console.warn('[cookie-banner] Failed to track page view:', err);
		}
	}

	// Upgrade consent to granted after the visitor accepts — flips GA4 from
	// cookieless pings to full measurement and re-sends the current page's
	// `page_view`, which had already gone out cookieless at `config` time.
	async function grantAnalyticsConsent() {
		try {
			const mod = await import('../lib/firebase');
			await mod.grantAnalyticsConsent();
		} catch (err) {
			console.warn('[cookie-banner] Failed to grant analytics consent:', err);
		}
	}

	// Bundled module scripts run once per document; <ClientRouter /> swaps the
	// banner markup on every soft navigation, so re-bind on `astro:page-load`
	// (which also covers the initial load — it replaces DOMContentLoaded).
	document.addEventListener('astro:page-load', () => {
		const banner = document.getElementById('cookie-banner');

		const hideBanner = () => {
			banner?.setAttribute('aria-hidden', 'true');
			banner?.classList.add('cookie-banner--hidden');
		};

		const showBanner = () => {
			banner?.setAttribute('aria-hidden', 'false');
			banner?.classList.remove('cookie-banner--hidden');
		};

		// Analytics starts for everyone; identifiers stay off until (and unless)
		// the visitor accepts. A stored `accepted` needs no call here —
		// `initAnalytics()` reads it and boots GA4 straight into granted, so the
		// document-load `page_view` is already attributed.
		trackPageView();

		// Banner starts hidden — reveal only if no decision yet
		if (!readConsent()) {
			showBanner();
		}

		document.getElementById('cookie-accept')?.addEventListener('click', () => {
			storeConsent('accepted');
			hideBanner();
			grantAnalyticsConsent();
		});

		document.getElementById('cookie-decline')?.addEventListener('click', () => {
			storeConsent('declined');
			hideBanner();
		});

		banner?.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !banner.classList.contains('cookie-banner--hidden')) {
				(document.getElementById('cookie-decline') as HTMLButtonElement | null)?.click();
			}
		});
	});
</script>

<style lang="scss">
	@use './CookieBanner';
</style>
