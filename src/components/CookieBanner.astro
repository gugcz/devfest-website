---
---

<div id="cookie-banner" class="cookie-banner cookie-banner--hidden" role="region" aria-label="Cookie consent" aria-live="polite" aria-hidden="true">
	<p class="cookie-text">
		We use analytics cookies to understand how visitors use this site.
		See our <a href="/privacy-policy" class="cookie-link">Privacy Policy</a> for details.
	</p>
	<div class="cookie-actions">
		<button id="cookie-accept" type="button" class="btn-primary cookie-btn cookie-btn--accept">Accept</button>
		<button id="cookie-decline" type="button" class="btn-ghost cookie-btn cookie-btn--decline">Decline</button>
	</div>
</div>

<script>
	const CONSENT_KEY = 'cookie-consent';

	function getConsent(): string | null {
		try { return localStorage.getItem(CONSENT_KEY); } catch { return null; }
	}

	function setConsent(value: string): void {
		try { localStorage.setItem(CONSENT_KEY, value); } catch {}
	}

	// Boot Analytics in cookieless Consent Mode (consent denied by default).
	// Safe for every visitor — GA4 sends only aggregated identifier-free pings,
	// setting no cookie / `client_id` until they accept. `initAnalytics()` is
	// idempotent (module-level guard) and the module stays cached across soft
	// navigations, so re-running per page-load never re-initialises Analytics.
	async function startAnalytics() {
		try {
			const mod = await import('../lib/firebase');
			await mod.initAnalytics();
		} catch (err) {
			console.warn('[cookie-banner] Failed to start analytics:', err);
		}
	}

	// Upgrade consent to granted after the visitor accepts — flips GA4 from
	// cookieless pings to full measurement.
	async function grantAnalyticsConsent() {
		try {
			const mod = await import('../lib/firebase');
			await mod.grantAnalyticsConsent();
		} catch (err) {
			console.warn('[cookie-banner] Failed to grant analytics consent:', err);
		}
	}

	// Bundled module scripts run once per document; <ClientRouter /> swaps the
	// banner markup on every soft navigation, so re-bind on `astro:page-load`
	// (which also covers the initial load — it replaces DOMContentLoaded).
	document.addEventListener('astro:page-load', () => {
		const banner = document.getElementById('cookie-banner');

		const hideBanner = () => {
			banner?.setAttribute('aria-hidden', 'true');
			banner?.classList.add('cookie-banner--hidden');
		};

		const showBanner = () => {
			banner?.setAttribute('aria-hidden', 'false');
			banner?.classList.remove('cookie-banner--hidden');
		};

		// Analytics starts for everyone in cookieless mode; identifiers stay off
		// until (and unless) the visitor accepts.
		startAnalytics();

		// Banner starts hidden — reveal only if no decision yet
		const stored = getConsent();
		if (stored === 'accepted') {
			grantAnalyticsConsent();
			window.dispatchEvent(new Event('cookie-consent-accepted'));
		} else if (!stored) {
			showBanner();
		}

		document.getElementById('cookie-accept')?.addEventListener('click', () => {
			setConsent('accepted');
			hideBanner();
			grantAnalyticsConsent();
			window.dispatchEvent(new Event('cookie-consent-accepted'));
		});

		document.getElementById('cookie-decline')?.addEventListener('click', () => {
			setConsent('declined');
			hideBanner();
		});

		banner?.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !banner.classList.contains('cookie-banner--hidden')) {
				(document.getElementById('cookie-decline') as HTMLButtonElement | null)?.click();
			}
		});
	});
</script>

<style lang="scss">
	@use './CookieBanner';
</style>
