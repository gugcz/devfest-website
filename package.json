{
  "name": "devfest-website",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "a11y": "A11Y_MOCK=1 astro build && node scripts/a11y.mjs",
    "verify": "npm run check && npm run complexity && npm run literals && npm run test:site && npm --prefix functions test && npm run a11y",
    "anchors": "A11Y_MOCK=1 astro build && node scripts/anchor-measure.mjs",
    "flags-off": "node --experimental-strip-types scripts/flags-off-build.mjs",
    "complexity": "eslint src functions/src scripts astro.config.ts",
    "test:site": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "literals": "! grep -rniE 'DevFest\\.cz 2026|2026-10-30|30 October|30 Oct|30 / 10 / 26|30\\.10\\.2026|https://devfest\\.cz|devfest@gug\\.cz|Libčice|Uhelný' src --include='*.astro' --include='*.ts' --include='*.tsx' --exclude=site.config.ts --exclude=privacy-policy.astro --exclude=delete-account.astro --exclude=code-of-conduct.astro --exclude=press-kit.ts --exclude='*.test.ts' | grep -vE ':[[:space:]]*(\\*|//|/\\*)'"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.4",
    "firebase": "^13.1.0",
    "heic-to": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "playwright": "^1.64.1",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "fflate": "^0.8.3"
  }
}
