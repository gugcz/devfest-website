{
  "name": "devfest-website",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "a11y": "A11Y_MOCK=1 astro build && node scripts/a11y.mjs",
    "verify": "npm run check && npm run complexity && npm --prefix functions test && npm run a11y",
    "anchors": "A11Y_MOCK=1 astro build && node scripts/anchor-measure.mjs",
    "complexity": "eslint src functions/src scripts astro.config.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.1",
    "firebase": "^12.16.0",
    "heic-to": "^1.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "playwright": "^1.64.1",
    "sass": "^1.106.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "fflate": "^0.8.3"
  }
}
