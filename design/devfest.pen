                    {
                      "type": "text",
                      "id": "E7LJ7K",
                      "name": "Bio",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Abdel Sghiouar is a senior Cloud Developer Advocate @Google Cloud. A co-host of the Kubernetes Podcast by Google and a CNCF Ambassador. His focused areas are GKE/Kubernetes, Service Mesh and Serverless. Abdel started his career in datacenters and infrastructure in Morocco where he is originally. Before moving to Google's largest EU datacenter in Belgium. Then in Sweden he joined Google Cloud Professional Services and spent 5 years working with Google Cloud customers on architecting and designing large scale distributed systems before turning to advocacy and community work.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": "$fs-lede",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "lp3Ub",
                      "name": "sp",
                      "width": 10,
                      "height": 64
