                          "name": "Title",
                          "fill": "$color-text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "OPEN SESAME TO THE MONOLITH: RAIDING THE LEGACY CAVE WITH AI AGENTS",
                          "lineHeight": 1.06,
                          "fontFamily": "$font-display",
                          "fontSize": "$fs-row-sm",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "sG73b",
