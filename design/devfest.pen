                  "fill": "$color-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "GENUI IN PRODUCTION: HOW GENUI AND A2UI CHANGE MOBILE APPS",
                  "lineHeight": "$lh-display",
                  "fontFamily": "$font-display",
                  "fontSize": "$fs-h2",
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "V6BMF",
                  "name": "sp",
                  "width": 10,
                  "height": 36
                },
                {
                  "type": "frame",
                  "id": "p5Lopu",
