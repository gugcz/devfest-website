                          "type": "text",
                          "id": "KD3iA",
                          "name": "Title",
                          "fill": "$color-text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "OPEN SESAME TO THE MONOLITH: RAIDING THE LEGACY CAVE WITH AI AGENTS",
                          "lineHeight": 1.06,
                          "fontFamily": "$font-display",
                          "fontSize": "$fs-row-sm",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "sG73b",
                          "name": "Desc",
                          "fill": "$ink-meta",
                          "textGrowth": "fixed-width",
                          "width": 520,
                          "content": "Every enterprise sits on a \"Cave of Wonders\". A massive codebase packed with decades of invaluable business logic, hardened edge cases, and customer data. But it is usually locked behind outdated languages, undocumented dependencies, and crushing technical debt…",
                          "lineHeight": 1.7,
                          "fontFamily": "$font-body",
                          "fontSize": "$fs-ui",
                          "fontWeight": "normal"
                        }
